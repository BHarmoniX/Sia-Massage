---
// A section of a one-page site. Gives it the anchor id the header links to, labels it for
// screen readers, and registers it with the scroll-spy (src/scripts/one-page.ts).
// It has no look of its own: each client designs what goes inside.

interface Props {
  id: string;
  /** Accessible name, e.g. "Services". Use `labelledby` instead if the section has a visible heading id. */
  label?: string;
  labelledby?: string;
  class?: string;
}

const { id, label, labelledby, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['page-section', className]}
  aria-label={labelledby ? undefined : label}
  aria-labelledby={labelledby}
  data-section
>
  <slot />
</section>

<style>
  .page-section {
    scroll-margin-top: var(--header-height);
  }
</style>
