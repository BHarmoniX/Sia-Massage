---
// Inline SVG icons for the footer. Inline (not an icon font or CDN) so they load instantly
// and need no extra origins in the security policy.

export type IconName =
  | 'pin'
  | 'phone'
  | 'mail'
  | 'clock'
  | 'chevron'
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'tiktok'
  | 'youtube'
  | 'x'
  | 'google';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

// Outline icons use stroke; brand marks use fill.
const outline: Partial<Record<IconName, string>> = {
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z M12 12.2a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4z',
  phone:
    'M5 4h3.3l1.6 4.3-2 1.3a11 11 0 0 0 4.5 4.5l1.3-2L18 13.7V17a2 2 0 0 1-2.2 2A15 15 0 0 1 3 6.2 2 2 0 0 1 5 4z',
  mail: 'M4 6h16v12H4z M4 7l8 6 8-6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 7v5l3 2',
  chevron: 'M6 9l6 6 6-6',
  instagram:
    'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M17.5 6.5h.01',
  youtube:
    'M3 8.5A3.5 3.5 0 0 1 6.5 5h11A3.5 3.5 0 0 1 21 8.5v7a3.5 3.5 0 0 1-3.5 3.5h-11A3.5 3.5 0 0 1 3 15.5z M10 9.5v5l4.5-2.5z',
  x: 'M4 4l16 16 M20 4L4 20',
};

const filled: Partial<Record<IconName, string>> = {
  facebook:
    'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.776-3.89 1.094 0 2.24.195 2.24.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33V22C18.343 21.128 22 16.991 22 12z',
  linkedin:
    'M6.94 8.5H3.56V19h3.38V8.5zM5.25 3A1.96 1.96 0 1 0 5.25 6.92 1.96 1.96 0 0 0 5.25 3zM20.44 13.12c0-3.16-1.69-4.63-3.94-4.63-1.82 0-2.63 1-3.09 1.7V8.5h-3.38V19h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.69 1.57 1.69 2.79V19h3.38v-5.88z',
  google:
    'M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z',
  tiktok:
    'M16.6 3c.4 2.2 1.8 3.6 4 3.9v3.2a7.4 7.4 0 0 1-4-1.3v6.1A5.9 5.9 0 1 1 10.7 9v3.3a2.7 2.7 0 1 0 2.7 2.7V3h3.2z',
};

const d = outline[name] ?? filled[name] ?? '';
const isOutline = name in outline;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={isOutline ? 'none' : 'currentColor'}
  stroke={isOutline ? 'currentColor' : 'none'}
  stroke-width={isOutline ? 1.8 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={d}></path>
</svg>
