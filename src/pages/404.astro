---
import OnePageLayout from '../layouts/OnePageLayout.astro';
---

<OnePageLayout title="Page not found" noindex>
  <section class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-6 px-4">
    <h1 class="text-4xl font-semibold">Page not found</h1>
    <p class="opacity-80">That page doesn't exist or has moved.</p>
    <a class="text-accent underline" href="/">Back to home</a>
  </section>
</OnePageLayout>
