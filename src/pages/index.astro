<script>
  // ── BUILD-TIME CAPTURE MODE (remove before launch) ──────────────────────────────────
  // Open the page with ?capture for full-page screenshots: every section shows at once (no
  // fade-ins), every image loads straight away, and full-screen sections keep the height of
  // the real window instead of stretching to the height of the whole capture.
  if (new URLSearchParams(location.search).has('capture')) {
    const root = document.documentElement;
    root.classList.add('sia-capture');
    root.style.setProperty('--sia-vh', `${window.innerHeight}px`);
    for (const el of document.querySelectorAll('[data-reveal], .img-reveal')) el.classList.add('is-visible');
    // Load and prepare every photo up front, then say so in the tab title: wait for
    // "✓ Ready to capture" before taking the screenshot.
    const images = Array.from(document.querySelectorAll('img'));
    for (const img of images) {
      img.loading = 'eager';
      img.decoding = 'sync';
    }
    const title = document.title;
    document.title = `Loading photos… · ${title}`;
    Promise.allSettled(images.map((img) => img.decode())).then(() => {
      document.title = `✓ Ready to capture · ${title}`;
    });
  }

  // The contact section's waterfall runs behind the footer: keep the overlap equal to the
  // footer's height as it changes with the screen size.
  const footerEl = document.querySelector<HTMLElement>('.ill-footer');
  if (footerEl) {
    const setFooterHeight = () =>
      document.documentElement.style.setProperty('--sia-footer-h', `${footerEl.offsetHeight}px`);
    setFooterHeight();
    new ResizeObserver(setFooterHeight).observe(footerEl);
  }

  // Doorway: scroll position → how far you have stepped in (0 = arch standing in the wall,
  // 1 = through it). One geometry draws the photograph's opening and both border lines, so
  // they are always the same shape; stepping in scales it about the ground at the centre.
  const doorway = document.querySelector<HTMLElement>('[data-doorway]');
  const stage = doorway?.querySelector<HTMLElement>('.sia-visit__stage');
  const door = doorway?.querySelector<HTMLElement>('.sia-visit__door');
  const archFrame = doorway?.querySelector<SVGSVGElement>('[data-frame]');
  const threshold = doorway?.querySelector<HTMLElement>('.sia-visit__threshold');
  const glass = doorway?.querySelector<HTMLElement>('[data-glass]');
  const doorPhoto = doorway?.querySelector<HTMLImageElement>('.sia-visit__door img');
  const visitTitle = document.getElementById('visit-title');
  const ground = doorway?.querySelector<HTMLElement>('[data-ground]');
  const groundPlane = ground?.firstElementChild as HTMLElement | null | undefined;
  const wallFoot = doorway?.querySelector<HTMLElement>('[data-wall-foot]');
  const wallLayer = doorway?.querySelector<SVGSVGElement>('.sia-visit__wall');
  const sill = doorway?.querySelector<SVGSVGElement>('[data-threshold]');
  const sillStones = sill?.querySelector<SVGGElement>('[data-threshold-stones]');
  let edgeKey = '';
  const garden = doorway?.querySelector<HTMLElement>('[data-garden]');
  // Each piece: where it stands (x from the doorway's centre, in doorway half-widths, past the
  // frame), how far forward on the forecourt, how tall, and its picture's height ÷ width.
  const props = [
    // Bamboo: `trough` is where the trough's centre sits across the picture (0 = the side away
    // from the door); the canopy arches over toward the door.
    // Bamboo (as drawn, leaning right; the right-hand one is mirrored): `trough` is the
    // pot's centre across the picture, `over` the point under the leaning canopy where its
    // couplet sits, `canopy` how far down the picture that part of the canopy reaches.
    { el: garden?.querySelector<HTMLElement>('[data-prop="bamboo-left"]'), side: -1, forward: 0.55, ratio: 1667 / 900, trough: 0.29, over: 0.68, canopy: 0.4 },
    { el: garden?.querySelector<HTMLElement>('[data-prop="bamboo-right"]'), side: 1, forward: 0.55, ratio: 1665 / 900, trough: 0.3, over: 0.62, canopy: 0.42 },
  ];

  if (doorway && stage && door && archFrame) {
    if (groundPlane && ground?.dataset.texture) groundPlane.style.backgroundImage = `url("${ground.dataset.texture}")`;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = Array.from(archFrame.querySelectorAll<SVGPathElement>('[data-line]'));
    const n = (v: number) => v.toFixed(1);

    // The gateway outline: posts at cx ± A from the threshold (y = base) up to the crown.
    // The crown is the client's cusped arch: on each side three rounded lobes meeting in
    // sharp points, rising to an onion tip at the top (mirrored exactly). The posts are
    // extended so the doorway is about 1.7× as tall as it is wide. `d` grows the shape evenly
    // outward (a true offset, so the lobes' points stay crisp on every frame line).
    const CROWN = 0.73; // crown height, × A (from the reference)
    const TIP = 0.652; // proportions of the sage feet and braces' tip curve
    const APEX = 3.4; // total height, × A (a tall doorway: about 1.7× as tall as it is wide)
    const SHOULDER = APEX - CROWN;
    const BAND = 48.4; // glass, from the inner timber out to the outer timber
    const TIMBER = 12; // timber frame outside the glass
    const INNER = 8; // thin timber frame on the doorway's edge, inside the glass
    const EDGE = BAND + TIMBER; // the gateway's outside edge

    // The left half of the crown in units of A: x from the centre (−1 = the post), y above
    // the shoulder. Lobes are arcs between their points, bulging outward; the last rises in an
    // ogee to the tip.
    const crownLeft: [number, number][] = (() => {
      const pts: [number, number][] = [[-1, 0]];
      const cusps: [number, number, number][] = [
        // [x, y, bulge of the lobe that ends here]
        [-0.972, 0.077, 0.03],
        [-0.843, 0.25, 0.06],
        [-0.704, 0.487, 0.08],
        [-0.172, 0.598, 0.12],
      ];
      let px = -1;
      let py = 0;
      for (const [x, y, bulge] of cusps) {
        const mx = (px + x) / 2;
        const my = (py + y) / 2;
        const len = Math.hypot(x - px, y - py);
        // Outward is to the left of travel (up the post, over the top): (−dy, dx) in these units.
        const qx = mx - ((y - py) / len) * bulge * 2;
        const qy = my + ((x - px) / len) * bulge * 2;
        for (let i = 1; i <= 18; i++) {
          const t = i / 18;
          pts.push([
            (1 - t) ** 2 * px + 2 * (1 - t) * t * qx + t * t * x,
            (1 - t) ** 2 * py + 2 * (1 - t) * t * qy + t * t * y,
          ]);
        }
        [px, py] = [x, y];
      }
      // Ogee: from the last point, swelling out and drawing in to the tip at the centre.
      // Control points: (px, py) → (−0.1, 0.645) → (−0.025, 0.665) → (0, CROWN).
      for (let i = 1; i <= 22; i++) {
        const t = i / 22;
        const a = (1 - t) ** 3, b = 3 * (1 - t) ** 2 * t, c = 3 * (1 - t) * t * t, e = t ** 3;
        pts.push([a * px + b * -0.1 + c * -0.025 + e * 0, a * py + b * 0.645 + c * 0.665 + e * CROWN]);
      }
      return pts;
    })();

    // Grows a polyline outward by d, as a band of even width would: every edge moves out along
    // its normal (outer corners rounded), then any point that ends up closer than d to the
    // original shape is dropped. What is left is the true outline, with crisp points where the
    // lobes meet and no loops where a tight inward curve is offset past its own radius.
    const offset = (P: [number, number][], d: number): [number, number][] => {
      if (d === 0) return P;
      const raw: [number, number][] = [];
      let prev: { tx: number; ty: number } | null = null;
      for (let i = 0; i < P.length - 1; i++) {
        const [ax, ay] = P[i]!;
        const [bx, by] = P[i + 1]!;
        const len = Math.hypot(bx - ax, by - ay);
        if (len < 1e-6) continue;
        const tx = (bx - ax) / len, ty = (by - ay) / len;
        const nx = ty, ny = -tx; // outward (left of travel, screen coordinates)
        if (prev && prev.tx * ty - prev.ty * tx > 1e-9) {
          // Outer corner: a small arc about the original point.
          const a0 = Math.atan2(-prev.tx, prev.ty);
          let da = Math.atan2(-tx, ty) - a0;
          while (da > Math.PI) da -= 2 * Math.PI;
          while (da < -Math.PI) da += 2 * Math.PI;
          const steps = Math.ceil(Math.abs(da) / 0.15);
          for (let k = 1; k < steps; k++) {
            const a = a0 + (da * k) / steps;
            raw.push([ax + Math.cos(a) * d, ay + Math.sin(a) * d]);
          }
        }
        // Long edges (the posts) get extra samples so trimming has points to keep.
        const parts = Math.max(1, Math.ceil(len / 6));
        for (let k = 0; k <= parts; k++) {
          const t = k / parts;
          raw.push([ax + (bx - ax) * t + nx * d, ay + (by - ay) * t + ny * d]);
        }
        prev = { tx, ty };
      }
      // Keep only points a full d from the original shape.
      const near = (x: number, y: number) => {
        let best = Infinity;
        for (let i = 0; i < P.length - 1; i++) {
          const [ax, ay] = P[i]!;
          const [bx, by] = P[i + 1]!;
          const vx = bx - ax, vy = by - ay;
          const l2 = vx * vx + vy * vy || 1;
          const t = Math.max(0, Math.min(1, ((x - ax) * vx + (y - ay) * vy) / l2));
          const dx = x - (ax + vx * t), dy = y - (ay + vy * t);
          const dd = dx * dx + dy * dy;
          if (dd < best) best = dd;
        }
        return Math.sqrt(best);
      };
      return raw.filter(([x, y]) => near(x, y) > d - 0.05);
    };

    // `foot` is where the posts start (the ground by default; higher for a line that ends on
    // the leg braces).
    const arch = (cx: number, base: number, A: number, d = 0, closed = d === 0, foot = base) => {
      const sy = base - SHOULDER * A;
      const left = crownLeft.map(([u, v]) => [cx + u * A, sy - v * A] as [number, number]);
      const right = crownLeft
        .slice(0, -1)
        .reverse()
        .map(([u, v]) => [cx - u * A, sy - v * A] as [number, number]);
      const P = offset([[cx - A, foot], ...left, ...right, [cx + A, foot]], d);
      return `M${P.map(([x, y]) => `${n(x)} ${n(y)}`).join(' L')}` + (closed ? ' Z' : '');
    };
    // ── Doors ──────────────────────────────────────────────────────────────────────────
    // Each leaf is half the opening (inside the inner timber), traced clockwise so that the
    // offset step's "outward" is the leaf's outside; reversed, it insets the carved panel.
    const leafPoly = (cx: number, base: number, A: number, side: 'left' | 'right'): [number, number][] => {
      const sy = base - SHOULDER * A;
      const m = side === 'left' ? 1 : -1;
      const g = 0.6; // half the hairline gap where the leaves meet
      const half = crownLeft.map(([u, v]) => [cx + m * u * A, sy - v * A] as [number, number]);
      half[half.length - 1] = [cx - m * g, sy - CROWN * A];
      const foot: [number, number] = [cx - m * A, base];
      const centreFoot: [number, number] = [cx - m * g, base];
      return side === 'left' ? [foot, ...half, centreFoot] : [centreFoot, ...half.reverse(), foot];
    };
    const inset = (poly: [number, number][], d: number) =>
      offset([...poly, poly[0]!].reverse(), d);
    const pathOf = (pts: [number, number][], close = true) =>
      `M${pts.map(([x, y]) => `${n(x)} ${n(y)}`).join(' L')}` + (close ? ' Z' : '');

    // One leaf's drawing: solid timber, a carved double bead inset around the edge, a rail at
    // handle height, strap hinges on the hinge post and a ring pull by the meeting edge. Iron
    // and sage only, from the palette.
    const leafSvg = (cx: number, base: number, A: number, side: 'left' | 'right') => {
      const m = side === 'left' ? 1 : -1;
      const poly = leafPoly(cx, base, A, side);
      const b1 = 0.075 * A;
      const b2 = b1 + Math.max(3, 0.022 * A);
      const cut = (pts: [number, number][], y: number, keepAbove: boolean) => {
        const keep = (p: [number, number]) => (keepAbove ? p[1] <= y : p[1] >= y);
        const out: [number, number][] = [];
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i]!;
          const q = pts[(i + 1) % pts.length]!;
          if (keep(p)) out.push(p);
          if (keep(p) !== keep(q)) {
            const f = (y - p[1]) / (q[1] - p[1]);
            out.push([p[0] + (q[0] - p[0]) * f, y]);
          }
        }
        return out;
      };
      const bead1 = pathOf(inset(poly, b1));
      // The inner bead boxes the panels in: its vertical lines turn 90° and run straight across
      // the leaf just below the crown, leaving a separate crown panel above (a top rail between).
      const sy = base - SHOULDER * A;
      const boxTop = sy + 0.02 * A;
      const g = 0.05 * A;
      const ring2 = inset(poly, b2);
      const bead2 = `${pathOf(cut(ring2, boxTop, false))} ${pathOf(cut(ring2, boxTop - g, true))}`;
      const bead1Lit = pathOf(inset(poly, b1 + 1));
      const hx = cx - m * 0.17 * A;
      const hy = base - 1.25 * A;
      const railY = hy + 0.2 * A;
      const xOuter = cx - m * (A - b1);
      const xInner = cx - m * (0.6 + b1);
      const rail = `M${n(xOuter)} ${n(railY)} H${n(xInner)} M${n(xOuter)} ${n(railY + b2 - b1)} H${n(xInner)}`;
      // A domed rivet or boss in forged iron, lit at the top left.
      const rivet = (x: string, y: string, r: string) =>
        `<circle cx="${x}" cy="${y}" r="${r}" fill="url(#sia-iron-tex)" />` +
        `<circle cx="${x}" cy="${y}" r="${r}" fill="url(#sia-metal-dome)" stroke="rgb(8 8 8 / 0.6)" stroke-width="0.5" />`;
      const strap = (y: number) => {
        const x0 = cx - m * A;
        const x1 = cx - m * (A - 0.26 * A);
        const t = 0.042 * A;
        const r = 0.009 * A;
        const rx = (k: number) => n(x0 + (x1 - x0) * k);
        const strapD = `M${n(x0)} ${n(y - t / 2)} H${n(x1)} Q ${n(x1 + (x1 - x0) * 0.12)} ${n(y)} ${n(x1)} ${n(y + t / 2)} H${n(x0)} Z`;
        return (
          `<path d="${strapD}" fill="url(#sia-iron-tex)" />` +
          `<path d="${strapD}" fill="url(#sia-metal-strap)" stroke="rgb(8 8 8 / 0.7)" stroke-width="0.6" />` +
          rivet(rx(0.35), n(y), n(r)) +
          rivet(rx(0.75), n(y), n(r))
        );
      };
      const ring = 0.07 * A;
      const boss = hy - 0.04 * A;
      // Raised panels: the field inside the beads, above and below the rail, each bevelled.
      const field = inset(poly, b2 + 2);
      const panelTop = cut(cut(field, railY - 3, true), boxTop + 2, false);
      const panelCrown = cut(field, boxTop - g - 2, true);
      const panelBottom = cut(field, railY + (b2 - b1) + 3, false);
      const shadow = (svg: string, dx: number, dy: number) =>
        `<g transform="translate(${n(dx)} ${n(dy)})" filter="url(#sia-shadow-small)" opacity="0.7">${svg}</g>`;
      const strapShape = (y: number) => {
        const x0 = cx - m * A;
        const x1 = cx - m * (A - 0.26 * A);
        const t = 0.042 * A;
        return `<path d="M${n(x0)} ${n(y - t / 2)} H${n(x1)} Q ${n(x1 + (x1 - x0) * 0.12)} ${n(y)} ${n(x1)} ${n(y + t / 2)} H${n(x0)} Z" fill="#000" />`;
      };
      const ringPull =
        // The rose: a forged iron disc, domed and lit, with a fine raised rim.
        rivet(n(hx), n(hy), n(0.078 * A)) +
        `<circle cx="${n(hx)}" cy="${n(hy)}" r="${n(0.058 * A)}" fill="none" stroke="rgb(255 255 255 / 0.12)" stroke-width="${n(0.006 * A)}" />` +
        // The ring: forged iron, lit along its upper left.
        `<circle cx="${n(hx)}" cy="${n(boss + ring)}" r="${n(ring)}" fill="none" stroke="url(#sia-iron-tex)" stroke-width="${n(0.018 * A)}" />` +
        `<circle cx="${n(hx)}" cy="${n(boss + ring)}" r="${n(ring)}" fill="none" stroke="url(#sia-metal-ring)" stroke-width="${n(0.018 * A)}" />` +
        // The boss it hangs from.
        rivet(n(hx), n(boss), n(0.024 * A));
      const ringShadow =
        `<circle cx="${n(hx)}" cy="${n(hy)}" r="${n(0.078 * A)}" fill="#000" />` +
        `<circle cx="${n(hx)}" cy="${n(boss + ring)}" r="${n(ring)}" fill="none" stroke="#000" stroke-width="${n(0.017 * A)}" />`;
      const lift = Math.max(1.5, 0.012 * A);
      // The leaf's board sheet (oiled natural hardwood, six vertical boards, their joints part of
      // the wood) spans the leaf.
      const tileW = A;
      const tileH = APEX * A + 4;
      const x0 = side === 'left' ? cx - A : cx;
      const y0 = base - APEX * A - 2;
      const wood =
        `<defs><pattern id="sia-door-wood-${side}" patternUnits="userSpaceOnUse" x="${n(x0)}" y="${n(y0)}" width="${n(tileW)}" height="${n(tileH)}">` +
        `<image href="${doorSheets[side]}" width="${n(tileW)}" height="${n(tileH)}" preserveAspectRatio="none" /></pattern></defs>`;
      const board = (d: string) => `<path d="${d}" fill="url(#sia-door-wood-${side})" />`;
      return (
        // The leaf: natural hardwood boards, edges rounded by the light.
        wood +
        `<g filter="url(#sia-bevel-door)">${board(pathOf(poly))}</g>` +
        // Raised panels standing out of the frame of the leaf.
        `<g filter="url(#sia-bevel-panel)">${board(pathOf(panelTop))}</g>` +
        `<g filter="url(#sia-bevel-panel)">${board(pathOf(panelBottom))}</g>` +
        `<g filter="url(#sia-bevel-panel)">${board(pathOf(panelCrown))}</g>` +
        // Carved bead: dark cut with a lit edge, then a second fine bead inside it.
        `<path d="${bead1}" fill="none" stroke="rgb(16 10 5 / 0.7)" stroke-width="1.6" />` +
        `<path d="${bead1Lit}" fill="none" stroke="rgb(214 178 128 / 0.25)" stroke-width="0.8" />` +
        `<path d="${bead2}" fill="none" stroke="rgb(16 10 5 / 0.5)" stroke-width="1" />` +
        `<path d="${rail}" fill="none" stroke="rgb(16 10 5 / 0.6)" stroke-width="1.3" />` +
        `<path d="${pathOf(poly)}" fill="none" stroke="rgb(16 10 5 / 0.8)" stroke-width="1.2" />` +
        // Strap hinges and the ring pull, in iron and sage, each casting a small shadow.
        shadow(strapShape(sy + 0.3 * A) + strapShape(base - 0.5 * A), lift * 0.7, lift) +
        strap(sy + 0.3 * A) +
        strap(base - 0.5 * A) +
        shadow(ringShadow, lift, lift * 1.6) +
        ringPull +
        // Shade that deepens as the leaf turns away from the light (set while it swings).
        `<path d="${pathOf(poly)}" fill="url(#sia-leaf-shade-${side})" opacity="0" data-shade />`
      );
    };
    const doors = doorway.querySelector<HTMLElement>('[data-doors]');
    const doorSheets = { left: doors?.dataset.doorLeft ?? '', right: doors?.dataset.doorRight ?? '' };
    const leaves = {
      left: doorway.querySelector<HTMLElement>('[data-leaf="left"]'),
      right: doorway.querySelector<HTMLElement>('[data-leaf="right"]'),
    };
    let leafKey = '';

    const couplets = {
      left: archFrame.querySelector<SVGGElement>('[data-couplet="left"]')!,
      right: archFrame.querySelector<SVGGElement>('[data-couplet="right"]')!,
    };

    let queued = false;
    const update = () => {
      queued = false;
      const top = doorway.getBoundingClientRect().top;
      const capture = document.documentElement.classList.contains('sia-capture');
      // Two phases of scroll: first the doors swing in (over 45% of a screen), then the
      // gateway opens around you (over the next 65%).
      const DOOR = 0.45;
      const ZOOM = 0.65;
      const progress = -top / window.innerHeight;
      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
      const swing = capture ? 0 : reduced ? 1 : clamp01(progress / DOOR);
      const open = capture ? 0 : reduced ? 1 : clamp01((progress - DOOR) / ZOOM);
      doorway.style.setProperty('--open', open.toFixed(3));

      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const cx = w / 2;
      // Closed: the gateway stands on its threshold near the foot of the stage, full height
      // in view with room above for the heading.
      // The wall stands on a stone forecourt that fills the foot of the stage.
      const base0 = h - Math.max(60, h * 0.14);
      // As tall as the stage allows, leaving just the room 入 and its line need above the arch
      // (their own height, the 14px gap the label is set at, and a 10px margin to the top).
      const labelRoom = (threshold?.offsetHeight ?? 62) + 14 + 10;
      const A0 = Math.max(55, Math.min(w * 0.2, (base0 - labelRoom - EDGE) / APEX));
      const height0 = APEX * A0;
      // Walking in: scale about a point low in the doorway (eye level) until it fills the screen.
      const pivotY = base0 - height0 * 0.38;
      const sMax = Math.max((w * 0.62) / A0, (pivotY * 1.25) / (height0 - height0 * 0.38) + 0.5);
      const s = 1 + (sMax - 1) * open ** 1.4;
      const A = A0 * s;
      const base = pivotY + (base0 - pivotY) * s;
      // The doorway stands on a stone step 40mm high (the doorway is 2.4m tall, so 1m = APEX·A/2.4):
      // `base` is the step's top at the doorway, `floor` the paving one step lower.
      const stepH = APEX * A * (0.04 / 2.4);
      const stepH0 = APEX * A0 * (0.04 / 2.4);
      const floor = base + stepH;

      // Doors: swing in on their hinges (eased), then fade as the gateway starts to open.
      if (doors && leaves.left && leaves.right) {
        const fade = Math.max(0, 1 - open * 10);
        doors.style.opacity = String(fade);
        if (fade > 0) {
          const key = `${n(cx)},${n(base)},${n(A)}`;
          if (key !== leafKey) {
            leafKey = key;
            // Redraw each leaf's face by name (the back face is also a child of the leaf).
            const face = (leaf: HTMLElement) => leaf.querySelector<SVGSVGElement>('.sia-visit__leaf-svg');
            const faceL = face(leaves.left);
            const faceR = face(leaves.right);
            if (faceL) faceL.innerHTML = leafSvg(cx, base, A, 'left');
            if (faceR) faceR.innerHTML = leafSvg(cx, base, A, 'right');
            // The top edge's thickness: along each leaf's crown (lobes and tip), a strip of
            // faces turned back into the doorway, each shaded by how it faces the light.
            const T = Math.max(7, 0.09 * A);
            for (const [leaf, side] of [
              [leaves.left, 'left'],
              [leaves.right, 'right'],
            ] as const) {
              leaf.querySelectorAll('.sia-visit__leaf-rim, .sia-visit__leaf-back').forEach((el) => el.remove());
              // The back face: the leaf's shape again, set back by its thickness, closing the
              // edge so the door reads as one solid piece.
              const back = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
              back.setAttribute('class', 'sia-visit__leaf-back');
              back.innerHTML = `<path d="${pathOf(leafPoly(cx, base, A, side))}" fill="#312218" stroke="rgb(10 6 3 / 0.75)" stroke-width="1.2" />`;
              back.style.transform = `translateZ(${n(-T)}px)`;
              leaf.insertBefore(back, leaf.firstChild);
              const crown = leafPoly(cx, base, A, side).slice(1, -1);
              const pts = crown.filter((_, i) => i % 2 === 0 || i === crown.length - 1);
              // Light on each stretch of edge by which way it faces (top left lit), blended
              // smoothly from one stretch to the next so the edge reads as one continuous band.
              const segLit: number[] = [];
              for (let i = 0; i < pts.length - 1; i++) {
                const [px, py] = pts[i]!;
                const [qx, qy] = pts[i + 1]!;
                const len = Math.hypot(qx - px, qy - py) || 1;
                const tx = (qx - px) / len, ty = (qy - py) / len;
                segLit.push(0.55 + 0.45 * ((-ty + tx) / Math.SQRT2));
              }
              const vLit = (i: number) => ((segLit[i - 1] ?? segLit[i]!) + (segLit[i] ?? segLit[i - 1]!)) / 2;
              const paint = (k: number) => `rgb(${Math.round(Math.min(255, 98 * k))} ${Math.round(Math.min(255, 70 * k))} ${Math.round(Math.min(255, 48 * k))})`;
              for (let i = 0; i < pts.length - 1; i++) {
                const [px, py] = pts[i]!;
                const [qx, qy] = pts[i + 1]!;
                const len = Math.hypot(qx - px, qy - py);
                if (len < 0.5) continue;
                const face = document.createElement('div');
                face.className = 'sia-visit__leaf-rim';
                face.style.width = `${n(len + 0.8)}px`;
                face.style.height = `${n(T)}px`;
                // Fine grain running along the edge, a little light on the front arris and
                // shade toward the back sheet, over the blended paint colour.
                face.style.background =
                  `repeating-linear-gradient(180deg, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 3px), ` +
                  `linear-gradient(180deg, rgb(255 255 255 / 0.1), transparent 35%, rgb(0 0 0 / 0.25)), ` +
                  `linear-gradient(90deg, ${paint(vLit(i))}, ${paint(vLit(i + 1))})`;
                face.style.transform = `translate(${n(px)}px, ${n(py)}px) rotate(${Math.atan2(qy - py, qx - px).toFixed(4)}rad) rotateX(-90deg)`;
                leaf.appendChild(face);
              }
            }
          }
          const e = swing * swing * (3 - 2 * swing);
          const angle = 100 * e;
          // Eye point high in the doorway, so the doors' top edges show their thickness as
          // they swing.
          doors.style.perspectiveOrigin = `${n(cx)}px ${n(base - APEX * A * 0.85)}px`;
          leaves.left.style.transformOrigin = `${n(cx - A)}px 0`;
          leaves.right.style.transformOrigin = `${n(cx + A)}px 0`;
          leaves.left.style.transform = `rotateY(${n(angle)}deg)`;
          leaves.right.style.transform = `rotateY(${n(-angle)}deg)`;
          // Each leaf falls into shade as it turns away from the light.
          const shadeOpacity = String(Math.sin((angle * Math.PI) / 180) * 0.85);
          for (const leaf of [leaves.left, leaves.right]) {
            leaf.querySelector('[data-shade]')?.setAttribute('opacity', shadeOpacity);
          }
          // The meeting edges' thickness: a face set back from each free edge into the doorway.
          const T = Math.max(7, 0.09 * A);
          const topY = base - APEX * A;
          const edgeL = leaves.left.querySelector<HTMLElement>('.sia-visit__leaf-edge');
          const edgeR = leaves.right.querySelector<HTMLElement>('.sia-visit__leaf-edge');
          if (edgeL && edgeR) {
            for (const [el, x, origin, turn] of [
              [edgeL, cx - 0.6, 'left', 90],
              [edgeR, cx + 0.6 - T, 'right', -90],
            ] as const) {
              el.style.left = `${n(x)}px`;
              el.style.top = `${n(topY)}px`;
              el.style.width = `${n(T)}px`;
              el.style.height = `${n(base - topY)}px`;
              el.style.transformOrigin = `${origin} center`;
              el.style.transform = `rotateY(${turn}deg)`;
            }
          }
        }
      }

      // The photo reaches out to the outer line, under the glass band.
      const timberPath = `${arch(cx, base, A, EDGE, true)} ${arch(cx, base, A, BAND, true)}`;
      archFrame.querySelector('[data-timber]')?.setAttribute('d', timberPath);
      archFrame.querySelector('[data-timber-edge="lit"]')?.setAttribute('d', arch(cx, base, A, BAND + 1.5, false));
      archFrame.querySelector('[data-timber-edge="shade"]')?.setAttribute('d', arch(cx, base, A, EDGE - 0.5, false));
      // Thin inner timber on the doorway's edge, lit on the opening side.
      archFrame.querySelector('[data-timber-inner]')?.setAttribute('d', `${arch(cx, base, A, INNER, true)} ${arch(cx, base, A)}`);
      archFrame.querySelector('[data-timber-inner-edge="lit"]')?.setAttribute('d', arch(cx, base, A, 0.5, false));
      archFrame.querySelector('[data-timber-inner-edge="shade"]')?.setAttribute('d', arch(cx, base, A, INNER - 0.5, false));
      // Depth: the frame's shadow on the wall (outside the frame, above the ground only), and the timber's
      // shadow along both edges of the glass (inside the glass only).
      const outline = arch(cx, base, A, EDGE, true);
      archFrame
        .querySelector('[data-wall-clip]')
        ?.setAttribute('d', `M-5000 -5000 H${n(w + 5000)} V${n(base)} H-5000 Z ${outline}`);
      const lift = Math.max(3, A * 0.035);
      archFrame
        .querySelector('[data-frame-shadow]')
        ?.setAttribute('d', outline);
      archFrame
        .querySelector('[data-frame-shadow]')
        ?.setAttribute('transform', `translate(${n(lift * 0.7)} ${n(lift)})`);
      archFrame
        .querySelector('[data-glass-clip]')
        ?.setAttribute('d', `${arch(cx, base, A, BAND, true)} ${arch(cx, base, A, INNER, true)}`);
      archFrame.querySelector('[data-glass-shade="outer"]')?.setAttribute('d', arch(cx, base, A, BAND, false));
      archFrame.querySelector('[data-glass-shade="inner"]')?.setAttribute('d', arch(cx, base, A, INNER, false));
      door.style.clipPath = open >= 1 ? 'none' : `path("${arch(cx, base, A, BAND, true)}")`;
      // The room behind the doors, at true scale: its floor starts at the threshold and its
      // eye level (a third of the way down the photo) sits where a standing person's eyes would
      // be in a doorway this size (opening ~1.6 m wide, so eye height ~2/3 of the way to the
      // apex). It scales with the doorway as you walk in.
      if (doorPhoto) {
        const HZ = 0.335; // the photo's eye level, from its top
        const eyeY = base - APEX * A * (1.6 / 2.4);
        const ph = (base - eyeY) / (1 - HZ);
        const pw = ph * (2752 / 1536); // the photo's own proportions
        doorPhoto.style.width = `${n(pw)}px`;
        doorPhoto.style.height = `${n(ph)}px`;
        // Through the doorway we stand almost on centre: the man on the left, the side table on the right.
        // Walking in, the view eases until the man's face (0.375 across the photo) sits just
        // past the end of the "Four quiet moments" heading: the heading scrolls up over the
        // still room, so beside it (never under it) the two can't cross. At least 10% in from
        // the left, at most 62% (on a phone the heading spans the width), never uncovering an edge.
        const DOORWAY_SHIFT = 0.01;
        let faceX = w * 0.1;
        if (visitTitle) {
          const words = document.createRange();
          words.selectNodeContents(visitTitle);
          const r = words.getBoundingClientRect();
          if (r.width > 0) faceX = Math.max(faceX, r.right - stage.getBoundingClientRect().left + Math.max(44, w * 0.07));
        }
        faceX = Math.min(faceX, w * 0.62);
        const cover = Math.max(0, 0.5 - w / (2 * pw));
        const endShift = Math.min(cover, Math.max(-cover, (cx - faceX) / pw - 0.125));
        const k = clamp01((open - 0.3) / 0.7);
        const SHIFT = DOORWAY_SHIFT + (endShift - DOORWAY_SHIFT) * k * k * (3 - 2 * k);
        doorPhoto.style.left = `${n(cx - pw * (0.5 + SHIFT))}px`;
        doorPhoto.style.top = `${n(base - ph)}px`;
      }
      // Each foot: a timber plinth across the leg, its two sides the arch's tip curve rotated
      // half a turn, rising from the ground to meet the leg upright. Kept low and subtle.
      const fh = 0.085 * A;
      const fw = ((0.17 * A) / TIP) * 0.35;
      const foot = (x0: number, x1: number) =>
        `M${n(x0 - fw)} ${n(base)} C${n(x0 - 0.552 * fw)} ${n(base - 0.098 * fh)} ${n(x0)} ${n(base - 0.448 * fh)} ${n(x0)} ${n(base - fh)} ` +
        `L${n(x1)} ${n(base - fh)} ` +
        `C${n(x1)} ${n(base - 0.448 * fh)} ${n(x1 + 0.552 * fw)} ${n(base - 0.098 * fh)} ${n(x1 + fw)} ${n(base)} Z`;
      archFrame
        .querySelector<SVGPathElement>('[data-feet]')
        ?.setAttribute('d', foot(cx - A - EDGE, cx - A) + ' ' + foot(cx + A, cx + A + EDGE));
      // A fine line across the top of each foot, from the outer glass line to the inner timber,
      // joining the design lines' ends into one piece.
      archFrame
        .querySelector<SVGPathElement>('[data-foot-line]')
        ?.setAttribute(
          'd',
          `M${n(cx - A - BAND)} ${n(base - fh)} H${n(cx - A - INNER)} M${n(cx + A + INNER)} ${n(base - fh)} H${n(cx + A + BAND)}`,
        );
      // Braces: from the foot of the arch's outer line, the tip curve the right way up (rising
      // upright, turning level) until it meets the thick inner line. Crown proportions.
      const bw = BAND - INNER; // ends at the inner timber
      const bh = bw * TIP;
      const by = base - fh;
      const brace = (tip: number, dir: number) => {
        const x = (k: number) => n(tip + dir * k * bw);
        return `M${x(0)} ${n(by)} C${x(0)} ${n(by - 0.552 * bh)} ${x(0.552)} ${n(by - 0.902 * bh)} ${x(1)} ${n(by - bh)}`;
      };
      archFrame
        .querySelector<SVGPathElement>('[data-braces]')
        ?.setAttribute('d', brace(cx - A - BAND, 1) + ' ' + brace(cx + A + BAND, -1));
      // The same curve along its top side, touching the brace: from where it meets the outer
      // moss line to where it meets the seam (the fine sage line beside the inner moss line).
      const FINE = 1.5; // half the brace (2px) + half the fine line (1px): touching
      const SEAM = 13; // the seam line's distance out from the doorway's edge
      const braceFine = (tip: number, dir: number) => {
        const p1y = -0.552 * bh, p2x = 0.552 * bw * dir, p2y = -0.902 * bh, p3x = bw * dir, p3y = -bh;
        const pts: [number, number][] = [];
        for (let i = 0; i <= 48; i++) {
          const t = i / 48;
          const u = 1 - t;
          const x = 3 * u * t * t * p2x + t ** 3 * p3x;
          const y = 3 * u * u * t * p1y + 3 * u * t * t * p2y + t ** 3 * p3y;
          const dx = 6 * u * t * p2x + 3 * t * t * (p3x - p2x);
          const dy = 3 * u * u * p1y + 6 * u * t * (p2y - p1y) + 3 * t * t * (p3y - p2y);
          const len = Math.hypot(dx, dy) || 1;
          // Top side: away from the corner the brace encloses.
          const nx = (dir * dy) / len, ny = (dir * -dx) / len;
          pts.push([x + nx * FINE, y + ny * FINE]);
        }
        // Keep the part between the outer line (x = 0 here) and the seam, with exact end points.
        const end = (BAND - SEAM) * dir;
        const inside = (x: number) => x * dir >= 0 && x * dir <= end * dir;
        const out: [number, number][] = [];
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i]!;
          const q = pts[i - 1];
          if (q) {
            for (const edge of [0, end]) {
              if ((q[0] - edge) * (p[0] - edge) < 0) {
                const f = (edge - q[0]) / (p[0] - q[0]);
                out.push([edge, q[1] + (p[1] - q[1]) * f]);
              }
            }
          }
          if (inside(p[0])) out.push(p);
        }
        return `M${out.map(([x, y]) => `${n(tip + x)} ${n(by + y)}`).join(' L')}`;
      };
      archFrame
        .querySelector<SVGPathElement>('[data-brace-fine]')
        ?.setAttribute('d', braceFine(cx - A - BAND, 1) + ' ' + braceFine(cx + A + BAND, -1));
      if (glass) {
        glass.style.clipPath = `path(evenodd, "${arch(cx, base, A, BAND, true)} ${arch(cx, base, A)}")`;
        glass.style.opacity = String(Math.max(0, 1 - Math.max(0, open - 0.8) * 5));
      }
      // A line marked data-to-brace stops where it meets the brace curve, rather than running
      // on to the ground: find the point on the curve level with the line, and start there.
      const braceMeet = (d: number) => {
        const k = (BAND - d) / bw; // how far across the brace the line sits, 0..1
        let lo = 0, hi = 1;
        for (let i = 0; i < 30; i++) {
          const t = (lo + hi) / 2;
          const x = 3 * (1 - t) * t * t * 0.552 + t ** 3;
          if (x < k) lo = t; else hi = t;
        }
        const t = (lo + hi) / 2;
        const rise = 3 * (1 - t) ** 2 * t * 0.552 + 3 * (1 - t) * t * t * 0.902 + t ** 3;
        return by - bh * rise;
      };
      for (const line of lines) {
        const d = Number(line.dataset.line);
        const foot = line.hasAttribute('data-to-brace')
          ? braceMeet(d)
          : line.hasAttribute('data-to-foot')
            ? base - fh
            : base;
        line.setAttribute('d', arch(cx, base, A, d, false, foot));
      }

      // The path inside runs right down to the threshold, where it meets the forecourt.
      // The forecourt: a flat plane laid from the foot of the wall toward you, seen from eye
      // level in the doorway, so it widens and comes closer exactly as real ground does.
      if (ground && groundPlane) {
        // The same standing eye level as the room seen through the doorway, so the paving and the
        // room's floor recede to one horizon.
        const eye = Math.max(20, APEX * A * (1.6 / 2.4));
        const d = Math.max(400, eye * 5);
        ground.style.top = `${n(floor)}px`;
        ground.style.height = `${n(Math.max(0, h - floor) + 4)}px`;
        ground.style.perspective = `${n(d)}px`;
        // the eye is 1.6m above the doorway's floor, so a step's height more above the paving
        ground.style.perspectiveOrigin = `${n(cx)}px ${n(-(eye + stepH))}px`;
        const tile = Math.max(120, A * 2.6);
        groundPlane.style.left = `${n(cx - w * 2)}px`;
        groundPlane.style.width = `${n(w * 4)}px`;
        groundPlane.style.height = `${n(d * 0.97)}px`;
        groundPlane.style.backgroundSize = `${n(tile)}px ${n(tile)}px`;
        // Offset the tile so its mirror lines don't fall on the doorway's centre line.
        groundPlane.style.backgroundPosition = `${n(w * 2 - tile * 0.23)}px ${n(tile * 0.31)}px`;
        ground.style.opacity = String(Math.max(0, 1 - Math.max(0, open - 0.8) * 5));
        // The raised edge of the paving, along the wall and across the threshold. The paving's far
        // edge lies flat in the screen (no perspective there), so each grout joint along it sits at
        // an exact x: the tile's origin (cx - 0.23 tile, from the background offset above) plus the
        // joint's place across the tile. Every lift runs joint to joint, sized by the tile, so it
        // stays fixed to the paving as the gateway zooms.
        if (sill && sillStones) {
          sill.style.opacity = ground.style.opacity;
          const key = `${n(w)},${n(floor)},${n(tile)}`;
          if (key !== edgeKey) {
            edgeKey = key;
            // Grout joints across the paving image, in the row of stones that meets the wall.
            const JOINTS = [0.13, 0.2707, 0.4607, 0.5379, 0.7264, 0.8686];
            const origin = cx - tile * 0.23;
            const xs: number[] = [];
            for (let k = Math.floor((0 - origin) / tile) - 1; k <= Math.ceil((w - origin) / tile); k++) {
              for (const u of JOINTS) xs.push(origin + (k + u) * tile);
            }
            // A steady per-stone value (so a stone keeps its height at every size).
            const hash = (k: number) => {
              const v = Math.sin(k * 127.1 + 311.7) * 43758.5453;
              return v - Math.floor(v);
            };
            // Line the paving image up with the ground: same tile, same origin; its row at the wall
            // line (0.69 down the tile, from the background offset) sits just under the lifts.
            const pat = sill.querySelector<SVGPatternElement>('[data-sill-paving]');
            const patImg = pat?.querySelector('image');
            if (pat && patImg) {
              pat.setAttribute('x', n(origin));
              pat.setAttribute('y', n(floor - tile * 0.695));
              pat.setAttribute('width', n(tile));
              pat.setAttribute('height', n(tile));
              patImg.setAttribute('width', n(tile));
              patImg.setAttribute('height', n(tile));
            }
            sill.querySelector('[data-sill-sides]')?.setAttribute('x2', n(w));
            const grout = Math.max(1, tile * 0.004);
            const soft = Math.max(0.4, tile * 0.0012);
            // The step: a slab 600mm deep across the doorway and frame (a little overhang each
            // side), its top and front foreshortened by the paving's own perspective.
            const m = (APEX * A) / 2.4;
            const eyeH = eye + stepH;
            const sc = d / (d - 0.6 * m);
            const L = A + EDGE + 0.08 * m;
            const yFB = floor + eyeH * (sc - 1); // front bottom edge, on the paving
            const yFT = yFB - stepH * sc; // front top edge (the arris)
            const xl0 = cx - L, xr0 = cx + L, xl1 = cx - L * sc, xr1 = cx + L * sc;
            const P = (pts: number[][]) => `M${pts.map(([x, y]) => `${n(x!)} ${n(y!)}`).join(' L')} Z`;
            const stonePat = sill.querySelector<SVGPatternElement>('[data-step-stone]');
            const stoneImg = stonePat?.querySelector('image');
            if (stonePat && stoneImg) {
              // The step's stone: several of the paving's own pavers laid end to end (824 × 220 px,
              // cut from the 1000 px paving image), so at the paving's scale it is the same stone.
              const pave = Math.max(120, A * 2.6) / 1000;
              const sw = 824 * pave, sh = 220 * pave;
              stonePat.setAttribute('x', n(cx - sw * 0.37));
              stonePat.setAttribute('y', n(base - sh * 0.3));
              for (const el of [stonePat, stoneImg]) { el.setAttribute('width', n(sw)); el.setAttribute('height', n(sh)); }
            }
            sill.querySelector('[data-step-blur]')?.setAttribute('stdDeviation', n(Math.max(0.8, stepH * 0.35)));
            const top = P([[xl0, base], [xr0, base], [xr1, yFT], [xl1, yFT]]);
            const front = P([[xl1, yFT], [xr1, yFT], [xr1, yFB], [xl1, yFB]]);
            let t =
              // its shadow on the paving, thrown to the right by the light from the left (none in
              // front: the light is in front)
              `<path d="${P([[xr0 - 1, floor], [xr1 - 1, yFB], [xr1 + stepH * 1.8 * sc, yFB], [xr0 + stepH * 1.8, floor]])}" fill="rgb(4 6 3 / 0.5)" filter="url(#sia-step-blur)" />` +
              // the front face: the stone, turned a little from the light
              `<path d="${front}" fill="url(#sia-step-stone)" />` +
              `<path d="${front}" fill="rgb(10 14 8 / 0.5)" />` +
              // the top: the stone in the light, shaded where it meets the wall and the doorway
              `<path d="${top}" fill="url(#sia-step-stone)" />` +
              `<path d="${top}" fill="rgb(10 14 8 / 0.14)" />` +
              `<path d="${top}" fill="url(#sia-step-ao)" />` +
              // across the whole step, lighter on the left (nearer the light)
              `<path d="${top} ${front}" fill="url(#sia-step-side)" />` +
              // a worn, lit arris along the front edge, and a dark joint under the front
              `<path d="M${n(xl1)} ${n(yFT + 0.5)} L${n(xr1)} ${n(yFT + 0.5)}" stroke="rgb(236 238 224 / 0.4)" stroke-width="${n(Math.max(0.8, stepH * 0.12))}" />` +
              // seated on the paving: the foot of the front face darkens where it meets the stones
              `<path d="${P([[xl1, yFB - stepH * sc * 0.35], [xr1, yFB - stepH * sc * 0.35], [xr1, yFB], [xl1, yFB]])}" fill="url(#sia-step-foot)" />`;
            const stepFoot = sill.querySelector('[data-step-foot]');
            if (stepFoot) { stepFoot.setAttribute('y1', n(yFB - stepH * sc * 0.35)); stepFoot.setAttribute('y2', n(yFB)); }
            const stepAo = sill.querySelector('[data-step-ao]');
            if (stepAo) { stepAo.setAttribute('y1', n(base)); stepAo.setAttribute('y2', n(yFT)); }
            const stepSide = sill.querySelector('[data-step-side]');
            if (stepSide) { stepSide.setAttribute('x1', n(xl1)); stepSide.setAttribute('x2', n(xr1)); }
            for (let i = 0; i < xs.length - 1; i++) {
              const x0 = xs[i]! + grout;
              const x1 = xs[i + 1]! - grout;
              if (x1 < -20 || x0 > w + 20) continue;
              if (x1 > xl0 && x0 < xr0) continue; // under the step
              const id = Math.round((xs[i]! - origin) / tile * 10000);
              const hv = hash(id);
              const rise = tile * (0.0016 + hv * 0.0016); // a fraction: no toe would catch on it
              const yTop = floor - rise;
              const yMid = yTop - tile * hash(id + 7) * 0.0008;
              const r = Math.min((x1 - x0) * 0.12, tile * 0.014);
              const top =
                `M${n(x0)} ${n(floor + rise)} ` +
                `C${n(x0)} ${n(yTop)} ${n(x0 + r * 0.3)} ${n(yTop)} ${n(x0 + r)} ${n(yTop)} ` +
                `Q${n((x0 + x1) / 2)} ${n(yMid)} ${n(x1 - r)} ${n(yTop)} ` +
                `C${n(x1 - r * 0.3)} ${n(yTop)} ${n(x1)} ${n(yTop)} ${n(x1)} ${n(floor + rise)}`;
              t +=
                // the lifted edge: the stone itself, with the paving's shading near the wall
                `<path d="${top} Z" fill="url(#sia-sill-paving)" />` +
                `<path d="${top} Z" fill="rgb(6 9 4 / 0.42)" />` +
                `<path d="${top} Z" fill="url(#sia-sill-sides)" />` +
                // light catching that edge from the upper left
                `<path d="${top}" fill="none" stroke="rgb(225 230 205 / 0.22)" stroke-width="${n(soft * 1.6)}" filter="url(#sia-sill-soft)" />`;
            }
            // a grout dip at each joint, sinking a little into the paving
            for (const x of xs) {
              if (x < -10 || x > w + 10) continue;
              if (x > xl0 - 2 && x < xr0 + 2) continue;
              t += `<ellipse cx="${n(x)}" cy="${n(floor + tile * 0.0015)}" rx="${n(Math.max(1, tile * 0.005))}" ry="${n(Math.max(1.2, tile * 0.006))}" fill="rgb(10 12 8 / 0.5)" filter="url(#sia-sill-soft)" />`;
            }
            sillStones.innerHTML = t;
          }
        }
        if (wallFoot) {
          const band = Math.max(10, A * 0.12);
          wallFoot.style.top = `${n(floor - band)}px`;
          wallFoot.style.height = `${n(band)}px`;
          wallFoot.style.opacity = ground.style.opacity;
        }
      }

      // Carved couplets in the wall either side, from the shoulder of the doorway downward.
      const room = cx - A0 - EDGE - 24;
      const size = Math.min(56, Math.max(28, A0 * 0.36));
      const show = room > size * 1.6 ? Math.max(0, 1 - open * 2.4) : 0;
      const k = (size / 40) * s;
      // Beside the doorway, with a little breathing room between frame and text.
      const offset = A + EDGE + size * 1.45 * s;
      const yTop = base - (SHOULDER * A) + size * 0.4 * s;
      couplets.right.setAttribute('transform', `translate(${n(cx + offset)} ${n(yTop)}) scale(${n(k)})`);
      couplets.left.setAttribute('transform', `translate(${n(cx - offset)} ${n(yTop)}) scale(${n(k)})`);
      couplets.right.style.opacity = couplets.left.style.opacity = String(show);
      const coupletsShown = show > 0 || room > size * 1.6;

      // The garden: placed in the closed view, then carried with the walk-in (scaled about the
      // same eye point), so it stays put on the forecourt as you step through.
      if (garden) {
        for (const p of props) {
          if (!p.el) continue;
          // Straight bamboo beside each couplet, its canopy leaning out over the characters
          // toward the door: sized so the canopy clears the couplet's top.
          const foot0 = base0 + stepH0 + Math.min(p.forward * A0, (h - base0 - stepH0) * 0.85);
          const yTop0 = base0 - SHOULDER * A0 + size * 0.4;
          const cTop0 = yTop0 - size * 0.6 - A0 * 0.05;
          // Tall, but the whole plant stays in view: up to just below the top of the scene.
          let h0 = Math.min(Math.max((foot0 - cTop0) / (1 - p.canopy), foot0), foot0 - 16);
          let w0 = h0 / p.ratio;
          // The pot must stand clear of its couplet: its inner side (pot centre + half the pot,
          // about 0.23 of the picture) stays outside the characters' outer edge, with a gap. On a
          // narrow screen, where it can't fit at full size, the plant is scaled down until it does.
          const coupletOuter = cx - (A0 + EDGE + size * 1.45) - size * 0.6;
          const potIn = p.trough + 0.23;
          const fitW = (coupletOuter - 6) / potIn;
          // Below half size the plant would look like a toy: leave it out (the couplets stay).
          const fits = fitW >= w0 * 0.5;
          if (w0 > fitW) {
            w0 = Math.max(0, fitW);
            h0 = w0 * p.ratio;
          }
          // Where the bamboo stands: out in the wall beside each couplet (as before the couplets
          // moved in), the canopy leaning in toward the door.
          const cX0 = cx + p.side * (A0 + EDGE + Math.min((cx - A0 - EDGE) * 0.64, A0 * 1.9));
          // Picture's left edge: the couplet sits `over` across it (mirrored on the right).
          // Keep the whole plant on screen sideways too.
          let left0 = p.side < 0 ? cX0 - p.over * w0 : cX0 - (1 - p.over) * w0;
          left0 = p.side < 0
            ? Math.min(left0, coupletOuter - potIn * w0)
            : Math.max(left0, w - coupletOuter - (1 - potIn) * w0);
          left0 = Math.min(Math.max(left0, 6), w - w0 - 6);
          // Tall bamboo may run off the top of the scene, as it would through a real view.
          const show = coupletsShown && fits;
          p.el.style.display = show ? 'block' : 'none';
          if (!show) continue;
          const wid = w0 * s;
          const hgt = h0 * s;
          const foot = pivotY + (foot0 - pivotY) * s;
          p.el.style.left = `${n(cx + (left0 - cx) * s)}px`;
          p.el.style.top = `${n(foot - hgt)}px`;
          p.el.style.width = `${n(wid)}px`;
          p.el.style.setProperty('--sx', `${n((p.side < 0 ? p.trough : 1 - p.trough) * 100)}%`);
          p.el.style.setProperty('--sw', '22%');
          // Where the wall meets the paving, measured up from the plant's foot (the wall shadow stops there).
          // The ground shadow's lean: across 22% of the picture's width over the ground to the wall.
          p.el.style.setProperty('--gskew', `${n((-Math.atan((wid * 0.22) / Math.max(1, foot - floor)) * 180) / Math.PI)}deg`);
          p.el.style.setProperty('--gblur', `${n(Math.max(2, wid * 0.014))}px`);
          p.el.style.setProperty('--wallcut', `${n(Math.max(0, ((foot - floor) / hgt) * 100 - 0.6))}%`);
        }
        garden.style.opacity = String(Math.max(0, 1 - Math.max(0, open - 0.6) * 4));
      }

      archFrame.style.opacity = String(Math.max(0, 1 - Math.max(0, open - 0.8) * 5));
      // The wall zooms with the doorway: scaled about the same point (the eye level in the doorway).
      if (wallLayer) {
        wallLayer.style.transformOrigin = `${n(cx)}px ${n(pivotY)}px`;
        wallLayer.style.transform = s === 1 ? '' : `scale(${Math.round(s * 1000) / 1000})`;
      }
      // 入 and its line sit just above the arch and zoom with it (kept clear of the top of the stage
      // only in the closed view).
      if (threshold) {
        const gapAbove = (threshold.offsetHeight + 14) * s;
        const y = base - APEX * A - EDGE - gapAbove;
        threshold.style.top = `${n(s === 1 ? Math.max(8, y) : y)}px`;
        threshold.style.transformOrigin = '50% 0';
        threshold.style.transform = `translateX(-50%) scale(${(Math.round(s * 1000) / 1000)})`;
      }
    };

    update();
    addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener('resize', update, { passive: true });
  }

  // Treatment menu: hovering, focusing or tapping a treatment crossfades the picture.
  const frame = document.querySelector('[data-treatment-frame]');
  if (frame) {
    const show = (key: string | undefined) => {
      if (!key) return;
      for (const img of frame.querySelectorAll<HTMLElement>('[data-treatment-img]')) {
        img.classList.toggle('is-active', img.dataset.treatmentImg === key);
      }
    };
    // Change only once the pointer rests on a card, so sweeping across the grid
    // doesn't blend several pictures together.
    let dwell = 0;
    for (const item of document.querySelectorAll<HTMLElement>('[data-treatment]')) {
      const key = item.dataset.treatment;
      item.addEventListener('pointerenter', () => {
        clearTimeout(dwell);
        dwell = window.setTimeout(() => show(key), 180);
      });
      item.addEventListener('pointerleave', () => clearTimeout(dwell));
      item.addEventListener('focusin', () => show(key));
      item.addEventListener('click', () => show(key));
    }
  }
</script>

<script>
  // Rain pause: the card's bottom edge runs through the join between the lotus's lower-left
  // petal and the petal above it (55.3% down the lotus picture). The card stays centred, so it
  // grows equally up and down to reach it. Recalculated whenever the section or lotus resizes.
  const rain = document.querySelector<HTMLElement>('.sia-rain');
  const rainCard = rain?.querySelector<HTMLElement>('.sia-rain__card');
  const rainLotus = rain?.querySelector<HTMLElement>('.sia-rain__lotus-flower');
  if (rain && rainCard && rainLotus) {
    const JOIN = 0.553;
    const wide = window.matchMedia('(min-width: 900px)');
    const fit = () => {
      if (!wide.matches) { rainCard.style.minHeight = ''; return; }
      const s = rain.getBoundingClientRect();
      const l = rainLotus.getBoundingClientRect();
      if (!l.height) return;
      const centre = s.top + s.height / 2;
      const height = 2 * (l.top + JOIN * l.height - centre);
      rainCard.style.minHeight = height > 0 ? `${Math.round(height)}px` : '';
    };
    new ResizeObserver(fit).observe(rain);
    new ResizeObserver(fit).observe(rainLotus);
    fit();
  }
</script>
