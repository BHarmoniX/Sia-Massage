---
// SIA MASSAGE: one-page site. Prices, treatments and copy marked MOCK are placeholders.
// Photography: Unsplash (free licence); artwork: The Met Open Access (public domain).
// Full credits in docs/CREDITS.md.
import ScrollCue from '../components/layout/ScrollCue.astro';
import Section from '../components/layout/Section.astro';
import Img from '../components/media/Img.astro';
import InkLandscape from '../client/InkLandscape.astro';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import { formatAuPhone, site, telHref } from '../config/site';

import bambooLight from '../client/photos/bamboo-light.jpg';
import teaTable from '../client/photos/tea-table.jpg';
import towelCandles from '../client/photos/towel-candles.jpg';
import therapistLinen from '../client/photos/therapist-linen.jpg';
// The view through the doorway: a candlelit spa treatment room (generated for Sia, OpenArt).
// The earlier bamboo path photo (bamboo-path.jpg) is kept in the photos folder in case it's wanted back.
import spaRoom from '../client/photos/spa-room.jpg';
import bambooBasin from '../client/photos/bamboo-basin.jpg';
import mossWaterfall from '../client/photos/moss-waterfall.jpg';
import mossRiver from '../client/photos/moss-river.jpg';
// The rain pause: a still forest pond, and one glass-white lotus on its lily pads (both generated for Sia).
import rainPond from '../client/photos/rain-pond.jpg';
// The lotus in two layers: its lily pads (behind the glass card) and the flower (in front of it).
import rainLotusPads from '../client/photos/rain-lotus-pads.webp';
import rainLotusFlower from '../client/photos/rain-lotus-flower.webp';
// Timber in a dark Japanese stain (the unstained originals stay on file beside them).
import doorBoardsLeft from '../client/photos/door-boards-left-stained.jpg';
import doorBoardsRight from '../client/photos/door-boards-right-stained.jpg';
import frameWalnut from '../client/photos/frame-walnut-stained.jpg';
import doorIron from '../client/photos/door-iron.jpg';
import groundStone from '../client/photos/ground-stone.jpg';
import stepStone from '../client/photos/step-stone.jpg';
import wallPlaster from '../client/photos/wall-plaster.jpg';
import gardenBambooA from '../client/photos/garden-bamboo-a.webp';
import gardenBambooB from '../client/photos/garden-bamboo-b.webp';
import gardenBambooAShadow from '../client/photos/garden-bamboo-a-shadow.webp';
import gardenBambooBShadow from '../client/photos/garden-bamboo-b-shadow.webp';
import { getImage } from 'astro:assets';

// The doorway's doors: natural oiled hardwood boards, one sheet per leaf, cut from a real
// hardwood photo turned so its grain runs up the boards (each board a different part of it).
// Compressed to WebP at build time.
const doorLeftImg = await getImage({ src: doorBoardsLeft, width: 600, format: 'webp', quality: 80 });
const doorRightImg = await getImage({ src: doorBoardsRight, width: 600, format: 'webp', quality: 80 });
// The arch frame's timber: an original walnut texture generated for Sia (OpenArt, commercial
// licence), grain running along the timber.
const frameWalnutImg = await getImage({ src: frameWalnut, width: 700, format: 'webp', quality: 78 });
// The door hardware's metal: an original hand-forged iron texture generated for Sia (OpenArt).
const doorIronImg = await getImage({ src: doorIron, width: 400, format: 'webp', quality: 78 });
// The forecourt: an original mossy flagstone texture generated for Sia (OpenArt), mirrored
// into a seamless tile.
const groundStoneImg = await getImage({ src: groundStone, width: 1000, format: 'webp', quality: 76 });
const stepStoneImg = await getImage({ src: stepStone, width: 824, format: 'webp', quality: 82 });
// The wall: an original moss lime-plaster texture generated for Sia (OpenArt), mirrored into a
// seamless tile.
const wallPlasterImg = await getImage({ src: wallPlaster, width: 1200, format: 'webp', quality: 74 });
// The courtyard garden: original cut-outs generated for Sia (OpenArt) — tall, airy bamboo in round
// carved stone pots, its tips leaning toward the door.
const bambooAImg = await getImage({ src: gardenBambooA, width: 1000, format: 'webp', quality: 80 });
const bambooBImg = await getImage({ src: gardenBambooB, width: 1000, format: 'webp', quality: 80 });
// Each plant's shadow, pre-blurred (a live blur filter on the plants is too heavy to paint).
const bambooAShadowImg = await getImage({ src: gardenBambooAShadow, width: 450, format: 'webp', quality: 70 });
const bambooBShadowImg = await getImage({ src: gardenBambooBShadow, width: 450, format: 'webp', quality: 70 });

const { business } = site;
const phone = business.phone!;
const address = business.address!;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${address.street}, ${address.suburb} ${address.state} ${address.postcode}`,
)}`;

// Pictures the treatment menu crossfades between as you move through it.
// Pictures the menu crossfades between as you move through it.
const treatmentImages = {
  oil: { src: therapistLinen, alt: 'A therapist in a linen uniform giving a slow relaxation massage in soft daylight' },
  calm: { src: towelCandles, alt: 'Rolled towel, candles and a reed diffuser in soft light' },
  tea: { src: teaTable, alt: 'Tea set laid out on a long wooden table' },
  water: { src: bambooBasin, alt: 'Water running from a bamboo spout into a stone basin' },
} as const;

// Sia offers relaxation massage only. MOCK: options, durations and prices.
const treatments = [
  {
    name: 'A quiet pause',
    zh: '片刻',
    image: 'oil',
    text: 'Back, neck and shoulders. Thirty minutes to set the day down.',
    prices: [['30 min', '$55']],
  },
  {
    name: 'Classic relaxation',
    zh: '放松',
    image: 'oil',
    text: 'Full body, long flowing strokes with warm oil. Our most loved hour.',
    prices: [['60 min', '$90']],
  },
  {
    name: 'Deep relaxation',
    zh: '静养',
    image: 'calm',
    text: 'Unhurried, full body, with time to drift somewhere quiet.',
    prices: [['90 min', '$130']],
  },
  {
    name: 'The Sia ritual',
    zh: '仪式',
    image: 'tea',
    text: 'Our longest: full body, scalp and feet, finished with warm tea.',
    prices: [['120 min', '$170']],
  },
  {
    name: 'Together',
    zh: '同享',
    image: 'calm',
    text: 'Side-by-side relaxation massage for two, in the same quiet room.',
    prices: [['60 min', '$180'], ['90 min', '$260']],
  },
  {
    name: 'Gift of calm',
    zh: '礼物',
    image: 'water',
    text: 'A voucher for any treatment, beautifully presented.',
    prices: [['From', '$55']],
  },
] as const;

const journey = [
  { n: '一', title: 'Arrive', text: 'Leave the day at the door. Warm tea, a quiet welcome, a few words about how you feel.' },
  { n: '二', title: 'Breathe', text: 'Soft light, clean linen, the scent of camphor. Your therapist tunes the pressure to you.' },
  { n: '三', title: 'Release', text: 'Skilled hands follow tension to its source, guided by traditional technique.' },
  { n: '四', title: 'Restore', text: 'Rise slowly. Sit a moment. Leave lighter than you came.' },
];

// MOCK: answers to confirm with the owner
const faqs = [
  { q: 'Do I need to book ahead?', a: 'Booking is best, especially evenings and weekends. Walk-ins are welcome whenever a therapist is free.' },
  { q: 'What should I wear?', a: 'Come as you are. You undress only to your comfort, and stay covered with fresh towels throughout.' },
  { q: 'How early should I arrive?', a: 'Five to ten minutes before your time, so you can settle in and tell us about any health concerns.' },
  { q: 'Do you offer remedial or deep tissue massage?', a: 'We specialise in relaxation massage only, so every visit is about rest. Firmer pressure is always welcome on request.' },
  { q: 'Is massage safe during pregnancy?', a: 'Please let us know when booking and we will suggest the treatments that suit you.' },
];
---

<OnePageLayout>
  <!-- ───────────── Hero: an invitation, a window onto mountains ───────────── -->
  <section class="sia-hero" aria-labelledby="hero-title">
    <!-- A soft ink landscape across the foot of the hero: pale ridges drifting very slowly,
         and mist passing over them. -->
    <div class="sia-hero__land" aria-hidden="true">
      <svg class="sia-hero__ridge sia-hero__ridge--far" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 132 Q100 93 200 141 Q300 86 400 121 Q500 87 600 137 Q700 118 800 143 Q900 92 1000 120 Q1100 99 1200 132 Q1300 113 1400 141 Q1500 104 1600 121 Q1700 101 1800 137 Q1900 98 2000 143 Q2100 85 2200 120 Q2300 85 2400 132 V260 H0Z" /></svg>
      <div class="sia-hero__mist sia-hero__mist--high"></div>
      <svg class="sia-hero__ridge sia-hero__ridge--mid" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 173 Q100 144 200 178 Q300 166 400 190 Q500 130 600 152 Q700 129 800 197 Q900 160 1000 171 Q1100 153 1200 173 Q1300 148 1400 178 Q1500 158 1600 190 Q1700 126 1800 152 Q1900 138 2000 197 Q2100 156 2200 171 Q2300 158 2400 173 V260 H0Z" /></svg>
      <div class="sia-hero__mist"></div>
      <svg class="sia-hero__ridge sia-hero__ridge--near" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 201 Q100 183 200 233 Q300 193 400 209 Q500 191 600 228 Q700 180 800 200 Q900 190 1000 233 Q1100 190 1200 201 Q1300 185 1400 233 Q1500 198 1600 209 Q1700 199 1800 228 Q1900 191 2000 200 Q2100 182 2200 233 Q2300 183 2400 201 V260 H0Z" /></svg>
    </div>
    <div class="sia-hero__bamboo" aria-hidden="true">
      <Img src={bambooLight} alt="" sizes="50vw" priority class="h-full w-full object-cover" />
    </div>

    <div class="sia-hero__grid">
      <div class="sia-hero__copy" data-reveal>
        <h1 id="hero-title" class="sia-display">
          Sia<br /><em>Massage</em>
        </h1>
        <p class="sia-hero__lede">
          Traditional Asian relaxation massage in a quiet room, with unhurried hands. An hour that belongs only to you.
        </p>
        <div class="sia-hero__cta-group">
          <div class="sia-hero__actions">
            <a href="#contact" class="btn-3d">Book a treatment</a>
            <a href="#treatments" class="btn-3d sia-btn-white">See the menu</a>
          </div>
          <p class="sia-hero__hours">{business.hours}</p>
        </div>
      </div>

      <div class="sia-hero__gate-wrap" data-reveal>
        <div class="sia-moongate" data-tilt>
          <div class="sia-moongate__face">
            <InkLandscape class="absolute inset-0 h-full w-full" />
            <!-- 静息, "quiet rest": inscribed on the scene like a painting's calligraphy. -->
            <span class="sia-hero__rest font-han" lang="zh-Hans" aria-hidden="true"><span data-depth="0.5">静</span><span data-depth="0.7">息</span></span>
          </div>
        </div>
      </div>
    </div>

    <ScrollCue href="#philosophy" label="Scroll to our philosophy" />
  </section>

  <!-- ───────────── Philosophy: photograph and crystal card, side by side ───────────── -->
  <Section id="philosophy" labelledby="philosophy-title" class="sia-philosophy sia-tone-moss">
    <div class="sia-philosophy__grid">
      <figure class="sia-philosophy__tea img-reveal">
        <div class="scroll-drift h-full">
          <Img src={teaTable} alt="Tea set laid out on a long wooden table in soft evening light" sizes="(min-width: 1024px) 58vw, 100vw" class="h-full w-full object-cover" />
        </div>
      </figure>

      <div class="sia-philosophy__card glass-3d crystal" data-glow data-reveal>
        <p class="sia-kicker font-han" lang="zh-Hans">静心 <span>a quiet heart</span></p>
        <h2 id="philosophy-title" class="sia-heading">A quiet place to return to yourself</h2>
        <p>
          At Sia, massage is not a rush between appointments. Drawing on traditional Asian bodywork,
          every treatment is slow and attentive, so the body can soften and the mind can rest.
        </p>
        <p>Clean linen, low light, a cup of tea. Nothing to do but breathe.</p>
        <blockquote>When the body is at ease, the heart follows.</blockquote>
      </div>
    </div>
  </Section>

  <!-- ───────────── Rain: a breathing pause ───────────── -->
  <!-- Layers, back to front: the pond; the lotus's lily pads (with its shadow and reflection on the
       water); the glass card; the lotus flower. The pads show softly through the glass and the bloom
       stands in front of it, so card and pond read as one picture. -->
  <section class="sia-rain" aria-labelledby="promise-title">
    <div class="sia-rain__pond-layer" aria-hidden="true"><Img src={rainPond} alt="" sizes="100vw" class="sia-rain__pond" /></div>
    <div class="sia-rain__veil" aria-hidden="true"></div>
    <div class="sia-rain__lotus sia-rain__lotus--pads" aria-hidden="true">
      <span class="sia-rain__lotus-shadow"></span>
      <Img src={rainLotusFlower} alt="" sizes="60vw" widths={[480, 768, 1120, 1600]} class="sia-rain__lotus-reflection" />
      <Img src={rainLotusPads} alt="" sizes="60vw" widths={[480, 768, 1120, 1600]} class="sia-rain__lotus-pads" />
    </div>
    <div class="sia-rain__scene">
      <!-- Sia's promise: a genuine, professional relaxation massage. The lotus, which rises clean
           from still water, is the traditional Asian sign of purity. (Owner to confirm the details.) -->
      <div class="sia-rain__card glass-3d" data-glow data-reveal>
        <span class="font-han" lang="zh-Hans" aria-hidden="true">净</span>
        <h2 id="promise-title" class="sia-rain__title">Pure, professional care</h2>
        <p>
          Like the lotus rising clean from still water, every visit is genuine relaxation massage,
          nothing more. Qualified therapists, fresh linen for every guest, and you stay covered and
          respected throughout.
        </p>
      </div>
    </div>
    <div class="sia-rain__lotus sia-rain__lotus--flower" aria-hidden="true">
      <Img src={rainLotusFlower} alt="" sizes="60vw" widths={[480, 768, 1120, 1600]} class="sia-rain__lotus-flower" />
    </div>
  </section>

  <!-- ───────────── Colour break: moss washes from the rain into the treatments ───────────── -->
  <section class="sia-scroll" aria-hidden="true">
    <svg class="sia-colourbreak" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sia-break-a" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#2f3d2a" />
          <stop offset="0.45" stop-color="#5c7a4c" />
          <stop offset="1" stop-color="#b9c8a4" />
        </linearGradient>
        <linearGradient id="sia-break-b" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#b9c8a4" />
          <stop offset="0.6" stop-color="#dfe5d4" />
          <stop offset="1" stop-color="#5c7a4c" />
        </linearGradient>
      </defs>
      <path class="sia-colourbreak__back" fill="url(#sia-break-b)" opacity="0.7"
        d="M0 0 H1440 V58 C1300 92 1160 34 1010 62 C860 90 720 40 560 66 C400 92 250 48 120 70 C70 78 30 76 0 72 Z" />
      <path class="sia-colourbreak__front" fill="url(#sia-break-a)"
        d="M0 0 H1440 V30 C1310 60 1180 14 1030 38 C880 62 740 18 590 42 C430 68 290 26 150 46 C90 54 40 52 0 48 Z" />
    </svg>
  </section>

  <!-- ───────────── Treatments: menu with a living picture ───────────── -->
  <Section id="treatments" labelledby="treatments-title" class="sia-treatments">
    <div class="sia-treatments__backdrop" aria-hidden="true">
      <div class="scroll-drift h-full">
        <Img src={mossRiver} alt="" sizes="100vw" class="h-full w-full object-cover" />
      </div>
    </div>
    <div class="sia-treatments__grid">
      <header class="sia-treatments__head" data-reveal>
        <h2 id="treatments-title" class="sia-heading">Relaxation massage</h2>
        <p>One treatment, perfected. Choose your time; we tailor the pressure to you on the day.<br />Prices in AUD, GST inclusive.</p>
      </header>

      <div class="sia-treatments__visual" data-reveal>
        <div class="sia-treatments__frame" data-treatment-frame>
          {
            Object.entries(treatmentImages).map(([key, img], i) => (
              <div class:list={['sia-treatments__img', { 'is-active': i === 0 }]} data-treatment-img={key}>
                <Img src={img.src} alt={img.alt} sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>

      <ul class="sia-menu" role="list">
        {
          treatments.map((t) => (
            <li class="sia-menu__card sia-moss-glass glass-3d crystal float" data-treatment={t.image} tabindex="0" data-glow data-reveal>
              <h3>
                {t.name}
                <span class="font-han" lang="zh-Hans">{t.zh}</span>
              </h3>
              <p>{t.text}</p>
              <dl>
                {t.prices.map(([time, price]) => (
                  <div>
                    <dt>{time}</dt>
                    <span class="sia-leader" aria-hidden="true" />
                    <dd>{price}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ───────────── Your visit: a doorway you step through ─────────────
       A tall arch stands on the page with the bamboo path running through it. Scrolling
       carries you into it: the arch widens until you stand on the path, then the four
       moments rise over the scene. -->
  <Section id="visit" labelledby="visit-title" class="sia-visit sia-tone-moss" data-doorway>
    <div class="sia-visit__stage" aria-hidden="true">
      <!-- The wall the doorway is set into: real moss lime plaster (trowel marks, mottling, fine
           cracks), lit from the top left like the frame. -->
      <svg class="sia-visit__wall" preserveAspectRatio="none">
        <defs>
          <pattern id="sia-plaster" width="760" height="760" patternUnits="userSpaceOnUse">
            <image href={wallPlasterImg.src} width="760" height="760" preserveAspectRatio="none" />
          </pattern>
          <radialGradient id="sia-wall-glow" cx="0.5" cy="0.7" r="0.5">
            <stop offset="0" stop-color="#c3d1a6" stop-opacity="0.16" />
            <stop offset="1" stop-color="#c3d1a6" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sia-wall-light" cx="0.28" cy="0.12" r="0.9">
            <stop offset="0" stop-color="#5c7a4c" stop-opacity="0.3" />
            <stop offset="1" stop-color="#5c7a4c" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sia-wall-shade" cx="0.8" cy="1" r="0.9">
            <stop offset="0" stop-color="#080c06" stop-opacity="0.5" />
            <stop offset="1" stop-color="#080c06" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="100%" height="100%" fill="url(#sia-plaster)" />
        <rect width="100%" height="100%" fill="url(#sia-wall-light)" />
        <rect width="100%" height="100%" fill="url(#sia-wall-shade)" />
        <rect width="100%" height="100%" fill="url(#sia-wall-glow)" />
      </svg>
      <!-- The ground: a stone forecourt in front of the wall, leading into the doorway. -->
      <div class="sia-visit__ground" data-ground data-texture={groundStoneImg.src}><div class="sia-visit__ground-plane"></div></div>
      <!-- The foot of the wall, darkened where it meets the paving (damp, splash and shade). -->
      <div class="sia-visit__wall-foot" data-wall-foot></div>
      <div class="sia-visit__door">
        <Img src={spaRoom} alt="" sizes="100vw" class="h-full w-full object-cover" />
      </div>
      <!-- A gateway: the outline of the client's stone arch (crown mirrored exactly, posts
           extended to doorway height), traced by a sage line and an even fine line. The path
           inside meets the stone forecourt at the threshold. Either side, carved and gilded into the wall, a couplet read right
           to left: 身体放松 · 心自宁静, "a relaxed body creates a calm mind". The doorway script
           draws everything from one geometry. -->
      <!-- Doors: the opening inside the inner timber, split down the centre into two solid
           timber leaves hinged on the posts. They swing in to reveal the path before the gateway
           opens around you. Drawn by the doorway script from the same geometry. -->
      <div class="sia-visit__doors" data-doors data-door-left={doorLeftImg.src} data-door-right={doorRightImg.src}>
        <div class="sia-visit__leaf" data-leaf="left"><svg class="sia-visit__leaf-svg"></svg><div class="sia-visit__leaf-edge"></div></div>
        <div class="sia-visit__leaf" data-leaf="right"><svg class="sia-visit__leaf-svg"></svg><div class="sia-visit__leaf-edge"></div></div>
      </div>
      <div class="sia-visit__glass" data-glass></div>
      <svg class="sia-visit__frame" data-frame>
        <defs>
          <!-- Carved into the plaster, lit from the upper left: the cut's upper-left walls fall into
               shade, its lower-right walls catch the light, and the floor sits a tone below the wall. -->
          <filter id="sia-engrave" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
            <feOffset in="SourceAlpha" dx="1.5" dy="1.7" result="sh" />
            <feComposite in="SourceAlpha" in2="sh" operator="out" result="shBand" />
            <feGaussianBlur in="shBand" stdDeviation="0.55" result="shBlur" />
            <feFlood flood-color="rgb(4 8 3)" flood-opacity="0.85" />
            <feComposite in2="shBlur" operator="in" result="shadow" />
            <feOffset in="SourceAlpha" dx="-1" dy="-1.1" result="hl" />
            <feComposite in="SourceAlpha" in2="hl" operator="out" result="hlBand" />
            <feGaussianBlur in="hlBand" stdDeviation="0.4" result="hlBlur" />
            <feFlood flood-color="rgb(214 226 192)" flood-opacity="0.5" />
            <feComposite in2="hlBlur" operator="in" result="light" />
            <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="shadow" /><feMergeNode in="light" /></feMerge>
          </filter>
        </defs>
        <defs>
          <!-- 3D lighting for timber: the shape's own edges, softened, become its relief, and the
               grain adds only a faint texture to the surface (kept low, so it reads as timber, not line art); lit from the top left with a soft satin
               (oiled, not glossy) sheen. One for
               the frame's narrow timbers, a softer, deeper one for the door leaves, and one for
               the raised door panels. -->
          <filter id="sia-bevel" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
            <feGaussianBlur in="SourceAlpha" stdDeviation="2.4" result="relief" />
            <feColorMatrix in="SourceGraphic" type="luminanceToAlpha" result="grainHeight" />
            <feComposite in="relief" in2="grainHeight" operator="arithmetic" k2="1" k3="0.2" result="surface" />
            <feDiffuseLighting in="surface" surfaceScale="3.5" diffuseConstant="1.25" lighting-color="#fff" result="diffuse">
              <feDistantLight azimuth="225" elevation="48" />
            </feDiffuseLighting>
            <feSpecularLighting in="surface" surfaceScale="3.5" specularConstant="0.16" specularExponent="5" lighting-color="#f1dcb8" result="sheen">
              <feDistantLight azimuth="225" elevation="40" />
            </feSpecularLighting>
            <feComposite in="SourceGraphic" in2="diffuse" operator="arithmetic" k1="1" result="lit" />
            <feComposite in="sheen" in2="SourceAlpha" operator="in" result="sheenIn" />
            <feComposite in="sheenIn" in2="lit" operator="arithmetic" k2="0.55" k3="1" result="out" />
            <feComposite in="out" in2="SourceAlpha" operator="in" />
          </filter>
          <filter id="sia-bevel-door" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
            <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="relief" />
            <feColorMatrix in="SourceGraphic" type="luminanceToAlpha" result="grainHeight" />
            <feComposite in="relief" in2="grainHeight" operator="arithmetic" k2="1" k3="0.1" result="surface" />
            <feDiffuseLighting in="surface" surfaceScale="5" diffuseConstant="1.2" lighting-color="#fff" result="diffuse">
              <feDistantLight azimuth="225" elevation="50" />
            </feDiffuseLighting>
            <feSpecularLighting in="surface" surfaceScale="5" specularConstant="0.16" specularExponent="5" lighting-color="#f1dcb8" result="sheen">
              <feDistantLight azimuth="225" elevation="38" />
            </feSpecularLighting>
            <feComposite in="SourceGraphic" in2="diffuse" operator="arithmetic" k1="1" result="lit" />
            <feComposite in="sheen" in2="SourceAlpha" operator="in" result="sheenIn" />
            <feComposite in="sheenIn" in2="lit" operator="arithmetic" k2="0.18" k3="1" result="out" />
            <feComposite in="out" in2="SourceAlpha" operator="in" />
          </filter>
          <filter id="sia-bevel-panel" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
            <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="relief" />
            <feColorMatrix in="SourceGraphic" type="luminanceToAlpha" result="grainHeight" />
            <feComposite in="relief" in2="grainHeight" operator="arithmetic" k2="1" k3="0.1" result="surface" />
            <feDiffuseLighting in="surface" surfaceScale="6" diffuseConstant="1.18" lighting-color="#fff" result="diffuse">
              <feDistantLight azimuth="225" elevation="52" />
            </feDiffuseLighting>
            <feSpecularLighting in="surface" surfaceScale="6" specularConstant="0.16" specularExponent="5" lighting-color="#f1dcb8" result="sheen">
              <feDistantLight azimuth="225" elevation="40" />
            </feSpecularLighting>
            <feComposite in="SourceGraphic" in2="diffuse" operator="arithmetic" k1="1" result="lit" />
            <feComposite in="sheen" in2="SourceAlpha" operator="in" result="sheenIn" />
            <feComposite in="sheenIn" in2="lit" operator="arithmetic" k2="0.18" k3="1" result="out" />
            <feComposite in="out" in2="SourceAlpha" operator="in" />
          </filter>
          <!-- Soft shadows: the frame on the wall, the timber on the glass, the rings on the doors. -->
          <filter id="sia-shadow-soft" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="6" />
          </filter>
          <filter id="sia-shadow-edge" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="1.8" />
          </filter>
          <filter id="sia-shadow-small" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="1.4" />
          </filter>
          <clipPath id="sia-glass-clip" clipPathUnits="userSpaceOnUse">
            <path data-glass-clip clip-rule="evenodd" />
          </clipPath>
          <!-- Metal for the door hardware: real hand-forged iron (generated for Sia), shaped by
               light: domes lit at the top left, straps lit along their top edge. -->
          <pattern id="sia-iron-tex" width="90" height="90" patternUnits="userSpaceOnUse">
            <image href={doorIronImg.src} width="90" height="90" preserveAspectRatio="none" />
          </pattern>
          <radialGradient id="sia-metal-dome" cx="0.36" cy="0.3" r="0.78">
            <stop offset="0" stop-color="#fff" stop-opacity="0.42" />
            <stop offset="0.35" stop-color="#fff" stop-opacity="0.06" />
            <stop offset="0.7" stop-color="#000" stop-opacity="0.18" />
            <stop offset="1" stop-color="#000" stop-opacity="0.55" />
          </radialGradient>
          <linearGradient id="sia-metal-strap" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0.3" />
            <stop offset="0.3" stop-color="#fff" stop-opacity="0.04" />
            <stop offset="0.65" stop-color="#000" stop-opacity="0.15" />
            <stop offset="1" stop-color="#000" stop-opacity="0.5" />
          </linearGradient>
          <linearGradient id="sia-metal-ring" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0.38" />
            <stop offset="0.45" stop-color="#fff" stop-opacity="0" />
            <stop offset="1" stop-color="#000" stop-opacity="0.45" />
          </linearGradient>
          <!-- A leaf turning away from the light darkens toward its free edge. -->
          <linearGradient id="sia-leaf-shade-left" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#000" stop-opacity="0.15" />
            <stop offset="1" stop-color="#000" stop-opacity="0.75" />
          </linearGradient>
          <linearGradient id="sia-leaf-shade-right" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#000" stop-opacity="0.15" />
            <stop offset="1" stop-color="#000" stop-opacity="0.75" />
          </linearGradient>
          <!-- Timber: an original walnut texture (generated for Sia), grain along the timber. -->
          <pattern id="sia-wood" width="240" height="358" patternUnits="userSpaceOnUse">
            <image href={frameWalnutImg.src} width="240" height="358" preserveAspectRatio="none" />
          </pattern>
          <clipPath id="sia-wall-clip" clipPathUnits="userSpaceOnUse">
            <path data-wall-clip clip-rule="evenodd" />
          </clipPath>
        </defs>
        <!-- The frame stands proud of the wall: its shadow falls on the wall below and right. -->
        <g clip-path="url(#sia-wall-clip)">
          <path class="sia-frame-shadow" data-frame-shadow filter="url(#sia-shadow-soft)" />
        </g>
        <!-- The glass is set back in the frame: the timber shades both edges of it. -->
        <g clip-path="url(#sia-glass-clip)">
          <path class="sia-glass-shade" data-glass-shade="outer" filter="url(#sia-shadow-edge)" />
          <path class="sia-glass-shade sia-glass-shade--inner" data-glass-shade="inner" filter="url(#sia-shadow-edge)" />
        </g>
        <!-- Timber frame around the glass: the structural support, same arch geometry. -->
        <path class="sia-timber" data-timber />
        <path class="sia-timber__edge sia-timber__edge--lit" data-timber-edge="lit" />
        <path class="sia-timber__edge sia-timber__edge--shade" data-timber-edge="shade" />
        <!-- A thin timber frame on the doorway's edge, then the narrow inner glass panel
             between two sage lines, meeting the wide outer panel. -->
        <path class="sia-timber" data-timber-inner />
        <path class="sia-timber__edge sia-timber__edge--lit" data-timber-inner-edge="lit" />
        <path class="sia-timber__edge sia-timber__edge--shade" data-timber-inner-edge="shade" />
        <!-- A fine sage line along the top side of each leg arch, behind the fine vertical lines. -->
        <path class="sia-arch__line sia-arch__brace-fine" data-brace-fine />
        <path class="sia-arch__line sia-arch__line--seam" data-line="13" />
        <!-- A fine design line a third of the way across the wide outer panel. -->
        <path class="sia-arch__line sia-arch__line--seam" data-line="23.3" data-to-brace />
        <!-- Timber feet: the arch's tip curve, turned over, flaring each leg into the ground. -->
        <path class="sia-arch__feet" data-feet />
        <!-- Braces: the arch's tip curve, right way up, from each outer foot to the inner line. -->
        <path class="sia-arch__line sia-arch__brace sia-arch__line--moss" data-braces />
        <!-- The moss outline, drawn last so it runs unbroken over the braces where they meet it:
             both thick lines (down to the top of each foot) and the lines across the feet. -->
        <path class="sia-arch__line sia-arch__line--moss" data-line="8" data-to-foot />
        <path class="sia-arch__line sia-arch__line--outer sia-arch__line--moss" data-line="48.4" data-to-foot />
        <path class="sia-arch__line sia-arch__foot-line sia-arch__line--moss" data-foot-line />
        <g class="sia-carving" data-couplet="right" lang="zh-Hans" role="img" aria-label="身体放松: a relaxed body">
          <text class="sia-carving__gilt" x="0" y="0"><tspan x="0" y="0.0em">身</tspan><tspan x="0" y="1.3em">体</tspan><tspan x="0" y="2.6em">放</tspan><tspan x="0" y="3.9em">松</tspan></text>
        </g>
        <g class="sia-carving" data-couplet="left" lang="zh-Hans" role="img" aria-label="心自宁静: creates a calm mind">
          <text class="sia-carving__gilt" x="0" y="0"><tspan x="0" y="0.0em">心</tspan><tspan x="0" y="1.3em">自</tspan><tspan x="0" y="2.6em">宁</tspan><tspan x="0" y="3.9em">静</tspan></text>
        </g>
      </svg>
      <!-- The paving's raised edge, along the wall and across the threshold (in front of the doors
           and frame): each stone lifts a fraction between its grout joints, so paving and wall or
           timber don't meet in a ruled line. Drawn by the script, pinned to the paving's joints. -->
      <svg class="sia-visit__edge" data-threshold aria-hidden="true">
        <defs>
          <!-- the paving image itself, lined up by the script with the paving below, so each lift is
               exactly the colour of the stone it belongs to -->
          <pattern id="sia-sill-paving" patternUnits="userSpaceOnUse" width="240" height="240" data-sill-paving>
            <image href={groundStoneImg.src} width="240" height="240" preserveAspectRatio="none" />
          </pattern>
          <!-- the paving's own shading near the wall (as .sia-visit__ground::after), darker at the sides -->
          <linearGradient id="sia-sill-sides" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0" data-sill-sides>
            <stop offset="0" stop-color="rgb(8 12 6)" stop-opacity="0.45" />
            <stop offset="0.3" stop-color="rgb(8 12 6)" stop-opacity="0" />
            <stop offset="0.7" stop-color="rgb(8 12 6)" stop-opacity="0" />
            <stop offset="1" stop-color="rgb(8 12 6)" stop-opacity="0.45" />
          </linearGradient>
          <!-- the stone step under the doorway: the same stone as the paving (several pavers laid end to end) -->
          <pattern id="sia-step-stone" patternUnits="userSpaceOnUse" width="200" height="200" data-step-stone>
            <image href={stepStoneImg.src} width="200" height="200" preserveAspectRatio="none" />
          </pattern>
          <linearGradient id="sia-step-ao" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="10" data-step-ao>
            <stop offset="0" stop-color="rgb(4 6 3)" stop-opacity="0.55" />
            <stop offset="0.35" stop-color="rgb(4 6 3)" stop-opacity="0.12" />
            <stop offset="1" stop-color="rgb(235 238 225)" stop-opacity="0.06" />
          </linearGradient>
          <linearGradient id="sia-step-side" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0" data-step-side>
            <stop offset="0" stop-color="rgb(240 240 228)" stop-opacity="0.1" />
            <stop offset="0.5" stop-color="rgb(240 240 228)" stop-opacity="0" />
            <stop offset="1" stop-color="rgb(4 6 3)" stop-opacity="0.18" />
          </linearGradient>
          <linearGradient id="sia-step-foot" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="10" data-step-foot>
            <stop offset="0" stop-color="rgb(4 6 3)" stop-opacity="0" />
            <stop offset="1" stop-color="rgb(4 6 3)" stop-opacity="0.35" />
          </linearGradient>
          <filter id="sia-step-blur" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="2" data-step-blur /></filter>
          <filter id="sia-sill-soft" x="-5%" y="-60%" width="110%" height="220%"><feGaussianBlur stdDeviation="0.45" /></filter>
        </defs>
        <g data-threshold-stones></g>
      </svg>
      <!-- The courtyard garden on the forecourt: bamboo either side of the doorway. -->
      <div class="sia-visit__garden" data-garden>
        <div class="sia-visit__prop" data-prop="bamboo-left"><img class="sia-visit__prop-shadow" src={bambooAShadowImg.src} alt="" decoding="async" /><img src={bambooAImg.src} alt="" decoding="async" /></div>
        <div class="sia-visit__prop sia-visit__prop--mirror" data-prop="bamboo-right"><img class="sia-visit__prop-shadow" src={bambooBShadowImg.src} alt="" decoding="async" /><img src={bambooBImg.src} alt="" decoding="async" /></div>
      </div>
      <p class="sia-visit__threshold">
        <!-- 入, carved into the plaster exactly like the couplets (same text style and #sia-engrave cut). -->
        <svg class="sia-visit__ru" viewBox="-24 -24 48 48" role="img" aria-label="入: enter" lang="zh-Hans">
          <g class="sia-carving"><text class="sia-carving__gilt" x="0" y="0">入</text></g>
        </svg>
        <span class="sia-visit__threshold-text">Step inside</span>
      </p>
    </div>
    <div class="sia-visit__inner">
      <h2 id="visit-title" class="sia-heading sia-heading--light" data-reveal>Four quiet moments</h2>
      <ol class="sia-visit__cards" role="list">
        {
          journey.map((j) => (
            <li class="sia-visit__card notch-host float" data-tilt data-reveal>
              <div class="sia-visit__panel glass-3d crystal notch" data-glow>
                <h3>{j.title}</h3>
                <p>{j.text}</p>
              </div>
              <span class="notch-piece glass-3d crystal font-han" aria-hidden="true" lang="zh-Hans">
                {j.n}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ───────────── Questions ───────────── -->
  <Section id="faq" labelledby="faq-title" class="sia-faq">
    <div class="sia-faq__grid">
      <figure class="sia-faq__image img-reveal">
        <Img src={bambooBasin} alt="Water running from a bamboo spout into a mossy stone basin" sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" />
      </figure>
      <div>
        <h2 id="faq-title" class="sia-heading" data-reveal>Before you arrive</h2>
        <div class="sia-faq__list" data-reveal>
          {
            faqs.map((f) => (
              <details class="sia-faq__item">
                <summary>
                  {f.q}
                  <span class="sia-faq__mark" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- ───────────── Contact: a glass booking card on moss and water ───────────── -->
  <Section id="contact" labelledby="contact-title" class="sia-contact">
    <div class="sia-contact__bg" aria-hidden="true">
      <Img src={mossWaterfall} alt="" sizes="100vw" class="h-full w-full object-cover sia-contact__falls" />
    </div>
    <div class="sia-contact__inner">
      <div class="notch-host sia-contact__card" data-reveal>
        <span class="notch-piece glass-3d crystal font-han sia-contact__seal" aria-hidden="true" lang="zh-Hans">约</span>
        <div class="sia-contact__panel glass-3d notch" data-glow>
          <h2 id="contact-title" class="sia-heading">Your hour of calm awaits</h2>
          <dl class="sia-contact__details">
            <div>
              <dt>Find us</dt>
              <dd>
                {address.street}<br />{`${address.suburb} ${address.state} ${address.postcode}`}
              </dd>
            </div>
            <div>
              <dt>Open</dt>
              <dd>{business.hours}</dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a href={telHref(phone)}>{formatAuPhone(phone)}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            </div>
          </dl>
          <div class="sia-contact__actions">
            <a href={telHref(phone)} class="btn-3d">Call to book</a>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-3d sia-btn-sage">Directions</a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</OnePageLayout>

<style is:global>
  .font-han {
    font-family: var(--font-han);
  }
  /* Sia's signature card finish: moss glass (translucent dark-moss frosted crystal). */
  .sia-moss-glass,
  .sia-moss-glass.glass-3d {
    --glass-tint: rgb(47 61 42 / 0.82);
    --color-text: #f3efe4;
    --color-muted: #d6dbc9;
    --color-subtle: #b3bca4;
    --color-accent: #c3d1a6;
    --color-accent-strong: #dbe6c2;
    color: var(--color-text);
  }
  .sia-moss-glass.crystal {
    box-shadow: 0 24px 44px -24px rgb(20 28 18 / 0.75);
  }
  /* Deep moss sections: the same components, re-toned by tokens. */
  .sia-tone-moss {
    --color-bg: #26321f;
    --color-surface: #33422c;
    --color-border: rgb(255 255 255 / 0.14);
    --color-text: #f3efe4;
    --color-muted: #d3d8c6;
    --color-subtle: #a9b39a;
    --color-accent: #c3d1a6;
    --color-accent-strong: #dbe6c2;
    --color-on-accent: #1f2a1b;
    background:
      radial-gradient(70% 60% at 20% 0%, rgb(195 209 166 / 0.10), transparent 70%),
      linear-gradient(180deg, #2b3824, #222d1c);
    color: var(--color-text);
  }
  .sia-display {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
  }
  .sia-display em {
    font-style: italic;
    color: var(--color-accent-strong);
  }
  .sia-heading {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1.05;
  }
  .sia-heading--light {
    color: #f6f3ec;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .sia-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  .sia-kicker span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-subtle);
  }

  /* ── Hero ── */
  .sia-hero {
    position: relative;
    /* Its own layer stack, so the buttons' carved holes (drawn just behind each button) sit
       above the hero's background rather than under it. */
    isolation: isolate;
    overflow: hidden;
    /* The page runs up behind the fixed glass header; the hero starts below it. */
    min-height: 100dvh;
    padding-top: var(--header-height);
    /* A gentle sage tone instead of plain paper: deeper toward the land, lighter up high. */
    background:
      radial-gradient(120% 70% at 75% 100%, rgb(196 210 176 / 0.55), transparent 70%),
      radial-gradient(80% 60% at 0% 0%, rgb(255 253 246 / 0.7), transparent 70%),
      linear-gradient(180deg, #f1f1e7, #e6ebdc);
  }
  .sia-hero__land {
    position: absolute;
    inset: auto 0 0 0;
    height: min(34vh, 22rem);
    pointer-events: none;
  }
  .sia-hero__ridge {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    height: 100%;
  }
  .sia-hero__ridge--far {
    height: 100%;
    fill: #d6dfc8;
  }
  .sia-hero__ridge--mid {
    height: 78%;
    fill: #bfcdaa;
    opacity: 0.75;
  }
  .sia-hero__ridge--near {
    height: 46%;
    fill: #9db18a;
    opacity: 0.55;
  }
  .sia-hero__mist {
    position: absolute;
    left: 0;
    bottom: 22%;
    width: 200%;
    height: 34%;
    background:
      radial-gradient(18% 50% at 12% 50%, rgb(246 243 236 / 0.85), transparent 70%),
      radial-gradient(22% 45% at 40% 55%, rgb(246 243 236 / 0.7), transparent 70%),
      radial-gradient(16% 50% at 62% 45%, rgb(246 243 236 / 0.8), transparent 70%),
      radial-gradient(20% 45% at 90% 55%, rgb(246 243 236 / 0.7), transparent 70%);
    filter: blur(6px);
  }
  .sia-hero__mist--high {
    bottom: 52%;
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sia-hero__ridge--far {
      animation: sia-slide 240s linear infinite;
    }
    .sia-hero__ridge--mid {
      animation: sia-slide 170s linear infinite;
    }
    .sia-hero__ridge--near {
      animation: sia-slide 120s linear infinite;
    }
    .sia-hero__mist {
      animation: sia-slide 90s linear infinite;
    }
    .sia-hero__mist--high {
      animation-duration: 130s;
      animation-direction: reverse;
    }
  }
  @keyframes sia-slide {
    to {
      transform: translateX(-50%);
    }
  }
  /* The scroll cue only makes sense when the hero fits one screen (wide layouts). */
  .sia-hero .scroll-cue {
    display: none;
  }
  @media (min-width: 1024px) {
    .sia-hero .scroll-cue {
      display: block;
    }
  }
  /* The bamboo is the wall's wallpaper: it carries on across the wall on both sides of the
     window, only fading out behind the hero text. */
  .sia-hero__bamboo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(82vw, 76rem);
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to left, black 55%, transparent 97%);
    mask-image: linear-gradient(to left, black 55%, transparent 97%);
    pointer-events: none;
  }
  .sia-hero__grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
    max-width: 82rem;
    /* Exactly the screen below the fixed header, so the hero centres in what you can see. */
    min-height: calc(100dvh - var(--header-height));
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  @media (min-width: 1024px) {
    .sia-hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      padding-inline: 3rem;
    }
  }
  .sia-hero__copy {
    position: relative;
    padding-left: clamp(0rem, 4vw, 3.5rem);
  }
  /* Side by side: lift the heading block so its top lines up with the top of the window. */
  @media (min-width: 1024px) {
    .sia-hero__copy {
      top: -2.1rem;
    }
  }
  .sia-hero__lede {
    max-width: 28rem;
    margin-top: 2rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  .sia-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }
  /* The buttons and the opening hours as one group, the hours centred beneath the buttons. */
  .sia-hero__cta-group {
    display: grid;
    width: fit-content;
    max-width: 100%;
  }
  .sia-hero__hours {
    margin-top: 1.75rem;
    text-align: center;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
  }
  .sia-hero__gate-wrap {
    position: relative;
    width: min(100%, 34rem);
    margin-inline: auto;
  }
  /* The moon gate as a deep round window in the hero wall: a slim frame (lit top left, shaded
     bottom right) with a thin mid-green trim, and depth from the wall's shadow falling into the opening from the top
     left with a little light bouncing up from the bottom right. The window stays still; only
     the scene inside moves. */
  .sia-moongate {
    position: relative;
    aspect-ratio: 1;
    border-radius: 9999px;
    padding: 6px;
    --depth-tilt: 7deg;
    background: linear-gradient(135deg, #fbfaf5 0%, #e9ebdf 45%, #c3ccb2 100%);
    box-shadow:
      0 0 0 2.5px #6f8c5c,
      0 0 0 3.5px rgb(255 255 255 / 0.45),
      0 1px 3px 2px rgb(39 50 42 / 0.16),
      0 6px 14px -8px rgb(39 50 42 / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 -1px 0 rgb(92 122 76 / 0.25);
  }
  .sia-moongate__face {
    position: relative;
    height: 100%;
    border-radius: 9999px;
    overflow: hidden;
  }
  .sia-moongate__face::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 30px 40px 60px rgb(39 50 42 / 0.42),
      inset 10px 14px 18px rgb(39 50 42 / 0.32),
      inset 2px 3px 3px rgb(39 50 42 / 0.4),
      inset -10px -14px 24px rgb(255 255 255 / 0.35);
  }
  /* 静息, "quiet rest": read top to bottom, centred low in the moon scene, pale and faint:
     静 on the rice paddies between the hill and the river, 息 on the dark hill below it
     (positions and size both follow the moon window, so they fit the same spot at any
     screen size). Clear of the sun, the clouds and the birds; it stays still as the scene
     moves. */
  .sia-hero__rest {
    position: absolute;
    inset: 0;
    z-index: 1;
    container-type: size;
    line-height: 1;
    color: rgb(214 223 200 / 0.5);
    pointer-events: none;
    user-select: none;
  }
  .sia-hero__rest > span {
    position: absolute;
    /* A share of the moon window's width, so 静 always fits between the hill and the river. */
    font-size: 4.5cqw;
    left: 50%;
    translate: -50% -50%;
    /* Fixed to the ground it sits on: each character carries the same depth as its layer
       (静 the valley, 息 the near hills), so the pointer parallax moves them together. The
       scene's depth shifts are in its own units (1200 across the window); convert to match. */
    transform: translate3d(calc(var(--px) * 100cqw / 1200), calc(var(--py) * 100cqw / 1200), 0);
  }
  .sia-hero__rest > span:first-child {
    top: 83.3%; /* ink centred between the hill's foot and the river */
    color: rgb(63 86 52 / 0.7);
  }
  .sia-hero__rest > span:last-child {
    top: 94%;
  }

  /* ── Philosophy: photograph + crystal card ── */
  .sia-philosophy__grid {
    display: grid;
    gap: 2rem;
    max-width: 82rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    align-items: center;
  }
  .sia-philosophy__tea {
    aspect-ratio: 4 / 5;
    border-radius: 0.5rem;
  }
  /* Frosted sage glass, the same as the header, with dark moss text. */
  .sia-philosophy__card.glass-3d.crystal {
    --glass-tint: #d6dfc8;
    --glass-blur: 22px;
    --color-text: #27322a;
    --color-muted: #3f4c3d;
    --color-subtle: #55624f;
    --color-accent: #5c7a4c;
    color: var(--color-text);
    background-image:
      linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 60%),
      linear-gradient(rgb(214 223 200 / 0.58), rgb(214 223 200 / 0.58));
    padding: 2.25rem;
  }
  .sia-philosophy__tea {
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }
  .sia-philosophy__card > * + * {
    margin-top: 1.1rem;
  }
  .sia-philosophy__card p {
    color: var(--color-muted);
  }
  .sia-philosophy__card blockquote {
    margin-top: 1.75rem;
    padding-left: 1.25rem;
    border-left: 1px solid color-mix(in oklab, var(--color-accent) 50%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
  }
  @media (min-width: 1024px) {
    /* Fits one screen below the header: the photo's height follows the screen (and it sits
       against the card, which overlaps its edge), while the card keeps its size. */
    .sia-philosophy__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      min-height: calc(100dvh - var(--header-height));
      padding: 3.5rem 3rem;
    }
    .sia-philosophy__tea {
      justify-self: end;
      height: min(calc(100dvh - var(--header-height) - 7rem), 47.5rem);
      max-width: 100%;
    }
    /* The card overlaps the photograph's edge by a fixed, deliberate amount. */
    .sia-philosophy__card {
      margin-left: -4rem;
      padding: 3.25rem;
      position: relative;
      z-index: 2;
    }
  }

  /* ── Rain interlude ── */
  .sia-rain {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(34rem, 92vh, 56rem);
    padding: 3.75rem 0; /* centred, and clear of the wave band below */
    overflow: hidden;
    isolation: isolate;
    background: #2a3726;
  }
  .sia-rain__pond {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }
  /* the photo's <picture> wrapper sits behind everything, out of the layout */
  .sia-rain__pond-layer {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .sia-rain__pond :global(img),
  .sia-rain :global(picture.sia-rain__pond img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }
  .sia-rain__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, #222d1c 0%, rgb(34 45 28 / 0) 18%, rgb(34 45 28 / 0) 82%, #26321f 100%),
      radial-gradient(70% 60% at 50% 45%, rgb(0 0 0 / 0), rgb(0 0 0 / 0.18));
  }
  /* The card, centred in the picture, its right edge running straight down to the tip of the
     lotus's top centre petal. That tip is 52.1% across the lotus picture, which spans 60% of the
     section from 46% in: 46 + 0.521 × 60 = 77.26% across. Centred, the card is then
     2 × (77.26 − 50) = 54.52% wide. (Change the lotus's left/right and this must change too.) */
  .sia-rain__scene {
    position: relative;
    z-index: 1; /* between the pads (0) and the flower (2) */
    display: grid;
    justify-items: center;
    width: 54.52%;
  }
  /* The same frosted glass as the contact card ("Your hour of calm awaits"). */
  /* Tint eased off a little (62% of 70%), so over the soft misty pond it reads as see-through as
     the contact card does over its bright waterfall. */
  .sia-rain__card.glass-3d {
    --glass-tint: rgb(246 243 236 / 0.7);
    width: 100%;
    /* the words stay centred however tall the card is made (see the script at the end) */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    /* the words sit on the left, the right third left clear for the lotus that rises over it
       (padding in % is a share of the card's own width) */
    padding: 3rem 41% 3rem clamp(2rem, 6%, 4rem);
    border-radius: 3.45rem;
    text-align: left;
  }
  .sia-rain__card span {
    font-size: 2.875rem;
    color: var(--color-accent-strong);
  }
  .sia-rain__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.2;
    color: var(--color-text);
  }
  .sia-rain__card p {
    max-width: 30rem;
    margin-top: 0.9rem;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text);
  }
  /* Narrow screens: the card takes the full width for its words and sits above the lotus, which
     rests below it across the lower right (the card's petal alignment is for wider screens). */
  @media (max-width: 899px) {
    .sia-rain {
      padding-bottom: calc(26vw + 2rem);
    }
    .sia-rain__scene {
      width: min(100% - 2.5rem, 34rem);
    }
    .sia-rain__card.glass-3d {
      align-items: center;
      padding: 2.5rem clamp(1.5rem, 6vw, 2.5rem) 2.75rem;
      text-align: center;
      min-height: 0 !important;
    }
  }
  /* The lotus on its lily pads: from the centre of the pond to the right edge, filling the lower
     right corner and overlapping the card. Softened a touch into the morning mist. */
  .sia-rain__lotus {
    position: absolute;
    left: 46%; /* 60% of the width, nudged right: the outer pads run just off the right edge */
    right: -6%;
    bottom: -2.5rem; /* down at the foot of the picture, the front pads running off its bottom edge */
    pointer-events: none;
  }
  /* Two copies of the same box: pads behind the card, flower in front, exactly in register. */
  .sia-rain__lotus--pads {
    z-index: 0;
  }
  .sia-rain__lotus--flower {
    z-index: 2;
  }
  .sia-rain__lotus-pads {
    position: relative;
    z-index: 2;
    filter: saturate(0.82) brightness(0.97) contrast(0.96);
  }
  .sia-rain__lotus :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sia-rain__lotus-flower {
    filter: saturate(0.82) brightness(0.97) contrast(0.96);
  }
  /* Its reflection on the still water: mirrored under the pads, faint and fading away. */
  .sia-rain__lotus-reflection {
    position: absolute;
    left: 0;
    top: 62%;
    z-index: 0;
    width: 100%;
    transform: scaleY(-0.55);
    transform-origin: 50% 0;
    opacity: 0.22;
    filter: blur(1.5px) saturate(0.7);
    mask-image: linear-gradient(to top, #000 0%, transparent 70%);
  }
  /* A soft shadow on the water where the pads rest. */
  .sia-rain__lotus-shadow {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 66%;
    height: 22%;
    z-index: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(14 22 16 / 0.4), transparent);
    filter: blur(6px);
  }

  /* ── Colour break band ── */
  .sia-scroll {
    /* Runs straight from the rain above into the treatments' sage below: no paper gaps. */
    background: #e3e8d9;
  }
  /* Stylised colour break: layered moss-to-sage ink washes that drip from the scroll. */
  .sia-colourbreak {
    display: block;
    width: 100%;
    height: clamp(3.5rem, 7vw, 6.5rem);
    margin-top: -1px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sia-colourbreak__back {
      animation: sia-wash 14s ease-in-out infinite alternate;
    }
  }
  @keyframes sia-wash {
    to {
      transform: translateX(-2%);
    }
  }

  /* ── Treatments: sage mist, tall photograph, 2×3 crystal price cards ── */
  .sia-treatments {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 85% 10%, rgb(255 255 255 / 0.45), transparent 70%),
      linear-gradient(180deg, #e3e8d9, #d6decb);
  }
  /* A soft photograph behind the menu, so the frosted cards have something to frost. */
  .sia-treatments__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
    mix-blend-mode: luminosity;
  }
  .sia-treatments__grid {
    display: grid;
    gap: 2rem;
    max-width: 82rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .sia-treatments__head {
    display: grid;
    gap: 0.75rem;
  }
  .sia-treatments__head p {
    color: var(--color-muted);
  }
  .sia-treatments__frame {
    position: relative;
    height: 100%;
    min-height: 22rem;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(39 50 42 / 0.6);
  }
  .sia-treatments__img {
    position: absolute;
    inset: 0;
    /* A gentle grade so every photo here sits in the site's soft, organic palette. */
    filter: saturate(0.82) sepia(0.08);
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 550ms var(--depth-ease),
      transform 1200ms var(--depth-ease);
  }
  .sia-treatments__img.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .sia-menu {
    display: grid;
    gap: 1rem;
  }
  .sia-menu__card {
    --glass-blur: 22px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.25rem;
    cursor: default;
    outline: none;
    box-shadow: 0 18px 36px -24px rgb(39 50 42 / 0.55);
    transition:
      transform 500ms var(--depth-ease),
      box-shadow 500ms var(--depth-ease),
      background-position 1.4s var(--depth-ease);
  }
  .sia-menu__card:hover,
  .sia-menu__card:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 28px 48px -24px rgb(39 50 42 / 0.6),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 35%, transparent),
      0 0 34px -8px color-mix(in oklab, var(--color-accent) 50%, transparent);
  }
  .sia-menu__card h3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .sia-menu__card h3 span {
    font-size: 0.95rem;
    color: var(--color-accent);
  }
  .sia-menu__card p {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .sia-menu__card dl {
    display: grid;
    gap: 0.2rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.8125rem;
  }
  .sia-menu__card dl div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .sia-menu__card dt {
    color: var(--color-subtle);
  }
  .sia-menu__card dd {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-accent-strong);
  }
  .sia-leader {
    flex: 1;
    border-bottom: 1px dotted color-mix(in oklab, var(--color-accent) 45%, transparent);
    transform: translateY(-0.3em);
  }
  @media (min-width: 640px) {
    .sia-menu {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sia-treatments__grid {
      grid-template-columns: 5fr 7fr;
      grid-template-rows: auto 1fr;
      gap: 3rem 3rem;
      padding: 8rem 3rem;
    }
    .sia-treatments__head {
      grid-column: 1 / -1;
      grid-template-columns: 5fr 7fr;
      align-items: end;
      gap: 3rem;
    }
    .sia-treatments__head p {
      padding-bottom: 0.6rem;
    }
    /* The photograph matches the height of the card grid exactly. */
    .sia-treatments__visual {
      align-self: stretch;
    }
  }

  /* ── Visit: step through the doorway ── */
  .sia-visit {
    --open: 0;
    position: relative;
    isolation: isolate;
  }
  .sia-visit__stage {
    position: sticky;
    top: var(--header-height);
    height: calc(100dvh - var(--header-height));
    overflow: hidden;
    z-index: 0;
    /* The wall's light: brighter toward the top left, falling off into shade. */
    background:
      radial-gradient(40% 55% at 50% 70%, rgb(195 209 166 / 0.16), transparent 70%),
      radial-gradient(90% 90% at 28% 12%, rgb(92 122 76 / 0.28), transparent 70%),
      radial-gradient(120% 100% at 80% 100%, rgb(8 12 6 / 0.45), transparent 65%);
  }
  .sia-visit {
    background: linear-gradient(180deg, #222d1c, #26321f 40%, #1f2a1a);
  }
  /* The arch: tall, centred, standing on the floor of the section, its path leading in.
     --open (0→1, from scroll) widens it until it fills the screen. */
  .sia-visit__door {
    --closed: calc(1 - var(--open));
    position: absolute;
    inset: 0;
    clip-path: inset(
      calc(var(--closed) * 24%) calc(var(--closed) * 32%) 0 calc(var(--closed) * 32%)
        round calc(var(--closed) * 50%) calc(var(--closed) * 50%) 0 0 / calc(var(--closed) * 30%)
        calc(var(--closed) * 30%) 0 0
    );
    will-change: clip-path;
  }
  /* The room photo is placed and sized by the doorway script (true scale behind the arch). */
  .sia-visit__door img {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }
  .sia-visit__door::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 28 18 / 0.5), rgb(20 28 18 / 0.15) 45%, rgb(20 28 18 / 0.55));
    opacity: var(--open);
  }
  /* The wall: moss plaster with a soft relief, lit from the top left. */
  .sia-visit__wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .sia-visit__edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .sia-visit__wall-foot {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgb(10 14 8 / 0.18) 55%, rgb(6 9 4 / 0.5));
  }
  /* The forecourt: a plane laid flat (turned to face up), placed and sized by the script. */
  .sia-visit__ground {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sia-visit__ground-plane {
    position: absolute;
    top: 0;
    background-repeat: repeat;
    transform-origin: 50% 0;
    transform: rotateX(90deg);
  }
  /* Light on the ground: softly brighter in front of the doorway, falling off to the sides. */
  .sia-visit__ground::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      /* Where the paving meets the wall: a dark joint, then the stones nearest the wall in
         the wall's shade, easing out over the first row or two. */
      linear-gradient(180deg, rgb(6 9 4 / 0.45) 0, rgb(6 9 4 / 0.4) 2px, rgb(6 9 4 / 0.32) 6%, rgb(6 9 4 / 0.12) 16%, transparent 30%),
      radial-gradient(60% 120% at 50% 0%, rgb(220 230 200 / 0.12), transparent 70%),
      linear-gradient(90deg, rgb(8 12 6 / 0.45), transparent 30%, transparent 70%, rgb(8 12 6 / 0.45));
  }
  /* Garden pieces, placed and scaled by the script; each rests on a soft contact shadow. */
  .sia-visit__garden {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sia-visit__prop {
    position: absolute;
    display: none;
  }
  .sia-visit__prop img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    /* Lit like the rest of the courtyard (softer, a touch darker than the studio photo). */
    filter: brightness(0.82) saturate(0.92);
  }
  .sia-visit__prop--mirror img {
    transform: scaleX(-1);
  }
  /* The plant's shadow, thrown back and to the right onto the wall by the upper-left light. */
  .sia-visit__prop img.sia-visit__prop-shadow {
    position: absolute;
    inset: 0;
    z-index: 0;
    height: 100%;
    filter: none;
    opacity: 0.55;
    transform: translate(22%, -0.6%);
    /* only the part falling on the wall: the paving below has the plant's own ground shadow */
    clip-path: inset(0 0 var(--wallcut, 0%) 0);
  }
  .sia-visit__prop--mirror img.sia-visit__prop-shadow {
    transform: scaleX(-1) translate(-22%, -0.6%);
  }
  /* Grounding: a tight dark contact right where the foot meets the stone (centred on the
     foot's bottom edge, so it runs under and just behind it), and a soft shadow cast away from
     the light, to the right across the paving. */
  .sia-visit__prop::before,
  .sia-visit__prop::after {
    content: '';
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  .sia-visit__prop::before {
    left: calc(var(--sx, 50%) - var(--sw, 60%) / 2);
    width: var(--sw, 60%);
    bottom: -0.9%;
    height: 2.2%;
    background: radial-gradient(closest-side, rgb(4 6 3 / 0.95), rgb(4 6 3 / 0.6) 60%, transparent);
  }
  /* The pot's shadow on the paving: from its base back and to the right, to the foot of the
     wall, where the shadow on the wall (.sia-visit__prop-shadow) carries on up. The script sets
     the lean (--gskew) so it lands exactly under the wall shadow. */
  .sia-visit__prop::after {
    left: calc(var(--sx, 50%) - 21%);
    width: 42%;
    bottom: 0;
    height: var(--wallcut, 10%);
    background: linear-gradient(0deg, rgb(4 7 3 / 0.55), rgb(4 7 3 / 0.4) 70%, rgb(4 7 3 / 0.3));
    border-radius: 30% 30% 50% 50% / 25% 25% 45% 45%;
    transform-origin: 50% 100%;
    transform: skewX(var(--gskew, -30deg));
    filter: blur(var(--gblur, 4px));
  }
  /* The two door leaves. Each fills the stage (its drawing uses the stage's own coordinates)
     and turns about its hinge; the script sets the angle, hinge and eye point. */
  .sia-visit__doors {
    position: absolute;
    inset: 0;
    perspective: 1600px;
    pointer-events: none;
  }
  .sia-visit__leaf {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* The leaf's thickness, seen along its meeting edge as it swings: a face turned back from
     the edge into the doorway. */
  /* The back face of a leaf, set back by its thickness (placed by the script). */
  .sia-visit__leaf-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* One short face of the top edge's thickness (placed and shaded by the script). */
  .sia-visit__leaf-rim {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    transform-origin: 0 0;
    /* Arris lines along the top edge's front and back, continuing the box round the crown. */
    border-top: 1px solid rgb(14 20 10 / 0.7);
    border-bottom: 1px solid rgb(14 20 10 / 0.7);
  }
  .sia-visit__leaf-edge {
    position: absolute;
    box-sizing: border-box;
    /* Arris lines boxing the edge in: down its front and back, and turning 90° across the top
       and bottom to join the front sheet to the back one. */
    border: 1px solid rgb(14 20 10 / 0.75);
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    /* Grain along the edge's length, light on the front arris, shade toward the back sheet. */
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 3px),
      linear-gradient(90deg, rgb(240 220 190 / 0.12), transparent 30%, rgb(0 0 0 / 0.4)),
