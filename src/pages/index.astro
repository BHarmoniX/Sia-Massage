---
// SIA MASSAGE: one-page site. Prices, treatments and copy marked MOCK are placeholders.
// Photography: Unsplash (free licence); artwork: The Met Open Access (public domain).
// Full credits in docs/CREDITS.md.
import ScrollCue from '../components/layout/ScrollCue.astro';
import Section from '../components/layout/Section.astro';
import AmbientVideo from '../components/media/AmbientVideo.astro';
import Img from '../components/media/Img.astro';
import InkLandscape from '../client/InkLandscape.astro';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import { formatAuPhone, site, telHref } from '../config/site';

import bambooLight from '../client/photos/bamboo-light.jpg';
import teaTable from '../client/photos/tea-table.jpg';
import towelCandles from '../client/photos/towel-candles.jpg';
import oilMassage from '../client/photos/oil-massage.jpg';
import bambooPath from '../client/photos/bamboo-path.jpg';
import bambooBasin from '../client/photos/bamboo-basin.jpg';
import mossWaterfall from '../client/photos/moss-waterfall.jpg';
import mossRiver from '../client/photos/moss-river.jpg';
import rainPoster from '../client/photos/rain-leaves-poster.jpg';
import autumnScroll from '../client/art/streams-mountains-autumn-mist.jpg';

const { business } = site;
const phone = business.phone!;
const address = business.address!;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${address.street}, ${address.suburb} ${address.state} ${address.postcode}`,
)}`;

// Pictures the treatment menu crossfades between as you move through it.
// Pictures the menu crossfades between as you move through it.
const treatmentImages = {
  oil: { src: oilMassage, alt: 'Therapist pouring warm oil before a relaxation massage' },
  calm: { src: towelCandles, alt: 'Rolled towel, candles and a reed diffuser in soft light' },
  tea: { src: teaTable, alt: 'Tea set laid out on a long wooden table' },
  water: { src: bambooBasin, alt: 'Water running from a bamboo spout into a stone basin' },
} as const;

// Sia offers relaxation massage only. MOCK: options, durations and prices.
const treatments = [
  {
    name: 'A quiet pause',
    zh: '片刻',
    image: 'oil',
    text: 'Back, neck and shoulders. Thirty minutes to set the day down.',
    prices: [['30 min', '$55']],
  },
  {
    name: 'Classic relaxation',
    zh: '放松',
    image: 'oil',
    text: 'Full body, long flowing strokes with warm oil. Our most loved hour.',
    prices: [['60 min', '$90']],
  },
  {
    name: 'Deep relaxation',
    zh: '静养',
    image: 'calm',
    text: 'Unhurried, full body, with time to drift somewhere quiet.',
    prices: [['90 min', '$130']],
  },
  {
    name: 'The Sia ritual',
    zh: '仪式',
    image: 'tea',
    text: 'Our longest: full body, scalp and feet, finished with warm tea.',
    prices: [['120 min', '$170']],
  },
  {
    name: 'Together',
    zh: '同享',
    image: 'calm',
    text: 'Side-by-side relaxation massage for two, in the same quiet room.',
    prices: [['60 min', '$180'], ['90 min', '$260']],
  },
  {
    name: 'Gift of calm',
    zh: '礼物',
    image: 'water',
    text: 'A voucher for any treatment, beautifully presented.',
    prices: [['From', '$55']],
  },
] as const;

const journey = [
  { n: '一', title: 'Arrive', text: 'Leave the day at the door. Warm tea, a quiet welcome, a few words about how you feel.' },
  { n: '二', title: 'Breathe', text: 'Soft light, clean linen, the scent of camphor. Your therapist tunes the pressure to you.' },
  { n: '三', title: 'Release', text: 'Skilled hands follow tension to its source, guided by traditional technique.' },
  { n: '四', title: 'Restore', text: 'Rise slowly. Sit a moment. Leave lighter than you came.' },
];

// MOCK: answers to confirm with the owner
const faqs = [
  { q: 'Do I need to book ahead?', a: 'Booking is best, especially evenings and weekends. Walk-ins are welcome whenever a therapist is free.' },
  { q: 'What should I wear?', a: 'Come as you are. You undress only to your comfort, and stay covered with fresh towels throughout.' },
  { q: 'How early should I arrive?', a: 'Five to ten minutes before your time, so you can settle in and tell us about any health concerns.' },
  { q: 'Do you offer remedial or deep tissue massage?', a: 'We specialise in relaxation massage only, so every visit is about rest. Firmer pressure is always welcome on request.' },
  { q: 'Is massage safe during pregnancy?', a: 'Please let us know when booking and we will suggest the treatments that suit you.' },
];
---

<OnePageLayout>
  <!-- ───────────── Hero: an invitation, a window onto mountains ───────────── -->
  <section class="sia-hero" aria-labelledby="hero-title">
    <div class="sia-hero__bamboo" aria-hidden="true">
      <Img src={bambooLight} alt="" sizes="50vw" priority class="h-full w-full object-cover" />
    </div>

    <div class="sia-hero__grid">
      <div class="sia-hero__copy" data-reveal>
        <span class="sia-hero__seal font-han" lang="zh-Hans" aria-hidden="true">静</span>
        <h1 id="hero-title" class="sia-display">
          Sia<br /><em>Massage</em>
        </h1>
        <p class="sia-hero__lede">
          Traditional Asian relaxation massage in a quiet room, with unhurried hands. An hour that belongs only to you.
        </p>
        <div class="sia-hero__actions">
          <a href="#contact" class="btn-3d">Book a treatment</a>
          <a href="#treatments" class="btn-3d btn-3d--ghost">See the menu</a>
        </div>
        <p class="sia-hero__hours">{business.hours}</p>
      </div>

      <div class="sia-hero__gate-wrap" data-reveal>
        <div class="sia-moongate card-3d breathe" data-tilt>
          <InkLandscape class="absolute inset-0 h-full w-full" />
        </div>
        <span class="sia-hero__rest font-han" aria-hidden="true">息</span>
      </div>
    </div>

    <ScrollCue href="#philosophy" label="Scroll to our philosophy" />
  </section>

  <!-- ───────────── Philosophy: photograph and crystal card, side by side ───────────── -->
  <Section id="philosophy" labelledby="philosophy-title" class="sia-philosophy sia-tone-moss">
    <div class="sia-philosophy__grid">
      <figure class="sia-philosophy__tea img-reveal">
        <div class="scroll-drift h-full">
          <Img src={teaTable} alt="Tea set laid out on a long wooden table in soft evening light" sizes="(min-width: 1024px) 58vw, 100vw" class="h-full w-full object-cover" />
        </div>
      </figure>

      <div class="sia-philosophy__card glass-3d crystal" data-glow data-reveal>
        <p class="sia-kicker font-han" lang="zh-Hans">静心 <span>a quiet heart</span></p>
        <h2 id="philosophy-title" class="sia-heading">A quiet place to return to yourself</h2>
        <p>
          At Sia, massage is not a rush between appointments. Drawing on traditional Asian bodywork,
          every treatment is slow and attentive, so the body can soften and the mind can rest.
        </p>
        <p>Clean linen, low light, a cup of tea. Nothing to do but breathe.</p>
        <blockquote>When the body is at ease, the heart follows.</blockquote>
      </div>
    </div>
  </Section>

  <!-- ───────────── Rain: a breathing pause ───────────── -->
  <section class="sia-rain" aria-label="Rain falling on green leaves">
    <AmbientVideo src="/video/sia-rain-leaves.mp4" poster={rainPoster} class="sia-rain__video" />
    <div class="sia-rain__veil" aria-hidden="true"></div>
    <figure class="sia-rain__card glass-3d crystal float" data-glow data-reveal>
      <span class="font-han" lang="zh-Hans" aria-hidden="true">雨</span>
      <blockquote>Listen to the rain.<br />Let the water carry the day away.</blockquote>
    </figure>
  </section>

  <!-- ───────────── A handscroll unrolls as you scroll ───────────── -->
  <section class="sia-scroll" aria-label="Streams and Mountains in Autumn Mist, a Chinese handscroll">
    <div class="sia-scroll__frame scroll-pan-frame">
      <Img src={autumnScroll} alt="Ink landscape of misty mountains, willows and a fisherman’s boat, painted on paper" sizes="200vw" widths={[1200, 2000]} class="scroll-pan sia-scroll__img" />
    </div>
    <svg class="sia-colourbreak" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sia-break-a" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#2f3d2a" />
          <stop offset="0.45" stop-color="#5c7a4c" />
          <stop offset="1" stop-color="#b9c8a4" />
        </linearGradient>
        <linearGradient id="sia-break-b" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#b9c8a4" />
          <stop offset="0.6" stop-color="#dfe5d4" />
          <stop offset="1" stop-color="#5c7a4c" />
        </linearGradient>
      </defs>
      <path class="sia-colourbreak__back" fill="url(#sia-break-b)" opacity="0.7"
        d="M0 0 H1440 V58 C1300 92 1160 34 1010 62 C860 90 720 40 560 66 C400 92 250 48 120 70 C70 78 30 76 0 72 Z" />
      <path class="sia-colourbreak__front" fill="url(#sia-break-a)"
        d="M0 0 H1440 V30 C1310 60 1180 14 1030 38 C880 62 740 18 590 42 C430 68 290 26 150 46 C90 54 40 52 0 48 Z" />
    </svg>
  </section>

  <!-- ───────────── Treatments: menu with a living picture ───────────── -->
  <Section id="treatments" labelledby="treatments-title" class="sia-treatments">
    <div class="sia-treatments__backdrop" aria-hidden="true">
      <div class="scroll-drift h-full">
        <Img src={mossRiver} alt="" sizes="100vw" class="h-full w-full object-cover" />
      </div>
    </div>
    <div class="sia-treatments__grid">
      <header class="sia-treatments__head" data-reveal>
        <h2 id="treatments-title" class="sia-heading">Relaxation massage</h2>
        <p>One treatment, perfected. Choose your time; we tailor the pressure to you on the day.<br />Prices in AUD, GST inclusive.</p>
      </header>

      <div class="sia-treatments__visual" data-reveal>
        <div class="sia-treatments__frame" data-treatment-frame>
          {
            Object.entries(treatmentImages).map(([key, img], i) => (
              <div class:list={['sia-treatments__img', { 'is-active': i === 0 }]} data-treatment-img={key}>
                <Img src={img.src} alt={img.alt} sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>

      <ul class="sia-menu" role="list">
        {
          treatments.map((t) => (
            <li class="sia-menu__card sia-moss-glass glass-3d crystal float" data-treatment={t.image} tabindex="0" data-glow data-reveal>
              <h3>
                {t.name}
                <span class="font-han" lang="zh-Hans">{t.zh}</span>
              </h3>
              <p>{t.text}</p>
              <dl>
                {t.prices.map(([time, price]) => (
                  <div>
                    <dt>{time}</dt>
                    <span class="sia-leader" aria-hidden="true" />
                    <dd>{price}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ───────────── Your visit: a doorway you step through ─────────────
       A tall arch stands on the page with the bamboo path running through it. Scrolling
       carries you into it: the arch widens until you stand on the path, then the four
       moments rise over the scene. -->
  <Section id="visit" labelledby="visit-title" class="sia-visit sia-tone-moss" data-doorway>
    <div class="sia-visit__stage" aria-hidden="true">
      <div class="sia-visit__door">
        <Img src={bambooPath} alt="" sizes="100vw" class="h-full w-full object-cover" />
      </div>
      <!-- A gateway: the outline of the client's stone arch (crown mirrored exactly, posts
           extended to doorway height), traced by a gold line and an even fine line. No sill: the
           photo fades into the moss at the foot, while the posts end squarely in the ground. Either side, carved and gilded into the wall, a couplet read right
           to left: 身体放松 · 心自宁静, "a relaxed body creates a calm mind". The doorway script
           draws everything from one geometry. -->
      <div class="sia-visit__glass" data-glass></div>
      <svg class="sia-visit__frame" data-frame>
        <path class="sia-arch__line" data-line="0" />
        <path class="sia-arch__line sia-arch__line--seam" data-line="11" />
        <path class="sia-arch__line sia-arch__line--outer" data-line="44" />
        <path class="sia-arch__line sia-arch__cap" data-caps />
        <defs>
          <linearGradient id="sia-foot-gold" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#e3d3a2" />
            <stop offset="0.55" stop-color="#c9b27a" />
            <stop offset="1" stop-color="#9c8551" />
          </linearGradient>
        </defs>
        <!-- Gold feet: the arch's tip curve, turned over, flaring each leg into the ground. -->
        <path class="sia-arch__feet" data-feet />
        <!-- Braces: the arch's tip curve, right way up, from each outer foot to the inner line. -->
        <path class="sia-arch__line sia-arch__brace" data-braces />
        <g class="sia-carving" data-couplet="right" lang="zh-Hans" role="img" aria-label="身体放松: a relaxed body">
          <text class="sia-carving__cut" x="0" y="0"><tspan x="0" y="0.0em">身</tspan><tspan x="0" y="1.3em">体</tspan><tspan x="0" y="2.6em">放</tspan><tspan x="0" y="3.9em">松</tspan></text>
          <text class="sia-carving__gilt" x="0" y="0"><tspan x="0" y="0.0em">身</tspan><tspan x="0" y="1.3em">体</tspan><tspan x="0" y="2.6em">放</tspan><tspan x="0" y="3.9em">松</tspan></text>
        </g>
        <g class="sia-carving" data-couplet="left" lang="zh-Hans" role="img" aria-label="心自宁静: creates a calm mind">
          <text class="sia-carving__cut" x="0" y="0"><tspan x="0" y="0.0em">心</tspan><tspan x="0" y="1.3em">自</tspan><tspan x="0" y="2.6em">宁</tspan><tspan x="0" y="3.9em">静</tspan></text>
          <text class="sia-carving__gilt" x="0" y="0"><tspan x="0" y="0.0em">心</tspan><tspan x="0" y="1.3em">自</tspan><tspan x="0" y="2.6em">宁</tspan><tspan x="0" y="3.9em">静</tspan></text>
        </g>
      </svg>
      <p class="sia-visit__threshold">
        <span class="font-han" lang="zh-Hans">入</span>
        <span class="sia-visit__threshold-text">Step inside</span>
      </p>
    </div>
    <div class="sia-visit__inner">
      <h2 id="visit-title" class="sia-heading sia-heading--light" data-reveal>Four quiet moments</h2>
      <ol class="sia-visit__cards" role="list">
        {
          journey.map((j) => (
            <li class="sia-visit__card notch-host float" data-tilt data-reveal>
              <div class="sia-visit__panel sia-moss-glass glass-3d crystal notch" data-glow>
                <h3>{j.title}</h3>
                <p>{j.text}</p>
              </div>
              <span class="notch-piece glass-3d crystal font-han" aria-hidden="true" lang="zh-Hans">
                {j.n}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ───────────── Questions ───────────── -->
  <Section id="faq" labelledby="faq-title" class="sia-faq">
    <div class="sia-faq__grid">
      <figure class="sia-faq__image img-reveal">
        <Img src={bambooBasin} alt="Water running from a bamboo spout into a mossy stone basin" sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" />
      </figure>
      <div>
        <h2 id="faq-title" class="sia-heading" data-reveal>Before you arrive</h2>
        <div class="sia-faq__list" data-reveal>
          {
            faqs.map((f) => (
              <details class="sia-faq__item">
                <summary>
                  {f.q}
                  <span class="sia-faq__mark" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- ───────────── Contact: a jigsaw booking card on moss and water ───────────── -->
  <Section id="contact" labelledby="contact-title" class="sia-contact">
    <div class="sia-contact__bg" aria-hidden="true">
      <Img src={mossWaterfall} alt="" sizes="100vw" class="h-full w-full object-cover sia-contact__falls" />
    </div>
    <div class="sia-contact__inner">
      <div class="jigsaw notch-host sia-contact__card" data-reveal>
        <span class="notch-piece glass-3d crystal font-han sia-contact__seal" aria-hidden="true" lang="zh-Hans">约</span>
        <div class="jigsaw__main glass-3d notch" data-glow>
          <h2 id="contact-title" class="sia-heading">Your hour of calm awaits</h2>
          <dl class="sia-contact__details">
            <div>
              <dt>Find us</dt>
              <dd>
                {address.street}<br />{`${address.suburb} ${address.state} ${address.postcode}`}
              </dd>
            </div>
            <div>
              <dt>Open</dt>
              <dd>{business.hours}</dd>
            </div>
            <div>
              <dt>Write</dt>
              <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            </div>
          </dl>
        </div>
        <div class="jigsaw__piece glass-3d crystal">
          <a href={telHref(phone)} class="sia-contact__phone">{formatAuPhone(phone)}</a>
          <span class="sia-contact__actions">
            <a href={telHref(phone)} class="btn-3d">Call to book</a>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-3d btn-3d--ghost">Directions</a>
          </span>
        </div>
      </div>
    </div>
  </Section>
</OnePageLayout>

<style is:global>
  .font-han {
    font-family: var(--font-han);
  }
  /* Sia's signature card finish: moss glass (translucent dark-moss frosted crystal). */
  .sia-moss-glass,
  .sia-moss-glass.glass-3d {
    --glass-tint: rgb(47 61 42 / 0.82);
    --color-text: #f3efe4;
    --color-muted: #d6dbc9;
    --color-subtle: #b3bca4;
    --color-accent: #c3d1a6;
    --color-accent-strong: #dbe6c2;
    color: var(--color-text);
  }
  .sia-moss-glass.crystal {
    box-shadow: 0 24px 44px -24px rgb(20 28 18 / 0.75);
  }
  /* Deep moss sections: the same components, re-toned by tokens. */
  .sia-tone-moss {
    --color-bg: #26321f;
    --color-surface: #33422c;
    --color-border: rgb(255 255 255 / 0.14);
    --color-text: #f3efe4;
    --color-muted: #d3d8c6;
    --color-subtle: #a9b39a;
    --color-accent: #c3d1a6;
    --color-accent-strong: #dbe6c2;
    --color-on-accent: #1f2a1b;
    background:
      radial-gradient(70% 60% at 20% 0%, rgb(195 209 166 / 0.10), transparent 70%),
      linear-gradient(180deg, #2b3824, #222d1c);
    color: var(--color-text);
  }
  .sia-display {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
  }
  .sia-display em {
    font-style: italic;
    color: var(--color-accent-strong);
  }
  .sia-heading {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1.05;
  }
  .sia-heading--light {
    color: #f6f3ec;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .sia-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  .sia-kicker span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-subtle);
  }

  /* ── Hero ── */
  .sia-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100dvh - var(--header-height));
  }
  /* The scroll cue only makes sense when the hero fits one screen (wide layouts). */
  .sia-hero .scroll-cue {
    display: none;
  }
  @media (min-width: 1024px) {
    .sia-hero .scroll-cue {
      display: block;
    }
  }
  .sia-hero__bamboo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60vw, 56rem);
    opacity: 0.55;
    mask-image: linear-gradient(to left, black 30%, transparent 95%);
    -webkit-mask-image: linear-gradient(to left, black 30%, transparent 95%);
    pointer-events: none;
  }
  .sia-hero__grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
    max-width: 82rem;
    min-height: inherit;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  @media (min-width: 1024px) {
    .sia-hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      padding-inline: 3rem;
    }
  }
  .sia-hero__copy {
    position: relative;
    padding-left: clamp(0rem, 4vw, 3.5rem);
  }
  .sia-hero__seal {
    position: absolute;
    left: 0;
    top: 0.4rem;
    display: none;
    font-size: 1.6rem;
    color: var(--color-accent);
    writing-mode: vertical-rl;
  }
  @media (min-width: 640px) {
    .sia-hero__seal {
      display: block;
    }
  }
  .sia-hero__lede {
    max-width: 28rem;
    margin-top: 2rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  .sia-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }
  .sia-hero__hours {
    margin-top: 1.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
  }
  .sia-hero__gate-wrap {
    position: relative;
    width: min(100%, 34rem);
    margin-inline: auto;
  }
  .sia-moongate {
    position: relative;
    aspect-ratio: 1;
    border-radius: 9999px;
    overflow: hidden;
    --depth-tilt: 7deg;
    box-shadow:
      0 0 0 1px var(--color-border),
      0 0 0 14px color-mix(in oklab, var(--color-bg) 85%, transparent),
      0 0 0 15px color-mix(in oklab, var(--color-accent) 35%, transparent),
      0 50px 90px -40px color-mix(in oklab, var(--color-text) 45%, transparent);
  }
  .sia-hero__rest {
    position: absolute;
    right: -0.5rem;
    bottom: 1.5rem;
    font-size: clamp(6rem, 12vw, 9rem);
    line-height: 1;
    color: color-mix(in oklab, var(--color-accent) 16%, transparent);
    pointer-events: none;
    user-select: none;
  }

