  /* ── The opening and the story, on the light water ──
     One frame for the whole section: on wide screens everything lines up between grid lines 2
     and 12 (the content runs from column 2 to column 11), and each block alternates sides of it. */
  .sia-phil {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin: 0 auto;
    /* begins where the reflected hills fade out */
    padding: calc(var(--sia-land) * 0.62) 1.5rem 1.5rem;
  }
  /* the opening: one centred group (character, heading, introduction) */
  .sia-phil__intro {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .sia-phil__head {
    display: grid;
    justify-items: center;
  }
  .sia-phil .sia-kicker {
    justify-content: center;
    color: #5c7a4c;
  }
  .sia-phil__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.6rem, 5.2vw, 4.4rem);
    line-height: 1.02;
    color: #27322a;
  }
  .sia-phil__lede {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    color: #3f4c3d;
    font-size: 1.05rem;
    line-height: 1.75;
    transition-delay: 0.18s; /* the introduction follows the heading */
  }
  .sia-phil__lead {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.35;
    color: #27322a;
  }
  /* small spaced capitals naming each part: Our story, The place … */
  .sia-phil__label {
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #3f5634; /* deep moss: readable at this small size (WCAG AA) */
  }
  /* the team photo: the therapist in front, her colleagues behind */
  .sia-step__inset .sia-phil__team {
    object-position: 55% 40%;
  }
  @media (min-width: 1024px) {
    .sia-phil {
      gap: clamp(3.5rem, 9vh, 5rem);
      padding: calc(var(--sia-land) * 0.62) 3rem 0;
    }
  }

  /* ── The three pillars: the water deepening from the light to Sia's dark moss ── */
  .sia-pillars {
    --q: 1; /* how far the scene has risen into view, 0 → 1 (set by the script; 1 without it) */
    /* the mountain band: where the ridges start, how tall they are; the cards begin below it */
    --ridge-top: clamp(1.75rem, 4vw, 3rem); /* a little open sky above the ridges */
    --ridge-h: clamp(6rem, 19vw, 14rem);
    --ridge-foot: calc(var(--ridge-top) + var(--ridge-h));
    position: relative;
    z-index: 1;
  }
  .sia-pillars .sia-story {
    z-index: 2;
  }
  /* The dusk scene: begins right below the story card, its sky the same pale sage as the light
     above so the two meet without an edge; the mountains stand clear, the cards below them. */
  .sia-dusk {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, transparent 0, transparent calc(var(--ridge-foot) * 0.5), #2b3824 var(--ridge-foot), #26321f 60%, #222d1c);
  }
  .sia-dusk__sky {
    position: absolute;
    inset: 0 0 auto;
    height: var(--ridge-foot);
    background: linear-gradient(180deg, rgb(230 235 220 / 0) 0%, #e3e9d8 18%, #d3dcc4 45%, #8fa07c 75%, #2b3824 100%);
  }
  /* the roundel's mountains, pale and far to dark and near, rising into place as you arrive */
  .sia-dusk__ridge {
    position: absolute;
    left: -2%;
    width: 104%;
    top: var(--ridge-top);
    height: var(--ridge-h);
  }
  .sia-dusk__ridge--far {
    transform: translateY(calc((1 - var(--q)) * 2.5rem));
  }
  .sia-dusk__ridge--mid {
    transform: translateY(calc((1 - var(--q)) * 4rem));
  }
  .sia-dusk__ridge--near {
    transform: translateY(calc((1 - var(--q)) * 6rem));
  }
  /* shade gathering at the foot of the mountains, so they melt into the moss with no hard edge */
  .sia-dusk::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--ridge-foot) - 4.5rem);
    height: 6rem;
    background: linear-gradient(180deg, rgb(43 56 36 / 0), rgb(43 56 36 / 0.85) 60%, #2b3824 75%);
    pointer-events: none;
  }
  /* the lantern's glow, blooming around the studio at the foot of the story */
  .sia-dusk__glow {
    position: absolute;
    left: 38%;
    top: 78%;
    width: 110vmax;
    height: 110vmax;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 196 122 / 0.3), rgb(236 168 96 / 0.12) 38%, rgb(236 168 96 / 0.04) 62%, transparent 75%);
    mix-blend-mode: screen;
    opacity: var(--q);
    transform: translate(-50%, -50%) scale(calc(0.55 + 0.45 * var(--q)));
  }
  /* evening mist rising off the moss at the foot of the scene */
  .sia-dusk__mist {
    position: absolute;
    inset: auto -10% 0;
    height: 30%;
    background:
      radial-gradient(40% 55% at 15% 100%, rgb(214 222 202 / 0.28), transparent 70%),
      radial-gradient(45% 60% at 55% 100%, rgb(214 222 202 / 0.24), transparent 70%),
      radial-gradient(40% 50% at 90% 100%, rgb(214 222 202 / 0.26), transparent 70%);
    filter: blur(14px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sia-dusk__mist {
      animation: sia-mist-drift 22s ease-in-out infinite alternate;
    }
  }
  @keyframes sia-mist-drift {
    to { transform: translateX(4%); }
  }
  .sia-step__cta {
    margin-top: 1.75rem;
  }
  /* Wide screens, under the mountains: three separate cards of the same size, one under another
     across the full width, each with its photo on the left and the words beside it. */
  @media (min-width: 1024px) {
    .sia-pillars .sia-story {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
      row-gap: clamp(1.5rem, 3.5vh, 2.25rem);
    }
    .sia-pillars .sia-story {
      max-width: 90rem; /* the cards fill more of the screen */
    }
    .sia-pillars .sia-step {
      display: block;
      grid-column: 1 / -1;
    }
    .sia-pillars .sia-step .sia-step__panel.glass-3d {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }
    .sia-pillars .sia-step .sia-step__inset {
      order: -1; /* the photo always on the left */
      position: relative;
      height: auto; /* fills the card's full height */
      min-height: clamp(15rem, 38vh, 19rem);
    }
    /* the photo fills its slot without its own shape setting the card's height */
    .sia-pillars .sia-step .sia-step__inset picture,
    .sia-pillars .sia-step .sia-step__inset img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .sia-pillars .sia-step .sia-step__text {
      align-self: center;
      padding: 2rem clamp(2rem, 3.5vw, 3rem);
    }
  }

  .sia-story {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin: 0 auto;
    /* starts below the mountain band */
    padding: calc(var(--ridge-foot) + 2rem) 1rem 6rem;
  }
  .sia-step {
    display: grid;
  }
  /* Phones: "Our story" closer to the opening above it, and the three cards closer together. */
  @media (max-width: 479.98px) {
    .sia-phil {
      gap: 1.75rem;
    }
    .sia-story {
      gap: 0.75rem;
    }
  }

  /* "Our story" in the contact card's glass: frosted ivory at 62%, white edge, pointer glow */
  .sia-step--story .sia-step__panel.glass-3d {
    --glass-tint: #f6f3ec;
    background: color-mix(in oklab, var(--glass-tint) 62%, transparent);
    border: 1px solid color-mix(in oklab, white 45%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 18%, transparent),
      0 24px 48px -28px color-mix(in oklab, var(--color-text) 45%, transparent);
  }
  /* The three cards under the mountains in frosted sage glass (like the contact card over the
     pond): the dusk and its fireflies glow faintly through, the words stay dark moss. */
  .sia-pillars .sia-step__panel.glass-3d {
    --glass-tint: #e4ead9;
    --glass-blur: 20px;
    background: color-mix(in oklab, var(--glass-tint) 78%, transparent);
    border: 1px solid rgb(255 255 255 / 0.35);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 24px 48px -26px rgb(0 0 0 / 0.55);
  }
  .sia-pillars .sia-step__panel p {
    color: #33402f;
  }
  /* Cards: rice paper, growing as the story builds. */
  .sia-step .sia-step__card {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 22px 28px rgb(20 28 16 / 0.35));
  }

  .sia-step__panel.glass-3d {
    --glass-tint: #f7f2e6;
    background: color-mix(in oklab, var(--glass-tint) 90%, transparent);
    --color-text: #27322a;
    --color-muted: #3f4c3d;
    --color-subtle: #55624f;
    --color-accent: #5c7a4c;
    color: var(--color-text);
    display: grid;
    gap: 0.4rem;
    padding: 0.7rem;
    border-radius: 2.6rem;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7);
  }
  .sia-step--dark .sia-step__panel.glass-3d {
    border-radius: 3.2rem;
  }
  .sia-step__text {
    padding: 1.9rem 1.6rem 1.6rem 1.9rem;
  }
  .sia-step--mid .sia-step__text {
    padding: 1.9rem 1.9rem 1.6rem 1.6rem;
  }
  .sia-step__text > * + * {
    margin-top: 1rem;
  }
  .sia-step__text p {
    color: var(--color-muted);
  }
  .sia-step__text .sia-kicker {
    font-size: 1.25rem;
  }
  .sia-step__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    line-height: 1.08;
  }
  .sia-step__text blockquote {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid color-mix(in oklab, var(--color-accent) 50%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
  }

  /* the photo held inside a card, inset within the paper with softly rounded corners */
  .sia-step__inset {
    order: -1; /* small screens: photo on top */
    height: 15rem;
    border-radius: 1.95rem;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(60 70 50 / 0.12);
  }
  .sia-step--mid .sia-step__inset {
    height: 17rem;
  }
  .sia-step__inset picture {
    display: block;
    height: 100%;
  }

  .sia-step__inset .sia-step__shop {
    object-position: 58% 50%;
  }
  .sia-step--story .sia-step__inset {
    height: 17rem;
  }
  .sia-step--dark .sia-step__inset {
    height: 19rem;
  }
  /* photo on the left: the text padding mirrors */
  .sia-step--story .sia-step__text {
    padding: 1.9rem 1.9rem 1.6rem 1.6rem;
  }

  /* Wide screens: a staggered descent, each step larger than the last. */
  @media (min-width: 1024px) {
    .sia-story {
      gap: clamp(3rem, 9vh, 5rem);
      padding: calc(var(--ridge-foot) + clamp(2rem, 5vh, 3.5rem)) 3rem clamp(6rem, 14vh, 9rem);
    }
    .sia-step {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .sia-step__card {
      grid-row: 1;
    }
    .sia-step__inset {
      order: 0;
      height: auto;
    }
    /* one: a small card, photo at its right */
    .sia-step--light .sia-step__card {
      grid-column: 2 / span 7;
    }
    .sia-step--light .sia-step__panel.glass-3d {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    }
    .sia-step--light .sia-step__inset {
      min-height: 20rem;
    }
    /* two: a larger card, stepped to the right, photo at its left */
    .sia-step--mid .sia-step__card {
      grid-column: 5 / span 7;
    }
    .sia-step--mid .sia-step__panel.glass-3d {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
    .sia-step--mid .sia-step__inset {
      min-height: 24rem;
    }
    /* the story: a full-width card, the team photo at its left */
    .sia-step--story .sia-step__card {
      grid-column: 2 / span 10;
    }
    .sia-step--story .sia-step__panel.glass-3d {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .sia-step--story .sia-step__inset {
      height: auto;
      min-height: 26rem;
    }
    /* three: the studio, the largest, a full-width card with the photo at its right */
    .sia-step--dark .sia-step__card {
      grid-column: 2 / span 10;
    }
    .sia-step--dark .sia-step__panel.glass-3d {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
    .sia-step--dark .sia-step__inset {
      height: auto;
      min-height: min(70vh, 34rem);
    }
    .sia-step--dark .sia-step__text {
      padding: 2.6rem 2.4rem 2.3rem 2.8rem;
    }
    .sia-step--dark .sia-step__title {
      font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    }
  }

  /* ── The lotus (contact): pads behind the card, the bloom in front ── */
  /* The lotus on its lily pads: from the centre of the pond to the right edge, filling the lower
     right corner and overlapping the card. Softened a touch into the morning mist. */
  .sia-lotus {
    position: absolute;
    left: 62%; /* 44% of the width, nudged right: the outer pads run just off the right edge */
    right: -6%;
    bottom: -2.5rem; /* down at the foot of the picture, the front pads running off its bottom edge */
    pointer-events: none;
  }
  /* Two copies of the same box: pads behind the card, flower in front, exactly in register. */
  .sia-lotus--pads {
    z-index: 0;
  }
  .sia-lotus--flower {
    z-index: 2;
  }
  .sia-lotus-pads {
    position: relative;
    z-index: 2;
    filter: saturate(0.82) brightness(0.97) contrast(0.96);
  }
  .sia-lotus img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sia-lotus-flower {
    filter: saturate(0.82) brightness(0.97) contrast(0.96);
  }
  /* Its reflection on the still water: mirrored under the pads, faint and fading away. */
  .sia-lotus-reflection {
    position: absolute;
    left: 0;
    top: 62%;
    z-index: 0;
    width: 100%;
    transform: scaleY(-0.55);
    transform-origin: 50% 0;
    opacity: 0.22;
    filter: blur(1.5px) saturate(0.7);
    mask-image: linear-gradient(to top, #000 0%, transparent 70%);
  }
  /* A soft shadow on the water where the pads rest. */
  .sia-lotus-shadow {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 66%;
    height: 22%;
    z-index: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(14 22 16 / 0.4), transparent);
    filter: blur(6px);
  }

  /* ── Treatments: sage mist, tall photograph, 2×3 crystal price cards ── */
  .sia-treatments {
    position: relative;
    /* tucked 1px up over the philosophy, so no hairline of the page shows between them */
    z-index: 1;
    margin-top: -1px;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 85% 10%, rgb(255 255 255 / 0.45), transparent 70%),
      linear-gradient(180deg, #e3e8d9, #d6decb);
  }
  /* A soft photograph behind the menu, so the frosted cards have something to frost. */
  .sia-treatments__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
    mix-blend-mode: luminosity;
  }
  .sia-treatments__grid {
    display: grid;
    gap: 2rem;
    max-width: 82rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .sia-treatments__head {
    display: grid;
    gap: 0.75rem;
  }
  /* Phones: less of a gap from the last philosophy card down to "Find your moment." */
  @media (max-width: 479.98px) {
    .sia-treatments__grid {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem; /* the same space below the last card as above the title */
    }
    .sia-treatments__head {
      text-align: center;
      justify-items: center;
    }
    .sia-treatments__head p {
      text-wrap: balance;
    }
    .sia-treatments__grid .sia-treatments__note {
      text-align: center;
    }
    .sia-treatments__grid .sia-treatments__help.glass-3d {
      text-align: center;
      justify-content: center;
    }
    .sia-pillars .sia-story {
      padding-bottom: 2.5rem;
    }
  }
  /* Over the rock photograph: deep moss, a touch heavier, with a soft pale halo behind the
     letters so they lift clear of the stones without a visible box. */
  .sia-treatments__head p {
    color: #1f2a1b;
    font-weight: 500;
    text-shadow:
      0 0 2px rgb(240 243 233 / 0.95),
      0 0 10px rgb(240 243 233 / 0.85),
      0 0 22px rgb(240 243 233 / 0.6);
  }
  .sia-treatments__frame {
    position: relative;
    height: 100%;
    min-height: 22rem;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(39 50 42 / 0.6);
  }
  .sia-treatments__img {
    position: absolute;
    inset: 0;
    /* the photos are graded toward the site's sage already; only a touch softer here */
    filter: saturate(0.94);
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 550ms var(--depth-ease),
      transform 1200ms var(--depth-ease);
  }
  .sia-treatments__img.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .sia-menu {
    display: grid;
    gap: 1rem;
  }
  .sia-menu__card {
    --glass-blur: 22px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.25rem;
    cursor: default;
    outline: none;
    box-shadow: 0 18px 36px -24px rgb(39 50 42 / 0.55);
    transition:
      transform 500ms var(--depth-ease),
      box-shadow 500ms var(--depth-ease),
      background-position 1.4s var(--depth-ease);
  }
  /* the cards whose picture is showing */
  .sia-menu__card.is-featured {
    box-shadow:
      0 18px 36px -24px rgb(39 50 42 / 0.55),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 30%, transparent),
      0 0 28px -10px color-mix(in oklab, var(--color-accent) 45%, transparent);
  }
  .sia-menu__card:hover,
  .sia-menu__card:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 28px 48px -24px rgb(39 50 42 / 0.6),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 35%, transparent),
      0 0 34px -8px color-mix(in oklab, var(--color-accent) 50%, transparent);
  }
  .sia-menu__card h3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .sia-menu__card h3 span {
    font-size: 0.95rem;
    color: var(--color-accent);
  }
  .sia-menu__card p {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  /* prices, with the booking link at the end of the last line */
  .sia-menu__foot {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .sia-menu__card dl {
    flex: 1;
    display: grid;
    gap: 0.2rem;
    font-size: 0.8125rem;
  }
  .sia-menu__book {
    padding-bottom: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 550;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .sia-menu__book:hover,
  .sia-menu__book:focus-visible {
    text-decoration-color: currentColor;
  }
  /* the help panel over the foot of the photograph */
  .sia-treatments__help.glass-3d {
    --glass-tint: #f6f3ec;
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 0.9rem 1.2rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #27322a;
  }
  .sia-treatments__help p {
    flex: 1 1 14rem;
  }
  .sia-treatments__help strong {
    font-weight: 600;
  }
  .sia-treatments__help-link {
    /* tall enough to tap comfortably (24px minimum) */
    display: inline-block;
    padding-block: 0.2rem;
    font-weight: 550;
    color: #3f5634;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: rgb(63 86 52 / 0.4);
    text-underline-offset: 4px;
  }
  .sia-treatments__note {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: #1f2a1b;
  }
  .sia-treatments__visual {
    display: flex;
    flex-direction: column;
  }
  .sia-treatments__visual .sia-treatments__frame {
    flex: 1;
  }
  .sia-menu__card dl div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .sia-menu__card dt {
    color: var(--color-subtle);
  }
  .sia-menu__card dd {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-accent-strong);
  }
  .sia-leader {
    flex: 1;
    border-bottom: 1px dotted color-mix(in oklab, var(--color-accent) 45%, transparent);
    transform: translateY(-0.3em);
  }
  @media (min-width: 640px) {
    .sia-menu {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sia-treatments__grid {
      grid-template-columns: 5fr 7fr;
      grid-template-rows: auto 1fr;
      gap: 3rem 3rem;
      padding: 8rem 3rem;
    }
    .sia-treatments__head {
      grid-column: 1 / -1;
      grid-template-columns: 5fr 7fr;
      align-items: end;
      gap: 3rem;
    }
    .sia-treatments__head p {
      padding-bottom: 0.6rem;
    }
    /* The photograph matches the height of the card grid exactly. */
    .sia-treatments__visual {
      align-self: stretch;
    }
  }
  /* Laptop and up, on screens tall enough: the whole menu fits in one view below the header.
     Heading row on top; photo and the 2 x 3 cards share the rest of the height, the cards
     filling it evenly. Type scales with the screen's height so the cards never overflow. */
  @media (min-width: 1024px) and (min-height: 600px) {
    .sia-treatments__grid {
      box-sizing: border-box;
      height: calc(100svh - var(--header-height));
      max-width: 90rem;
      grid-template-columns: 4fr 7fr;
      grid-template-rows: auto minmax(0, 1fr);
      gap: clamp(1rem, 3vh, 2.25rem) clamp(1.5rem, 2.5vw, 2.75rem);
      padding: clamp(1.5rem, 4.5vh, 3.5rem) clamp(1.5rem, 3vw, 3rem);
    }
    .sia-treatments__head {
      grid-template-columns: 4fr 7fr;
      gap: clamp(1.5rem, 2.5vw, 2.75rem);
    }
    .sia-treatments__head .sia-heading {
      font-size: clamp(2.25rem, 6vh, 3.75rem);
      line-height: 1.05;
    }
    .sia-treatments__head p {
      padding-bottom: 0.35rem;
      font-size: clamp(0.9375rem, 2.3vh, 1.125rem);
      line-height: 1.55;
    }
    .sia-treatments__frame {
      min-height: 0;
    }
    .sia-menu {
      grid-template-rows: repeat(3, minmax(0, 1fr));
      gap: clamp(0.6rem, 1.8vh, 1rem);
    }
    .sia-menu__card {
      min-height: 0;
      padding: clamp(0.8rem, 2.2vh, 1.4rem) clamp(1rem, 1.6vw, 1.5rem) clamp(0.7rem, 1.8vh, 1.15rem);
    }
    .sia-menu__card h3 {
      font-size: clamp(1.1rem, 3.1vh, 1.65rem);
    }
    .sia-menu__card h3 span {
      font-size: clamp(0.8rem, 2.1vh, 1.05rem);
    }
    .sia-menu__card p {
      margin-top: 0.25rem;
      font-size: clamp(0.8125rem, 2.1vh, 1rem);
      line-height: 1.45;
    }
    .sia-menu__foot {
      padding-top: clamp(0.25rem, 0.9vh, 0.75rem);
    }
    .sia-menu__card dl {
      gap: 0;
      font-size: clamp(0.75rem, 1.95vh, 0.9375rem);
    }
    .sia-treatments__head p {
      max-width: 44rem;
    }
    .sia-menu__card dd {
      font-size: clamp(1rem, 2.6vh, 1.35rem);
      line-height: 1.25;
    }
  }

  /* ── Visit: step through the doorway ── */
  .sia-visit {
    --open: 0;
    position: relative;
    isolation: isolate;
  }
  .sia-visit__stage {
    position: sticky;
    top: var(--header-height);
    height: calc(100dvh - var(--header-height));
    overflow: hidden;
    z-index: 0;
    /* The wall's light: brighter toward the top left, falling off into shade. */
    background:
      radial-gradient(40% 55% at 50% 70%, rgb(195 209 166 / 0.16), transparent 70%),
      radial-gradient(90% 90% at 28% 12%, rgb(92 122 76 / 0.28), transparent 70%),
      radial-gradient(120% 100% at 80% 100%, rgb(8 12 6 / 0.45), transparent 65%);
  }
  .sia-visit {
    background: linear-gradient(180deg, #222d1c, #26321f 40%, #1f2a1a);
  }
  /* The arch: tall, centred, standing on the floor of the section, its path leading in.
     --open (0→1, from scroll) widens it until it fills the screen. */
  .sia-visit__door {
    --closed: calc(1 - var(--open));
    position: absolute;
    inset: 0;
    clip-path: inset(
      calc(var(--closed) * 24%) calc(var(--closed) * 32%) 0 calc(var(--closed) * 32%)
        round calc(var(--closed) * 50%) calc(var(--closed) * 50%) 0 0 / calc(var(--closed) * 30%)
        calc(var(--closed) * 30%) 0 0
    );
    will-change: clip-path;
  }
  /* The room photo is placed and sized by the doorway script (true scale behind the arch). */
  .sia-visit__door img {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }
  .sia-visit__door::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 28 18 / 0.5), rgb(20 28 18 / 0.15) 45%, rgb(20 28 18 / 0.55));
    opacity: var(--open);
  }
  /* The wall: moss plaster with a soft relief, lit from the top left. */
  .sia-visit__wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .sia-visit__edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .sia-visit__wall-foot {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgb(10 14 8 / 0.18) 55%, rgb(6 9 4 / 0.5));
  }
  /* The forecourt: a plane laid flat (turned to face up), placed and sized by the script. */
  .sia-visit__ground {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sia-visit__ground-plane {
    position: absolute;
    top: 0;
    background-repeat: repeat;
    transform-origin: 50% 0;
    transform: rotateX(90deg);
  }
  /* Light on the ground: softly brighter in front of the doorway, falling off to the sides. */
  .sia-visit__ground::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      /* Where the paving meets the wall: a dark joint, then the stones nearest the wall in
         the wall's shade, easing out over the first row or two. */
      linear-gradient(180deg, rgb(6 9 4 / 0.45) 0, rgb(6 9 4 / 0.4) 2px, rgb(6 9 4 / 0.32) 6%, rgb(6 9 4 / 0.12) 16%, transparent 30%),
      radial-gradient(60% 120% at 50% 0%, rgb(220 230 200 / 0.12), transparent 70%),
      linear-gradient(90deg, rgb(8 12 6 / 0.45), transparent 30%, transparent 70%, rgb(8 12 6 / 0.45));
  }
  /* Garden pieces, placed and scaled by the script; each rests on a soft contact shadow. */
  .sia-visit__garden {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sia-visit__prop {
    position: absolute;
    display: none;
  }
  .sia-visit__prop img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    /* Lit like the rest of the courtyard (softer, a touch darker than the studio photo). */
    filter: brightness(0.82) saturate(0.92);
  }
  .sia-visit__prop--mirror img {
    transform: scaleX(-1);
  }
  /* A gentle breeze: the bamboo (not the pot) sways a fraction of a degree, rising and falling
     irregularly, its shadow on the wall moving in step. Each picture is split at the pot's rim
     (74.2% down): the pot stays put, and the plant above pivots right on that line, where the
     stems are upright, so the join never shows. The two pots keep different time. Only the
     graphics card does this (rotation), it stops off-screen, and it is left out in battery mode
     and for reduced motion. */
  /* The still pot reaches a little above the cut (73.4%), under the swaying plant, so neither
     the soft edge of the cut nor the plant's slight tilt can ever open a line onto the wall:
     anything showing there is the same picture. */
  .sia-visit__prop img.sia-visit__prop-pot {
    clip-path: inset(73.4% 0 0 0);
  }
  .sia-visit__prop img.sia-visit__prop-sway:not(.sia-visit__prop-shadow) {
    position: absolute;
    inset: 0;
    height: 100%;
    clip-path: inset(0 0 25.8% 0);
  }
  /* The shadow is see-through, so it isn't split (two overlapping halves would show a darker
     band): it sways whole. Its pot part sits at the pivot and moves less than a pixel. */
  .sia-visit__prop img.sia-visit__prop-shadow:not(.sia-visit__prop-sway) {
    display: none;
  }
  @keyframes sia-breeze {
    0%,
    100% {
      rotate: 0deg;
    }
    18% {
      rotate: 0.55deg;
    }
    32% {
      rotate: 0.2deg;
    }
    50% {
      rotate: 0.9deg;
    }
    64% {
      rotate: 0.35deg;
    }
    82% {
      rotate: 0.6deg;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sia-visit__prop img.sia-visit__prop-sway {
      transform-origin: 50% 74.2%;
      animation: sia-breeze 9s ease-in-out infinite;
    }
    .sia-visit__prop--mirror img.sia-visit__prop-sway {
      animation-duration: 11.5s;
      animation-delay: -4s;
    }
    .sia-visit[data-lite] .sia-visit__prop img.sia-visit__prop-sway {
      animation: none;
    }
  }
  /* The plant's shadow, thrown back and to the right onto the wall by the upper-left light. */
  .sia-visit__prop img.sia-visit__prop-shadow {
    position: absolute;
    inset: 0;
    z-index: 0;
    height: 100%;
    filter: none;
    opacity: 0.55;
    transform: translate(22%, -0.6%);
    /* Only the part falling on the wall (the paving below has the plant's own ground shadow).
       No hard edge where wall meets paving: it fades softly into the foot of the wall and a
       touch beyond, where the ground shadow reaches up under it, so the two run together. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - var(--wallcut, 0%) - 6%),
      rgb(0 0 0 / 0.6) calc(100% - var(--wallcut, 0%)),
      transparent calc(100% - var(--wallcut, 0%) + 2%)
    );
    mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - var(--wallcut, 0%) - 6%),
      rgb(0 0 0 / 0.6) calc(100% - var(--wallcut, 0%)),
      transparent calc(100% - var(--wallcut, 0%) + 2%)
    );
  }
  .sia-visit__prop--mirror img.sia-visit__prop-shadow {
    transform: scaleX(-1) translate(-22%, -0.6%);
  }
  /* Grounding: a tight dark contact right where the foot meets the stone (centred on the
     foot's bottom edge, so it runs under and just behind it), and a soft shadow cast away from
     the light, to the right across the paving. */
  .sia-visit__prop::before,
  .sia-visit__prop::after {
    content: '';
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  .sia-visit__prop::before {
    left: calc(var(--sx, 50%) - var(--sw, 60%) / 2);
    width: var(--sw, 60%);
    bottom: -0.9%;
    height: 2.2%;
    background: radial-gradient(closest-side, rgb(4 6 3 / 0.95), rgb(4 6 3 / 0.6) 60%, transparent);
  }
  /* The pot's shadow on the paving: from its base back and to the right, to the foot of the
     wall, where the shadow on the wall (.sia-visit__prop-shadow) carries on up. The script sets
     the lean (--gskew) so it lands exactly under the wall shadow. */
  .sia-visit__prop::after {
    left: calc(var(--sx, 50%) - 21%);
    width: 42%;
    bottom: 0;
    /* reaches a little up the wall, under the wall shadow's soft fade, so the two blend */
    height: calc(var(--wallcut, 10%) + 2.5%);
    background: linear-gradient(0deg, rgb(4 7 3 / 0.55), rgb(4 7 3 / 0.45) 70%, rgb(4 7 3 / 0.38) 88%, transparent);
    border-radius: 30% 30% 50% 50% / 25% 25% 45% 45%;
    transform-origin: 50% 100%;
    transform: skewX(var(--gskew, -30deg));
    filter: blur(var(--gblur, 4px));
  }
  /* The two door leaves. Each fills the stage (its drawing uses the stage's own coordinates)
     and turns about its hinge; the script sets the angle, hinge and eye point. */
  .sia-visit__doors {
    position: absolute;
    inset: 0;
    perspective: 1600px;
    pointer-events: none;
  }
  .sia-visit__leaf {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* The leaf's thickness, seen along its meeting edge as it swings: a face turned back from
     the edge into the doorway. */
  /* The back face of a leaf, set back by its thickness (placed by the script). */
  .sia-visit__leaf-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* One short face of the top edge's thickness (placed and shaded by the script). */
  .sia-visit__leaf-rim {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    transform-origin: 0 0;
    /* Arris lines along the top edge's front and back, continuing the box round the crown. */
    border-top: 1px solid rgb(14 20 10 / 0.7);
    border-bottom: 1px solid rgb(14 20 10 / 0.7);
  }
  .sia-visit__leaf-edge {
    position: absolute;
    box-sizing: border-box;
    /* Arris lines boxing the edge in: down its front and back, and turning 90° across the top
       and bottom to join the front sheet to the back one. */
    border: 1px solid rgb(14 20 10 / 0.75);
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    /* Grain along the edge's length, light on the front arris, shade toward the back sheet. */
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 3px),
      linear-gradient(90deg, rgb(240 220 190 / 0.12), transparent 30%, rgb(0 0 0 / 0.4)),
      linear-gradient(180deg, #5e4431, #432f22 60%, #312218);
    backface-visibility: hidden;
  }
  .sia-visit__leaf-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Frosted glass filling the band between the two sage lines; the photo runs underneath it,
     so the path shows through softly blurred. */
  .sia-visit__glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(160deg, rgb(232 238 220 / 0.2), rgb(196 210 176 / 0.08) 55%, rgb(232 238 220 / 0.14));
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    backdrop-filter: blur(10px) saturate(1.2);
  }
  /* The arch border: a confident line on the doorway's edge and a fine line outside it. */
  .sia-visit__frame.is-zooming .sia-timber {
    filter: none;
  }
  /* Battery mode: the room rising into view as one picture (see the doorway script). */
  .sia-visit__enter {
    position: absolute;
    inset: 0;
    z-index: 5; /* over everything in the scene, the plants included */
    overflow: hidden;
    pointer-events: none;
    will-change: opacity;
  }
  .sia-visit__enter img {
    position: absolute;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform;
  }
  .sia-visit__enter-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 28 18 / 0.5), rgb(20 28 18 / 0.15) 45%, rgb(20 28 18 / 0.55));
    will-change: opacity;
