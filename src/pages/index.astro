---
// SIA MASSAGE: one-page site. Prices, treatments and copy marked MOCK are placeholders.
// Photography: Unsplash (free licence); artwork: The Met Open Access (public domain).
// Full credits in docs/CREDITS.md.
import Section from '../components/layout/Section.astro';
import Img from '../components/media/Img.astro';
import InkLandscape from '../client/InkLandscape.astro';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import { formatAuPhone, site, telHref } from '../config/site';

import bambooLight from '../client/photos/bamboo-light.jpg';
import teaTable from '../client/photos/tea-table.jpg';
import teaLeaves from '../client/photos/tea-leaves.jpg';
import hotStones from '../client/photos/hot-stones.jpg';
import herbalCompress from '../client/photos/herbal-compress.jpg';
import oilMassage from '../client/photos/oil-massage.jpg';
import bambooPath from '../client/photos/bamboo-path.jpg';
import towelCandles from '../client/photos/towel-candles.jpg';
import mossyRocks from '../client/photos/mossy-rocks.jpg';
import autumnScroll from '../client/art/streams-mountains-autumn-mist.jpg';

const { business } = site;
const phone = business.phone!;
const address = business.address!;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${address.street}, ${address.suburb} ${address.state} ${address.postcode}`,
)}`;

// Pictures the treatment menu crossfades between as you move through it.
const treatmentImages = {
  oil: { src: oilMassage, alt: 'Therapist pouring warm oil before a relaxation massage' },
  stones: { src: hotStones, alt: 'Hands placing smooth heated stones along a client’s back' },
  herbal: { src: herbalCompress, alt: 'Warm herbal compress balls pressed along the shoulders' },
} as const;

// MOCK: treatments and prices
const treatments = [
  {
    name: 'Relaxation massage',
    zh: '放松',
    image: 'oil',
    text: 'Long, unhurried strokes with warm oil that quiet a busy mind.',
    prices: [['30 min', '$55'], ['60 min', '$90'], ['90 min', '$130']],
  },
  {
    name: 'Remedial massage',
    zh: '理疗',
    image: 'oil',
    text: 'Deeper, focused work for stiff necks, tight shoulders and aching backs.',
    prices: [['60 min', '$100'], ['90 min', '$145']],
  },
  {
    name: 'Hot stone massage',
    zh: '热石',
    image: 'stones',
    text: 'Heated basalt stones sink warmth deep into tired muscles.',
    prices: [['75 min', '$125']],
  },
  {
    name: 'Herbal compress',
    zh: '药包',
    image: 'herbal',
    text: 'Steamed pouches of ginger, lemongrass and camphor, pressed along the body.',
    prices: [['60 min', '$105']],
  },
  {
    name: 'Foot reflexology',
    zh: '足疗',
    image: 'herbal',
    text: 'Pressure-point therapy on the feet, the traditional way back to balance.',
    prices: [['45 min', '$70'], ['60 min', '$85']],
  },
  {
    name: 'Head, neck & shoulders',
    zh: '头颈',
    image: 'stones',
    text: 'Thirty minutes that undo a week at the desk.',
    prices: [['30 min', '$55']],
  },
] as const;

const journey = [
  { n: '一', title: 'Arrive', text: 'Leave the day at the door. Warm tea, a quiet welcome, a few words about how you feel.' },
  { n: '二', title: 'Breathe', text: 'Soft light, clean linen, the scent of camphor. Your therapist tunes the pressure to you.' },
  { n: '三', title: 'Release', text: 'Skilled hands follow tension to its source, guided by traditional technique.' },
  { n: '四', title: 'Restore', text: 'Rise slowly. Sit a moment. Leave lighter than you came.' },
];

// MOCK: answers to confirm with the owner
const faqs = [
  { q: 'Do I need to book ahead?', a: 'Booking is best, especially evenings and weekends. Walk-ins are welcome whenever a therapist is free.' },
  { q: 'What should I wear?', a: 'Come as you are. You undress only to your comfort, and stay covered with fresh towels throughout.' },
  { q: 'How early should I arrive?', a: 'Five to ten minutes before your time, so you can settle in and tell us about any health concerns.' },
  { q: 'Can I claim a health fund rebate?', a: 'Rebates may be available for remedial massage with eligible funds. Ask us when you book.' },
  { q: 'Is massage safe during pregnancy?', a: 'Please let us know when booking and we will suggest the treatments that suit you.' },
];
---

<OnePageLayout>
  <!-- ───────────── Hero: an invitation, a window onto mountains ───────────── -->
  <section class="sia-hero" aria-labelledby="hero-title">
    <div class="sia-hero__bamboo" aria-hidden="true">
      <Img src={bambooLight} alt="" sizes="50vw" priority class="h-full w-full object-cover" />
    </div>

    <div class="sia-hero__grid">
      <div class="sia-hero__copy" data-reveal>
        <span class="sia-hero__seal font-han" lang="zh-Hans" aria-hidden="true">静</span>
        <h1 id="hero-title" class="sia-display">
          Sia<br /><em>Massage</em>
        </h1>
        <p class="sia-hero__lede">
          Traditional Asian massage in a quiet room, with unhurried hands. An hour that belongs only to you.
        </p>
        <div class="sia-hero__actions">
          <a href="#contact" class="btn-3d">Book a treatment</a>
          <a href="#treatments" class="btn-3d btn-3d--ghost">See the menu</a>
        </div>
        <p class="sia-hero__hours">{business.hours}</p>
      </div>

      <div class="sia-hero__gate-wrap" data-reveal>
        <div class="sia-moongate card-3d breathe" data-tilt>
          <InkLandscape class="absolute inset-0 h-full w-full" />
        </div>
        <span class="sia-hero__rest font-han" aria-hidden="true">息</span>
      </div>
    </div>

    <a href="#philosophy" class="sia-scroll-cue" aria-label="Scroll to philosophy">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <!-- ───────────── Philosophy: an editorial collage ───────────── -->
  <Section id="philosophy" labelledby="philosophy-title" class="sia-philosophy">
    <div class="sia-philosophy__grid">
      <figure class="sia-philosophy__tea img-reveal">
        <div class="scroll-drift h-full">
          <Img src={teaTable} alt="Tea set laid out on a long wooden table in soft evening light" sizes="(min-width: 1024px) 58vw, 100vw" class="h-full w-full object-cover" />
        </div>
      </figure>

      <figure class="sia-philosophy__leaves img-reveal" aria-hidden="true">
        <Img src={teaLeaves} alt="" sizes="(min-width: 1024px) 22vw, 40vw" class="h-full w-full object-cover" />
      </figure>

      <div class="sia-philosophy__card glass-3d" data-reveal>
        <p class="sia-kicker font-han" lang="zh-Hans">静心 <span>a quiet heart</span></p>
        <h2 id="philosophy-title" class="sia-heading">A quiet place to return to yourself</h2>
        <p>
          At Sia, massage is not a rush between appointments. Drawing on traditional Asian bodywork,
          every treatment is slow and attentive, so the body can soften and the mind can rest.
        </p>
        <p>Clean linen, low light, a cup of tea. Nothing to do but breathe.</p>
        <blockquote>When the body is at ease, the heart follows.</blockquote>
      </div>
    </div>
  </Section>

  <!-- ───────────── A handscroll unrolls as you scroll ───────────── -->
  <section class="sia-scroll" aria-label="Streams and Mountains in Autumn Mist, a Chinese handscroll">
    <div class="sia-scroll__frame scroll-pan-frame">
      <Img src={autumnScroll} alt="Ink landscape of misty mountains, willows and a fisherman’s boat, painted on paper" sizes="200vw" widths={[1200, 2000]} class="scroll-pan sia-scroll__img" />
    </div>
    <p class="sia-scroll__credit">
      Bian Wenyu, <em>Streams and Mountains in Autumn Mist</em>, 1634. The Metropolitan Museum of Art, public domain.
    </p>
  </section>

  <!-- ───────────── Treatments: menu with a living picture ───────────── -->
  <Section id="treatments" labelledby="treatments-title" class="sia-treatments">
    <div class="sia-treatments__grid">
      <div class="sia-treatments__visual">
        <div class="sia-treatments__frame card-3d" data-tilt data-treatment-frame>
          {
            Object.entries(treatmentImages).map(([key, img], i) => (
              <div class:list={['sia-treatments__img', { 'is-active': i === 0 }]} data-treatment-img={key}>
                <Img src={img.src} alt={img.alt} sizes="(min-width: 1024px) 40vw, 100vw" class="h-full w-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <header class="sia-treatments__head" data-reveal>
          <h2 id="treatments-title" class="sia-heading">The menu</h2>
          <p>Every treatment is tailored on the day. Prices in AUD, GST inclusive.</p>
        </header>
        <ul class="sia-menu" role="list">
          {
            treatments.map((t) => (
              <li class="sia-menu__item" data-treatment={t.image} tabindex="-1" data-reveal>
                <div>
                  <h3>
                    {t.name}
                    <span class="font-han" lang="zh-Hans">{t.zh}</span>
                  </h3>
                  <p>{t.text}</p>
                </div>
                <dl>
                  {t.prices.map(([time, price]) => (
                    <div>
                      <dt>{time}</dt>
                      <span class="sia-leader" aria-hidden="true" />
                      <dd>{price}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- ───────────── Your visit: glass over the bamboo path ───────────── -->
  <Section id="visit" labelledby="visit-title" class="sia-visit">
    <div class="sia-visit__bg" aria-hidden="true">
      <div class="scroll-drift h-full">
        <Img src={bambooPath} alt="" sizes="100vw" class="h-full w-full object-cover" />
      </div>
    </div>
    <div class="sia-visit__inner">
      <h2 id="visit-title" class="sia-heading sia-heading--light" data-reveal>Four quiet moments</h2>
      <ol class="sia-visit__cards" role="list">
        {
          journey.map((j) => (
            <li class="sia-visit__card glass-3d card-3d" data-tilt data-reveal>
              <span class="font-han" aria-hidden="true" lang="zh-Hans">{j.n}</span>
              <h3>{j.title}</h3>
              <p>{j.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ───────────── Questions ───────────── -->
  <Section id="faq" labelledby="faq-title" class="sia-faq">
    <div class="sia-faq__grid">
      <figure class="sia-faq__image img-reveal">
        <Img src={towelCandles} alt="Rolled white towel, candles and a reed diffuser on a pale table" sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" />
      </figure>
      <div>
        <h2 id="faq-title" class="sia-heading" data-reveal>Before you arrive</h2>
        <div class="sia-faq__list" data-reveal>
          {
            faqs.map((f) => (
              <details class="sia-faq__item">
                <summary>
                  {f.q}
                  <span class="sia-faq__mark" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- ───────────── Contact: a jigsaw booking card on moss and water ───────────── -->
  <Section id="contact" labelledby="contact-title" class="sia-contact">
    <div class="sia-contact__bg" aria-hidden="true">
      <Img src={mossyRocks} alt="" sizes="100vw" class="h-full w-full object-cover" />
    </div>
    <div class="sia-contact__inner">
      <div class="jigsaw sia-contact__card" data-reveal>
        <div class="jigsaw__main glass-3d">
          <span class="sia-contact__seal font-han" aria-hidden="true" lang="zh-Hans">约</span>
          <h2 id="contact-title" class="sia-heading">Your hour of calm awaits</h2>
          <dl class="sia-contact__details">
            <div>
              <dt>Find us</dt>
              <dd>
                {address.street}<br />{`${address.suburb} ${address.state} ${address.postcode}`}
              </dd>
            </div>
            <div>
              <dt>Open</dt>
              <dd>{business.hours}</dd>
            </div>
            <div>
              <dt>Write</dt>
              <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            </div>
          </dl>
        </div>
        <div class="jigsaw__piece glass-3d">
          <a href={telHref(phone)} class="sia-contact__phone">{formatAuPhone(phone)}</a>
          <span class="sia-contact__actions">
            <a href={telHref(phone)} class="btn-3d">Call to book</a>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-3d btn-3d--ghost">Directions</a>
          </span>
        </div>
      </div>
    </div>
  </Section>
</OnePageLayout>

<style is:global>
  .font-han {
    font-family: var(--font-han);
  }
  .sia-display {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
  }
  .sia-display em {
    font-style: italic;
    color: var(--color-accent-strong);
  }
  .sia-heading {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1.05;
  }
  .sia-heading--light {
    color: #f6f3ec;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .sia-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  .sia-kicker span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-subtle);
  }

  /* ── Hero ── */
  .sia-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100dvh - var(--header-height));
  }
  .sia-hero__bamboo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60vw, 56rem);
    opacity: 0.55;
    mask-image: linear-gradient(to left, black 30%, transparent 95%);
    -webkit-mask-image: linear-gradient(to left, black 30%, transparent 95%);
    pointer-events: none;
  }
  .sia-hero__grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
    max-width: 82rem;
    min-height: inherit;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  @media (min-width: 1024px) {
    .sia-hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      padding-inline: 3rem;
    }
  }
  .sia-hero__copy {
    position: relative;
    padding-left: clamp(0rem, 4vw, 3.5rem);
  }
  .sia-hero__seal {
    position: absolute;
    left: 0;
    top: 0.4rem;
    display: none;
    font-size: 1.6rem;
    color: var(--color-accent);
    writing-mode: vertical-rl;
  }
  @media (min-width: 640px) {
    .sia-hero__seal {
      display: block;
    }
  }
  .sia-hero__lede {
    max-width: 28rem;
    margin-top: 2rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  .sia-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }
  .sia-hero__hours {
    margin-top: 1.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
  }
  .sia-hero__gate-wrap {
    position: relative;
    width: min(100%, 34rem);
    margin-inline: auto;
  }
  .sia-moongate {
    position: relative;
    aspect-ratio: 1;
    border-radius: 9999px;
    overflow: hidden;
    --depth-tilt: 7deg;
    box-shadow:
      0 0 0 1px var(--color-border),
      0 0 0 14px color-mix(in oklab, var(--color-bg) 85%, transparent),
      0 0 0 15px color-mix(in oklab, var(--color-accent) 35%, transparent),
      0 50px 90px -40px color-mix(in oklab, var(--color-text) 45%, transparent);
  }
  .sia-hero__rest {
    position: absolute;
    right: -0.5rem;
    bottom: 1.5rem;
    font-size: clamp(6rem, 12vw, 9rem);
    line-height: 1;
    color: color-mix(in oklab, var(--color-accent) 16%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .sia-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1px;
    height: 3.5rem;
    background: color-mix(in oklab, var(--color-accent) 25%, transparent);
    overflow: hidden;
  }
  .sia-scroll-cue span {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sia-scroll-cue span {
      animation: sia-cue 2.6s ease-in-out infinite;
    }
  }
  @keyframes sia-cue {
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  /* ── Philosophy collage ── */
  .sia-philosophy__grid {
    display: grid;
    gap: 1.5rem;
    max-width: 82rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .sia-philosophy__tea {
    aspect-ratio: 4 / 5;
    border-radius: 0.25rem;
  }
  .sia-philosophy__leaves {
    display: none;
  }
  .sia-philosophy__card {
    padding: 2.25rem;
    --glass-tint: var(--color-bg);
  }
  .sia-philosophy__card > * + * {
    margin-top: 1.1rem;
  }
  .sia-philosophy__card p {
    color: var(--color-muted);
  }
  .sia-philosophy__card blockquote {
    margin-top: 1.75rem;
    padding-left: 1.25rem;
    border-left: 1px solid color-mix(in oklab, var(--color-accent) 50%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
  }
  @media (min-width: 1024px) {
    .sia-philosophy__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto auto;
      gap: 0;
      padding: 9rem 3rem;
    }
    .sia-philosophy__tea {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
      aspect-ratio: 5 / 4;
    }
    .sia-philosophy__leaves {
      display: block;
      grid-column: 1 / 4;
      grid-row: 2;
      align-self: end;
      width: 70%;
      aspect-ratio: 3 / 4;
      margin: 0 0 -5rem -2rem;
      border-radius: 0.25rem;
      box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
      z-index: 2;
    }
    .sia-philosophy__card {
      grid-column: 7 / 13;
      grid-row: 1 / 3;
      align-self: center;
      margin-top: 6rem;
      padding: 3.25rem;
      z-index: 3;
    }
  }

  /* ── Handscroll band ── */
  .sia-scroll {
    padding: 2rem 0 5rem;
  }
  .sia-scroll__frame {
    height: clamp(16rem, 42vh, 26rem);
    border-block: 1px solid var(--color-border);
    background: #ece5d6;
  }
  .sia-scroll__img {
    --pan-width: 210%;
    --pan-ratio: 2.1;
    width: var(--pan-width);
    filter: sepia(0.15) saturate(0.8);
  }
  .sia-scroll__credit {
    max-width: 82rem;
    margin: 0.9rem auto 0;
    padding-inline: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  /* ── Treatments ── */
  .sia-treatments__grid {
    display: grid;
    gap: 3rem;
    max-width: 82rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .sia-treatments__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 999px 999px 0.5rem 0.5rem;
    overflow: hidden;
    --depth-tilt: 4deg;
  }
  .sia-treatments__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 900ms var(--depth-ease),
      transform 1400ms var(--depth-ease);
  }
  .sia-treatments__img.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .sia-treatments__head p {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  .sia-menu {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }
  .sia-menu__item {
    display: grid;
    gap: 1rem;
    padding: 1.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: background-color 400ms ease;
    outline: none;
  }
  .sia-menu__item:hover,
  .sia-menu__item:focus-within {
    background: color-mix(in oklab, var(--color-accent) 6%, transparent);
  }
  .sia-menu__item h3 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
  }
  .sia-menu__item h3 span {
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--color-accent) 75%, transparent);
  }
  .sia-menu__item p {
    margin-top: 0.3rem;
    max-width: 26rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .sia-menu__item dl {
    display: grid;
    gap: 0.25rem;
    min-width: 11rem;
    font-size: 0.875rem;
  }
  .sia-menu__item dl div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .sia-menu__item dt {
    color: var(--color-subtle);
  }
  .sia-menu__item dd {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .sia-leader {
    flex: 1;
    border-bottom: 1px dotted var(--color-border);
    transform: translateY(-0.3em);
  }
  @media (min-width: 640px) {
    .sia-menu__item {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .sia-treatments__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
      padding: 8rem 3rem;
    }
    .sia-treatments__visual {
      position: sticky;
      top: calc(var(--header-height) + 3rem);
      align-self: start;
    }
    .sia-treatments__frame {
      aspect-ratio: 4 / 5;
    }
  }

  /* ── Visit: glass over photograph ── */
  .sia-visit {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .sia-visit__bg {
    position: absolute;
