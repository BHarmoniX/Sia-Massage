---
// SIA MASSAGE: one-page site. Prices, treatments and copy marked MOCK are placeholders.
// Photography: Unsplash (free licence); artwork: The Met Open Access (public domain).
// Full credits in docs/CREDITS.md.
import ScrollCue from '../components/layout/ScrollCue.astro';
import Section from '../components/layout/Section.astro';
import Img from '../components/media/Img.astro';
import InkLandscape from '../client/InkLandscape.astro';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import { formatAuPhone, site, telHref } from '../config/site';

import bambooLight from '../client/photos/bamboo-light.jpg';
// Placeholder shop front (generated) until the owner supplies a real photo of the studio.
import shopFront from '../client/photos/shop-front.jpg';
import morningRoom from '../client/photos/morning-room.jpg';
// PLACEHOLDER (supplied 2026-11-01, licence unknown): stands in for a real, approved photo of
// Sia's owner and team in the philosophy story. Replace before launch.
import storyPhoto from '../client/photos/team-sia.jpg'; // AI-generated PLACEHOLDER until the owner's real team photo
import traditionHands from '../client/photos/tradition-hands.jpg';
// Treatment photos: generated for Sia (OpenArt, Nano Banana Pro), graded toward the site's sage.
import treatQuietPause from '../client/photos/treat-quiet-pause.jpg';
import treatClassic from '../client/photos/treat-classic.jpg';
import treatDeep from '../client/photos/treat-deep.jpg';
import treatRitual from '../client/photos/treat-ritual.jpg';
import treatTogether from '../client/photos/treat-together.jpg';
import treatGift from '../client/photos/treat-gift.jpg';
// The view through the doorway: a candlelit spa treatment room (generated for Sia, OpenArt).
// The earlier bamboo path photo (bamboo-path.jpg) is kept in the photos folder in case it's wanted back.
import spaRoom from '../client/photos/spa-room.jpg';
// FAQ: a treatment room made up and waiting (generated for Sia, OpenArt Nano Banana Pro).
import faqRoom from '../client/photos/faq-room.jpg';
import mossRiver from '../client/photos/moss-river.jpg';
// The rain pause: a still forest pond, and one glass-white lotus on its lily pads (both generated for Sia).
import rainPond from '../client/photos/rain-pond.jpg';
// The lotus in two layers: its lily pads (behind the glass card) and the flower (in front of it).
import rainLotusPads from '../client/photos/rain-lotus-pads.webp';
import rainLotusFlower from '../client/photos/rain-lotus-flower.webp';
// Timber in a dark Japanese stain (the unstained originals stay on file beside them).
import doorBoardsLeft from '../client/photos/door-boards-left-stained.jpg';
import doorBoardsRight from '../client/photos/door-boards-right-stained.jpg';
import frameWalnut from '../client/photos/frame-walnut-stained.jpg';
import doorIron from '../client/photos/door-iron.jpg';
import groundStone from '../client/photos/ground-stone.jpg';
import stepStone from '../client/photos/step-stone.jpg';
import wallPlaster from '../client/photos/wall-plaster.jpg';
import gardenBambooA from '../client/photos/garden-bamboo-a.webp';
import gardenBambooB from '../client/photos/garden-bamboo-b.webp';
import gardenBambooAShadow from '../client/photos/garden-bamboo-a-shadow.webp';
import gardenBambooBShadow from '../client/photos/garden-bamboo-b-shadow.webp';
import { getImage } from 'astro:assets';

// The doorway's doors: natural oiled hardwood boards, one sheet per leaf, cut from a real
// hardwood photo turned so its grain runs up the boards (each board a different part of it).
// Compressed to WebP at build time.
const doorLeftImg = await getImage({ src: doorBoardsLeft, width: 600, format: 'webp', quality: 80 });
const doorRightImg = await getImage({ src: doorBoardsRight, width: 600, format: 'webp', quality: 80 });
// The arch frame's timber: an original walnut texture generated for Sia (OpenArt, commercial
// licence), grain running along the timber.
const frameWalnutImg = await getImage({ src: frameWalnut, width: 700, format: 'webp', quality: 78 });
// The door hardware's metal: an original hand-forged iron texture generated for Sia (OpenArt).
const doorIronImg = await getImage({ src: doorIron, width: 400, format: 'webp', quality: 78 });
// The forecourt: an original mossy flagstone texture generated for Sia (OpenArt), mirrored
// into a seamless tile.
const groundStoneImg = await getImage({ src: groundStone, width: 1000, format: 'webp', quality: 76 });
const stepStoneImg = await getImage({ src: stepStone, width: 824, format: 'webp', quality: 82 });
// The wall: an original moss lime-plaster texture generated for Sia (OpenArt), mirrored into a
// seamless tile.
const wallPlasterImg = await getImage({ src: wallPlaster, width: 1200, format: 'webp', quality: 74 });
// The courtyard garden: original cut-outs generated for Sia (OpenArt) — tall, airy bamboo in round
// carved stone pots, its tips leaning toward the door.
const bambooAImg = await getImage({ src: gardenBambooA, width: 700, format: 'webp', quality: 80 });
const bambooBImg = await getImage({ src: gardenBambooB, width: 700, format: 'webp', quality: 80 });
// Each plant's shadow, pre-blurred (a live blur filter on the plants is too heavy to paint).
const bambooAShadowImg = await getImage({ src: gardenBambooAShadow, width: 450, format: 'webp', quality: 70 });
const bambooBShadowImg = await getImage({ src: gardenBambooBShadow, width: 450, format: 'webp', quality: 70 });

const { business } = site;
const phone = business.phone!;
const address = business.address!;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${address.street}, ${address.suburb} ${address.state} ${address.postcode}`,
)}`;

// Pictures the treatment menu crossfades between as you move through it.
// Pictures the menu crossfades between as you move through it.
// One photo per treatment, each showing that treatment.
const treatmentImages = {
  pause: { src: treatQuietPause, alt: 'A therapist in a sage uniform gently massaging the neck and shoulders of a client lying face down' },
  classic: { src: treatClassic, alt: 'A young therapist giving a man a slow relaxation massage along his back' },
  deep: { src: treatDeep, alt: 'A woman resting with her eyes closed as a therapist rests her palms on her shoulders' },
  ritual: { src: treatRitual, alt: 'A therapist giving a woman a gentle head and temple massage as she lies with her eyes closed' },
  together: { src: treatTogether, alt: 'A couple side by side on two massage tables, each with their own therapist' },
  gift: { src: treatGift, alt: 'A gift voucher in a kraft envelope tied with a sage ribbon, on folded linen beside a tea cup' },
} as const;

// Chinese relaxation massage. Names and lines from the master brief (DRAFT: the owner to confirm
// what each treatment includes). MOCK: options, durations and prices.
const treatments = [
  {
    name: 'A Quiet Pause',
    zh: '片刻',
    image: 'pause',
    text: 'A little time to unwind.',
    prices: [['30 min', '$55']],
  },
  {
    name: 'Classic Relaxation',
    zh: '放松',
    image: 'classic',
    text: 'An unhurried escape.',
    prices: [['60 min', '$90']],
  },
  {
    name: 'Deep Relaxation',
    zh: '静养',
    image: 'deep',
    text: 'Time to truly switch off.',
    prices: [['90 min', '$130']],
  },
  {
    name: 'The Sia Ritual',
    zh: '仪式',
    image: 'ritual',
    text: 'Make time for yourself.',
    prices: [['120 min', '$170']],
  },
  {
    name: 'Together',
    zh: '同享',
    image: 'together',
    text: 'Share a moment of calm.',
    prices: [['60 min', '$180'], ['90 min', '$260']],
  },
  {
    name: 'Gift of Calm',
    zh: '礼物',
    image: 'gift',
    text: 'Give someone time for themselves.',
    prices: [['From', '$55']],
  },
] as const;

// The four moments of a visit. Copy from the master brief (proposed; owner to review).
const journey = [
  { n: '1', title: 'Arrive', line: 'Leave the day at the door.', text: "Take a moment to settle in. Enjoy a warm welcome, a little time to unwind and a few words about how you're feeling." },
  { n: '2', title: 'Breathe', line: 'Ease into the moment.', text: 'Get comfortable and let the outside world fade away. Your therapist will discuss your preferences and the pressure that feels right for you.' },
  { n: '3', title: 'Release', line: 'Time to let go.', text: 'Settle into your treatment as attentive hands and considered techniques help you enjoy a moment of relaxation.' },
  { n: '4', title: 'Restore', line: 'Return to your day, unhurried.', text: 'Take your time getting up. Enjoy a quiet moment before heading back into the day, hopefully feeling refreshed.' },
];

// MOCK: answers to confirm with the owner
// Questions from the master brief. DRAFT answers: built only from what the site already states
// (the cancellation terms come from the legal settings, which are still MOCK). Owner to confirm
// every answer reflects how Sia actually works.
const cancel = site.legal?.cancellation;
const faqs = [
  { q: 'Do I need to book ahead?', a: 'Booking is best, especially evenings and weekends. Walk-ins are welcome whenever a therapist is free.' },
  { q: 'What should I wear?', a: 'Come as you are. You undress only to your comfort, and stay covered with fresh towels throughout.' },
  { q: 'Should I arrive early?', a: 'Five to ten minutes before your time is ideal, so you can settle in and tell us how you are feeling.' },
  { q: 'Can I choose the massage pressure?', a: 'Yes. Your therapist will ask about your preferences before you begin, and you can ask for lighter or firmer pressure at any time.' },
  { q: 'How do I choose the right treatment?', a: "Start with how much time you would like for yourself. If you're not sure, get in touch and we'll happily help you find an option that suits you." },
  { q: 'Is there anything I should mention before my massage?', a: 'Please let us know about any injuries, health conditions, pregnancy or areas you would like us to avoid, so we can keep your treatment comfortable.' },
  {
    q: 'What is your cancellation or rescheduling policy?',
    a: cancel
      ? `Please give us at least ${cancel.noticeHours} hours' notice if you need to cancel or reschedule. Later cancellations may be charged ${cancel.lateCancelFee}, and missed appointments ${cancel.noShowFee}.`
      : 'Please let us know as early as you can if you need to cancel or reschedule.',
  },
];
---

<OnePageLayout>
  <!-- ───────────── Hero: an invitation, a window onto mountains ───────────── -->
  <section class="sia-hero" aria-labelledby="hero-title">
    <!-- A soft ink landscape across the foot of the hero: pale ridges drifting very slowly,
         and mist passing over them. -->
    <div class="sia-hero__land" aria-hidden="true">
      <svg class="sia-hero__ridge sia-hero__ridge--far" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 132 Q100 93 200 141 Q300 86 400 121 Q500 87 600 137 Q700 118 800 143 Q900 92 1000 120 Q1100 99 1200 132 Q1300 113 1400 141 Q1500 104 1600 121 Q1700 101 1800 137 Q1900 98 2000 143 Q2100 85 2200 120 Q2300 85 2400 132 V260 H0Z" /></svg>
      <div class="sia-hero__mist sia-hero__mist--high"></div>
      <svg class="sia-hero__ridge sia-hero__ridge--mid" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 173 Q100 144 200 178 Q300 166 400 190 Q500 130 600 152 Q700 129 800 197 Q900 160 1000 171 Q1100 153 1200 173 Q1300 148 1400 178 Q1500 158 1600 190 Q1700 126 1800 152 Q1900 138 2000 197 Q2100 156 2200 171 Q2300 158 2400 173 V260 H0Z" /></svg>
      <div class="sia-hero__mist"></div>
      <svg class="sia-hero__ridge sia-hero__ridge--near" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 201 Q100 183 200 233 Q300 193 400 209 Q500 191 600 228 Q700 180 800 200 Q900 190 1000 233 Q1100 190 1200 201 Q1300 185 1400 233 Q1500 198 1600 209 Q1700 199 1800 228 Q1900 191 2000 200 Q2100 182 2200 233 Q2300 183 2400 201 V260 H0Z" /></svg>
    </div>
    <div class="sia-hero__bamboo" aria-hidden="true">
      <Img src={bambooLight} alt="" sizes="50vw" priority class="h-full w-full object-cover" />
    </div>

    <div class="sia-hero__grid">
      <div class="sia-hero__copy" data-reveal>
        <h1 id="hero-title" class="sia-display">
          Sia<br /> <em>Massage</em>
        </h1>
        <!-- Copy from the master brief (proposed; owner to review). -->
        <p class="sia-hero__tagline">A quieter place to unwind.</p>
        <p class="sia-hero__lede">
          Chinese relaxation massage in a welcoming, peaceful setting. Take time for yourself, ease into
          the moment and enjoy a little space to simply unwind.
        </p>
        <div class="sia-hero__cta-group sia-hero__cta-group--beside">
          <div class="sia-hero__actions">
            <a href="#contact" class="btn-3d">Book a treatment</a>
            <a href="#treatments" class="btn-3d sia-btn-white">See the menu</a>
          </div>
          <p class="sia-hero__hours">{business.hours}</p>
        </div>
      </div>

      <div class="sia-hero__gate-wrap" data-reveal>
        <div class="sia-moongate" data-tilt>
          <div class="sia-moongate__face">
            <InkLandscape class="absolute inset-0 h-full w-full" />
            <!-- 静息, "quiet rest": inscribed on the scene like a painting's calligraphy. -->
            <span class="sia-hero__rest font-han" lang="zh-Hans" aria-hidden="true"><span data-depth="0.5">静</span><span data-depth="0.7">息</span></span>
          </div>
        </div>
      </div>
      <!-- Phones: the same buttons and hours again, below the roundel (the ones above are hidden there). -->
      <div class="sia-hero__cta-group sia-hero__cta-group--below" data-reveal>
        <div class="sia-hero__actions">
          <a href="#contact" class="btn-3d">Book a treatment</a>
          <a href="#treatments" class="btn-3d sia-btn-white">See the menu</a>
        </div>
        <p class="sia-hero__hours">{business.hours}</p>
      </div>
    </div>

    <ScrollCue href="#philosophy" label="Scroll to our philosophy" />
  </section>

  <!-- ───────────── Philosophy: who Sia is, and three pillars ───────────── -->
  <!-- CONNECT (master brief §6). An asymmetric opening (heading left, introduction stepping in from the
       right), then the identity story (text with a portrait beside it), then three pillars as
       staggered steps: the place, the tradition, the experience. COPY IS PROPOSED in the brief and
       must be reviewed by the owner before publication.
       The scene: the hero's 
       mountains reflected in still water (the same ridges, mirrored and drifting in step, so the
       hero runs straight on into the lake), and the lake deepens from the hero's pale sage to Sia's
       dark moss: step one in light tones, step two in mid tones, step three (the studio) in the
       dark. Every photo sits inside its card (story, place, tradition, experience); the photos grow as the story goes down. (The earlier "arriving at dusk"
       version is kept at the git tag philosophy-dusk, for use in another section.) -->
  <Section id="philosophy" labelledby="philosophy-title" class="sia-philosophy" data-dusk>
    <div class="sia-lake" aria-hidden="true">
      <div class="sia-lake__reflection">
        <div class="sia-hero__land sia-lake__land">
          <svg class="sia-hero__ridge sia-hero__ridge--far" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 132 Q100 93 200 141 Q300 86 400 121 Q500 87 600 137 Q700 118 800 143 Q900 92 1000 120 Q1100 99 1200 132 Q1300 113 1400 141 Q1500 104 1600 121 Q1700 101 1800 137 Q1900 98 2000 143 Q2100 85 2200 120 Q2300 85 2400 132 V260 H0Z" /></svg>
          <div class="sia-hero__mist sia-hero__mist--high"></div>
          <svg class="sia-hero__ridge sia-hero__ridge--mid" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 173 Q100 144 200 178 Q300 166 400 190 Q500 130 600 152 Q700 129 800 197 Q900 160 1000 171 Q1100 153 1200 173 Q1300 148 1400 178 Q1500 158 1600 190 Q1700 126 1800 152 Q1900 138 2000 197 Q2100 156 2200 171 Q2300 158 2400 173 V260 H0Z" /></svg>
          <div class="sia-hero__mist"></div>
          <svg class="sia-hero__ridge sia-hero__ridge--near" viewBox="0 0 2400 260" preserveAspectRatio="none"><path d="M0 201 Q100 183 200 233 Q300 193 400 209 Q500 191 600 228 Q700 180 800 200 Q900 190 1000 233 Q1100 190 1200 201 Q1300 185 1400 233 Q1500 198 1600 209 Q1700 199 1800 228 Q1900 191 2000 200 Q2100 182 2200 233 Q2300 183 2400 201 V260 H0Z" /></svg>
        
        </div>
      </div>
    </div>
    <div class="sia-phil">
      <header class="sia-phil__intro">
        <div class="sia-phil__head" data-reveal>
          <p class="sia-kicker font-han" lang="zh-Hans">静心 <span>a quiet heart</span></p>
          <h2 id="philosophy-title" class="sia-phil__title">A quieter kind of care.</h2>
        </div>
        <div class="sia-phil__lede" data-reveal>
          <p class="sia-phil__lead">Sometimes, the best thing you can do is take a moment for yourself.</p>
          <p>
            At Sia Massage, we believe that time spent unwinding should feel just as considered as the
            treatment itself. From the atmosphere of our space to the attentiveness of every treatment,
            the little details come together to create an experience where you can slow down, settle in
            and enjoy a moment away from the everyday.
          </p>
        </div>
      </header>

      <article class="sia-step sia-step--story" aria-labelledby="sia-story-title">
        <div class="sia-step__card" data-reveal>
          <div class="sia-step__panel glass-3d" data-glow>
            <figure class="sia-step__inset img-reveal">
              <Img src={storyPhoto} alt="A smiling therapist in a sage uniform, with two colleagues standing behind her in the studio" sizes="(min-width: 1024px) 42vw, 100vw" class="h-full w-full object-cover sia-phil__team" />
            </figure>
            <div class="sia-step__text">
              <p class="sia-phil__label">Our story</p>
              <h3 id="sia-story-title" class="sia-step__title">Rooted in Chinese tradition. Made for moments of calm.</h3>
              <p>
                Sia Massage offers a welcoming space to experience Chinese relaxation massage and take a
                little time away from the demands of everyday life.
              </p>
              <p>
                As a Chinese-owned business with a predominantly Chinese team, we bring our background and
                experience into the way we approach our work. We believe in creating a comfortable
                environment where every guest feels welcome, every treatment is approached with care, and
                there's time to simply slow down and unwind.
              </p>
              <p>
                Whether you're visiting for a short escape or a longer moment of relaxation, we'd love to
                welcome you to Sia Massage.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="sia-pillars" data-dusk-scene>
      <!-- Arriving at dusk (the scene kept from the earlier philosophy, git tag philosophy-dusk). The
           ranges: the right half is the roundel's own mountains (mirrored), the left half new peaks
           drawn in the same style, each colour one continuous shape so there is no seam; the two dark
           foreground hills keep their sides and curve into each other across the middle.
           from "The place" down, a pale evening sky continues the light above, the roundel's own
           mountains rise across it as you scroll in, and below them the lake deepens to moss, the
           shop's lantern glow blooming around the studio and fireflies drifting in the dark. -->
      <div class="sia-dusk" aria-hidden="true">
        <div class="sia-dusk__sky"></div>
