---
// Standard developer-credit page on every client site, linked from the footer's
// "Digital Services" menu. Content comes from src/config/studio.ts (base-owned).
import OnePageLayout from '../layouts/OnePageLayout.astro';
import { site } from '../config/site';
import { studio } from '../config/studio';


const services = [
  {
    title: 'Website design & development',
    text: 'Custom-built websites and web applications that look exceptional and perform flawlessly on every device.',
  },
  {
    title: 'Immersive 3D experiences',
    text: 'Spatial navigation, motion and lighting that make a site memorable, built to load fast and stay durable.',
  },
  {
    title: 'Brand identity',
    text: 'Logos, colour palettes and typography that give a business a presence its audience remembers.',
  },
  {
    title: 'Security & ongoing care',
    text: 'Hardened hosting, security monitoring and optional maintenance so a site stays fast and safe after launch.',
  },
];
---

<OnePageLayout
  title={`Digital services by ${studio.name}`}
  description={`${site.name}'s website was designed and built by ${studio.name}.`}
>
  <div class="ill-studio">
  <section class="ill-studio__inner">
    <a href="/" class="ill-studio__back">← Back to {site.name}</a>

    <p class="ill-studio__kicker">Digital services</p>
    <h1>{studio.name}</h1>
    <p class="ill-studio__tagline">{studio.tagline}.</p>

    <ul class="ill-studio__grid" role="list">
      {
        services.map((s) => (
          <li class="ill-studio__card">
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="ill-studio__card ill-studio__panel">
      <h2>About this website</h2>
      <p>
        The {site.name} website was designed and developed by {studio.name}, built on a
        security-first foundation: strict content security policy, protected forms, and hosting
        hardened against automated attacks.
      </p>
      {
        studio.email && (
          <p class="ill-studio__cta">
            <a href={`mailto:${studio.email}`}>Enquire about a website</a>
          </p>
        )
      }
    </div>

    <div class="ill-studio__card ill-studio__panel">
      <h2>Design rights</h2>
      <p>
        {studio.designCredit}. The design, layout, graphics, interface components (including
        the Illuminara footer) and code of this website are the work of {studio.name} and are
        protected by copyright. They may not be copied, reproduced, adapted or reused, in whole
        or in part, including for training or prompting AI systems, without written permission
        from {studio.name}.
      </p>
      <p>
        The business's own content (its name, logo, text and photographs) belongs to {site.name}.
      </p>
    </div>
  </section>
  </div>
</OnePageLayout>

<style>
  /* The studio page follows the client site's own colours (its tokens), like every page. */
  .ill-studio {
    --ill-mist: var(--color-text);
    --ill-sky: var(--color-accent);
    --ill-sea: var(--color-accent);
    --ill-deep: var(--color-surface);
    min-height: calc(100dvh - var(--header-height));
    color: var(--color-text);
  }
  .ill-studio__inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 6rem;
  }
  .ill-studio__back {
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: opacity 200ms ease;
  }
  .ill-studio__back:hover {
    opacity: 0.75;
  }
  .ill-studio__kicker {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ill-sky);
    opacity: 0.8;
  }
  .ill-studio h1 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
    color: var(--ill-mist);
  }
  .ill-studio__tagline {
    margin-top: 1rem;
    max-width: 40rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  .ill-studio__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  @media (min-width: 640px) {
    .ill-studio__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ill-studio__card {
    padding: 1.75rem;
    border: 1px solid color-mix(in oklab, var(--ill-sky) 18%, transparent);
    border-radius: 1.1rem;
    background: color-mix(in oklab, var(--ill-deep) 85%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transition:
      transform 300ms ease,
      border-color 300ms ease;
  }
  .ill-studio__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--ill-sky) 32%, transparent);
  }
  .ill-studio__card h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ill-sky);
  }
  .ill-studio__card p {
    margin-top: 0.6rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .ill-studio__panel {
    margin-top: 1.5rem;
    padding: 2rem;
  }
  .ill-studio__panel h2 {
    color: var(--ill-mist);
    font-size: 1.6rem;
  }
  .ill-studio__cta a {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 500;
    color: var(--color-on-accent);
    background: var(--color-accent);
    transition: box-shadow 300ms ease;
  }
  .ill-studio__cta a:hover {
    box-shadow: 0 6px 22px color-mix(in oklab, var(--ill-sky) 35%, transparent);
  }
</style>
