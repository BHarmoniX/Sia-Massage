---
// TEMPORARY (remove before launch, like ?capture and ?perf): a guided tour for recording a
// walkthrough video for the client. Open the site with ?tour (e.g. http://localhost:4330/?tour),
// press "Start tour", and start the Mac's screen recording (Cmd + Shift + 5). A drawn cursor
// then shows everything: the menu, button hovers, the music play/pause, the card glows, the
// walk through the doorway, the FAQ answers and the footer menus. Esc stops it.
// Nothing here runs without ?tour.
---

<script>
  if (new URLSearchParams(location.search).has('tour')) startTourMode();

  function startTourMode() {
    const html = document.documentElement;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const frame = () => new Promise<number>((r) => requestAnimationFrame(r));
    const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const easeSine = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;
    let stopped = false;
    class Stop extends Error {}
    const check = () => {
      if (stopped) throw new Stop();
    };

    // ── Styles (through the style sheets: the site's security policy blocks new <style> tags) ──
    const sheet = Array.from(document.styleSheets).find((s) => {
      try {
        return !!s.cssRules;
      } catch {
        return false;
      }
    });
    const addRule = (rule: string) => {
      try {
        sheet?.insertRule(rule, sheet.cssRules.length);
      } catch {
        /* ignore a rule the browser can't read */
      }
    };
    // Every hover style also answers to .tour-hover, so the drawn cursor shows the real hovers.
    const mirror = (list: CSSRuleList, parent: CSSStyleSheet | CSSGroupingRule) => {
      const extra: string[] = [];
      for (const rule of Array.from(list)) {
        if (rule instanceof CSSStyleRule && rule.selectorText.includes(':hover')) {
          extra.push(rule.cssText.replace(/:hover/g, '.tour-hover'));
        } else if ('cssRules' in rule && !(rule instanceof CSSStyleRule)) {
          mirror((rule as CSSGroupingRule).cssRules, rule as CSSGroupingRule);
        }
      }
      for (const text of extra) {
        try {
          parent.insertRule(text, parent.cssRules.length);
        } catch {
          /* skip */
        }
      }
    };
    for (const s of Array.from(document.styleSheets)) {
      try {
        mirror(s.cssRules, s);
      } catch {
        /* a sheet from another site (fonts): no hovers there */
      }
    }
    addRule('html.tour-on, html.tour-on * { cursor: none !important; }');
    addRule('html.tour-on { scroll-behavior: auto !important; }');
    addRule(
      '.tour-start { position: fixed; inset: 0; z-index: 2147483646; display: grid; place-items: center; background: rgb(241 241 231 / 0.72); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-family: var(--font-body); transition: opacity 600ms ease; }',
    );
    addRule('.tour-start__box { display: grid; gap: 0.9rem; justify-items: center; text-align: center; color: #27322a; }');
    addRule('.tour-start__note { font-size: 0.85rem; color: #55624f; max-width: 22rem; line-height: 1.5; }');
    addRule(
      '.tour-cursor { position: fixed; left: 0; top: 0; z-index: 2147483647; pointer-events: none; will-change: transform; transition: opacity 500ms ease; opacity: 0; }',
    );
    addRule('.tour-cursor svg { display: block; width: 26px; height: 26px; filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35)); transition: transform 160ms ease; }');
    addRule('.tour-cursor.is-down svg { transform: scale(0.82); }');
    addRule(
      '.tour-cursor__ring { position: absolute; left: -18px; top: -18px; width: 36px; height: 36px; border-radius: 50%; border: 2px solid rgb(92 122 76 / 0.85); opacity: 0; transform: scale(0.4); }',
    );
    addRule('.tour-cursor.is-click .tour-cursor__ring { animation: tour-ring 650ms ease-out; }');
    addRule('@keyframes tour-ring { 0% { opacity: 0.9; transform: scale(0.4); } 100% { opacity: 0; transform: scale(1.6); } }');
    // On a phone-sized view the "cursor" is a fingertip dot.
    addRule('.tour-cursor--touch svg { display: none; }');
    addRule(
      '.tour-cursor--touch::before { content: ""; position: absolute; left: -14px; top: -14px; width: 28px; height: 28px; border-radius: 50%; background: rgb(255 255 255 / 0.55); border: 2px solid rgb(39 50 42 / 0.45); box-shadow: 0 2px 8px rgb(0 0 0 / 0.25); }',
    );

    // ── The drawn cursor ──
    const touch = window.matchMedia('(max-width: 1023.98px)').matches;
    const cursor = document.createElement('div');
    cursor.className = `tour-cursor${touch ? ' tour-cursor--touch' : ''}`;
    cursor.setAttribute('aria-hidden', 'true');
    cursor.innerHTML =
      '<span class="tour-cursor__ring"></span><svg viewBox="0 0 24 24"><path d="M4 2.5 L4 19.5 L8.6 15.4 L11.6 22 L14.6 20.7 L11.7 14.2 L18 14.2 Z" fill="#fff" stroke="#1b2418" stroke-width="1.4" stroke-linejoin="round"/></svg>';
    let cx = innerWidth * 0.62;
    let cy = innerHeight * 0.6;
    const place = () => {
      cursor.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
    };
    place();

    // Hover: the element under the cursor and everything around it (as a real pointer would).
    let hovered: Element[] = [];
    const updateHover = () => {
      const el = document.elementFromPoint(cx, cy);
      const chain: Element[] = [];
      for (let e: Element | null = el; e; e = e.parentElement) chain.push(e);
      for (const old of hovered) {
        if (!chain.includes(old)) {
          old.classList.remove('tour-hover');
          old.dispatchEvent(new PointerEvent('pointerleave', { bubbles: false, pointerType: 'mouse' }));
        }
      }
      for (const e of chain) e.classList.add('tour-hover');
      hovered = chain;
      el?.dispatchEvent(
        new PointerEvent('pointermove', { bubbles: true, clientX: cx, clientY: cy, pointerType: 'mouse', isPrimary: true }),
      );
    };
    const clearHover = () => {
      for (const old of hovered) old.classList.remove('tour-hover');
      hovered = [];
    };

    const moveTo = async (x: number, y: number, ms?: number) => {
      const fx = cx;
      const fy = cy;
      const dist = Math.hypot(x - fx, y - fy);
      const dur = ms ?? Math.min(1400, Math.max(450, dist * 1.6));
      const t0 = performance.now();
      for (;;) {
        check();
        const now = await frame();
        const t = Math.min(1, (now - t0) / dur);
        const e = easeIO(t);
        // a slight arc, like a hand moving a mouse
        cx = fx + (x - fx) * e;
        cy = fy + (y - fy) * e - Math.sin(Math.PI * t) * Math.min(40, dist * 0.08);
        place();
        updateHover();
        if (t >= 1) break;
      }
    };
    const visible = (el: Element | null | undefined): el is HTMLElement =>
      !!el && (el as HTMLElement).getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden';
    const centre = (el: Element, fx = 0.5, fy = 0.5) => {
      const r = el.getBoundingClientRect();
      return [r.left + r.width * fx, r.top + r.height * fy] as const;
    };
    const hover = async (el: Element | null | undefined, hold = 700, fx = 0.5, fy = 0.5) => {
      if (!visible(el)) return;
      const [x, y] = centre(el, fx, fy);
      await moveTo(x, y);
      await wait(hold);
    };
    // Glide across a surface (cards with a light or a tilt that follows the pointer).
    const sweep = async (el: Element | null | undefined, ms = 1800) => {
      if (!visible(el)) return;
      const [x1, y1] = centre(el, 0.28, 0.4);
      const [x2, y2] = centre(el, 0.72, 0.6);
      await moveTo(x1, y1);
      await moveTo(x2, y2, ms);
    };
    const press = async () => {
      cursor.classList.add('is-down');
      await wait(140);
      cursor.classList.remove('is-down');
      cursor.classList.remove('is-click');
      void cursor.offsetWidth;
      cursor.classList.add('is-click');
    };
    const click = async (el: Element | null | undefined, hold = 900) => {
      if (!visible(el)) return;
      const [x, y] = centre(el);
      await moveTo(x, y);
      await wait(250);
      await press();
      el.click();
      await wait(hold);
    };

    // ── Smooth scrolling, driven frame by frame ──
    const header = () => document.querySelector<HTMLElement>('[data-site-header]')?.offsetHeight ?? 80;
    const maxY = () => document.documentElement.scrollHeight - innerHeight;
    const scrollTo = async (target: number, ms?: number, ease = easeSine) => {
      const from = scrollY;
      const to = Math.max(0, Math.min(maxY(), target));
      const dist = Math.abs(to - from);
      if (dist < 2) return;
      const dur = ms ?? Math.min(9000, Math.max(1200, dist * 3.2));
      const t0 = performance.now();
      for (;;) {
        check();
        const now = await frame();
        const t = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, from + (to - from) * ease(t));
        updateHover();
        if (t >= 1) break;
      }
    };
    const top = (el: Element | null | undefined) => (el ? el.getBoundingClientRect().top + scrollY : scrollY);
    const scrollToEl = (sel: string | Element | null, offset = 16, ms?: number) => {
      const el = typeof sel === 'string' ? document.querySelector(sel) : sel;
      return scrollTo(top(el) - header() - offset, ms);
    };
    const $ = (sel: string) => document.querySelector<HTMLElement>(sel);
    const $$ = (sel: string) => Array.from(document.querySelectorAll<HTMLElement>(sel)).filter(visible);

    // ── The tour ──
    const tour = async () => {
      window.scrollTo(0, 0);
      html.classList.add('tour-on');
      cursor.style.opacity = '1';
      await wait(2200);

      // 1. The music: play.
      await click($('[data-ambient-toggle]'), 2600);

      // 2. The menu.
      const navLinks = $$('.site-header__nav .site-header__link');
      if (navLinks.length) {
        for (const link of navLinks) await hover(link, 420);
        await hover($('.site-header__nav .site-header__cta'), 1100);
      } else {
        const toggle = $('.site-header__toggle');
        await click(toggle, 900);
        for (const link of $$('.site-header__sheet-link')) await hover(link, 380, 0.18);
        await hover($('.site-header__sheet .site-header__cta'), 900);
        await click(toggle, 700);
      }

      // 3. The hero: its buttons, and the mountain window turning under the pointer.
      for (const btn of $$('.sia-hero__cta-group .btn-3d')) await hover(btn, 1000);
      const gate = $('.sia-moongate');
      if (visible(gate)) {
        await sweep(gate, 2600);
        await wait(600);
      }

      // 4. Philosophy: the opening, the story, the three steps.
      await moveTo(innerWidth * 0.86, innerHeight * 0.55);
      await scrollToEl('.sia-phil__intro', 24);
      await wait(2600);
      const story = $('.sia-step--story .sia-step__panel');
      await scrollToEl(story, 16);
      await sweep(story, 2200);
      await wait(1400);
      for (const step of ['light', 'mid', 'dark']) {
        const panel = $(`.sia-step--${step} .sia-step__panel`);
        await scrollToEl(panel, 24);
        await sweep(panel, 1700);
        await wait(900);
      }
      await hover($('.sia-step__cta .btn-3d'), 1300);

      // 5. Treatments: the cards float, the Book links, help for the undecided.
      await moveTo(innerWidth * 0.5, innerHeight * 0.4);
      await scrollToEl('#treatments-title', 24);
      await wait(2200);
      const cards = $$('.sia-menu__card');
      for (const card of cards) {
        if (card.getBoundingClientRect().bottom > innerHeight - 20) await scrollTo(scrollY + card.getBoundingClientRect().bottom - innerHeight + 60, 900);
        await hover(card, 650, 0.4, 0.45);
      }
      const firstCard = cards[0];
      const book = firstCard?.querySelector('.sia-menu__book');
      if (firstCard && book) {
        await scrollToEl(firstCard, 40, 1200);
        await hover(book, 1000);
      }
      const help = $('.sia-treatments__help-link');
      if (help) {
        await scrollTo(top(help) - innerHeight * 0.6, 1400);
        await hover(help, 1200);
      }

      // 6. Your visit: the doors open and you walk in, slowly and evenly.
      await moveTo(innerWidth * 0.9, innerHeight * 0.85, 900);
      const visit = $('#visit');
      if (visit) {
        await scrollToEl(visit, -2, 2200);
        // the cursor steps aside so nothing distracts from the walk through the arch
        cursor.style.opacity = '0';
        clearHover();
        await wait(2400);
        const end = top(visit) + visit.offsetHeight - innerHeight;
        // a long, even glide: a gentle start and finish (8% each), constant speed in between
        const a = 0.08;
        const k = 2 * a * (1 - a);
        await scrollTo(end, Math.max(14000, (end - scrollY) * 5.5), (t) =>
          t < a ? (t * t) / k : t > 1 - a ? 1 - ((1 - t) * (1 - t)) / k : (t - a / 2) / (1 - a),
        );
        await wait(2200);
        cursor.style.opacity = '1';
      }

      // 7. FAQ: open an answer, then another (one at a time), then close it.
      await scrollToEl('#faq-title', 24);
      await wait(1600);
      const questions = $$('.sia-faq__item summary');
      if (questions[0]) {
        await click(questions[0], 2600);
        if (questions[1]) await click(questions[1], 2600);
        await click(questions[1] ?? questions[0], 1000);
      }

      // 8. Contact: the card and its three buttons.
      await scrollToEl('#contact .sia-contact__panel', 8);
      await wait(1600);
      const actions = $$('.sia-contact__actions .btn-3d');
      const first = actions[0];
      if (first && first.getBoundingClientRect().bottom > innerHeight - 20) {
        await scrollTo(scrollY + first.getBoundingClientRect().bottom - innerHeight + 90, 1400);
      }
      for (const btn of actions) await hover(btn, 900);

      // 9. The footer: contact links and its menus.
      await scrollTo(maxY(), 2600);
      await wait(1200);
      for (const a of $$('.ill-footer__contact a')) await hover(a, 600);
      const menus = $$('.ill-footer__pill');
      for (const pill of menus.slice(0, 2)) {
        await click(pill, 1500);
        await click(pill, 500);
      }

      // 10. Back to the top, and pause the music.
      await moveTo(innerWidth * 0.8, innerHeight * 0.5);
      await scrollTo(0, 9000);
      await wait(1200);
      await click($('[data-ambient-toggle]'), 1600);
      await moveTo(innerWidth * 0.62, innerHeight * 0.6, 1200);
      await wait(1500);
      cursor.style.opacity = '0';
    };

    // ── Start (a real click, so the browser lets the music play) ──
    const start = document.createElement('div');
    start.className = 'tour-start';
    start.innerHTML =
      '<div class="tour-start__box"><button type="button" class="btn-3d">Start tour</button>' +
      '<p class="tour-start__note">Start your screen recording first (Cmd + Shift + 5), then press Start tour. Press Esc to stop.</p></div>';
    document.body.append(start, cursor);
    // Keep this click from starting the music on its own: the tour plays it with the button.
    addEventListener(
      'pointerdown',
      (event) => {
        if (start.isConnected && start.contains(event.target as Node)) event.stopImmediatePropagation();
      },
      { capture: true },
    );
    start.querySelector('button')?.addEventListener('click', async () => {
      start.style.opacity = '0';
      await wait(650);
      start.remove();
      try {
        await tour();
      } catch (e) {
        if (!(e instanceof Stop)) throw e;
      } finally {
        clearHover();
        html.classList.remove('tour-on');
        cursor.style.opacity = '0';
      }
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape') stopped = true;
    });
  }
</script>
