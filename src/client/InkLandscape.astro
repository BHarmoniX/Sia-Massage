---
// Shan shui (mountain-water) ink landscape: layered misty peaks, a pale moon and two
// distant birds, in Sia's moss tones. Drawn in SVG so it's sharp at any size, weighs a few
// kilobytes and needs no image download. Purely decorative (hidden from screen readers).

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1200 1200"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="sia-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef1e6" />
      <stop offset="1" stop-color="#f6f3ec" />
    </linearGradient>
    <linearGradient id="sia-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6f3ec" stop-opacity="0" />
      <stop offset="0.5" stop-color="#f6f3ec" stop-opacity="0.85" />
      <stop offset="1" stop-color="#f6f3ec" stop-opacity="0" />
    </linearGradient>
  </defs>

  <rect width="1200" height="1200" fill="url(#sia-sky)" />
  <g data-depth="-0.15">
    <circle class="ink-moon" cx="790" cy="330" r="120" fill="#dfe5d4" />
    <circle cx="790" cy="330" r="120" fill="none" stroke="#b9c8a4" stroke-width="1.5" opacity="0.6" />
  </g>

  <!-- Clouds: clusters of overlapping puffs, no outlines, shaded like real ones (deeper sage
       behind, brighter in front, a soft shadow beneath), drifting slowly; one passes across the
       lower edge of the sun. -->
  <defs>
    <filter id="sia-cloud-soft" x="-10%" y="-20%" width="120%" height="140%">
      <feGaussianBlur stdDeviation="2.2" />
    </filter>
  </defs>
  <g data-depth="-0.08" filter="url(#sia-cloud-soft)">
    <g class="ink-cloud ink-cloud--a"><g transform="translate(300 345) scale(1.4 1.4)"><ellipse cx="0" cy="16" rx="70" ry="12" fill="#cfd8c0" /><ellipse cx="14" cy="-16" rx="34" ry="28" fill="#dfe5d2" /><ellipse cx="-22" cy="-6" rx="29" ry="22" fill="#dfe5d2" /><ellipse cx="46" cy="-2" rx="27" ry="20" fill="#dfe5d2" /><ellipse cx="30" cy="-24" rx="22" ry="18" fill="#e7ecde" /><ellipse cx="-6" cy="-20" rx="24" ry="19" fill="#e7ecde" /><ellipse cx="-48" cy="6" rx="28" ry="16" fill="#e7ecde" /><ellipse cx="66" cy="8" rx="20" ry="12" fill="#e7ecde" /><ellipse cx="-74" cy="12" rx="17" ry="10" fill="#e7ecde" /><ellipse cx="18" cy="-8" rx="30" ry="20" fill="#edf1e6" /><ellipse cx="-26" cy="2" rx="26" ry="15" fill="#edf1e6" /><ellipse cx="2" cy="9" rx="60" ry="12" fill="#e7ecde" /></g></g>
    <g class="ink-cloud ink-cloud--c"><g transform="translate(560 215) scale(-0.95 0.95)"><ellipse cx="0" cy="16" rx="70" ry="12" fill="#cfd8c0" /><ellipse cx="14" cy="-16" rx="34" ry="28" fill="#dfe5d2" /><ellipse cx="-22" cy="-6" rx="29" ry="22" fill="#dfe5d2" /><ellipse cx="46" cy="-2" rx="27" ry="20" fill="#dfe5d2" /><ellipse cx="30" cy="-24" rx="22" ry="18" fill="#e7ecde" /><ellipse cx="-6" cy="-20" rx="24" ry="19" fill="#e7ecde" /><ellipse cx="-48" cy="6" rx="28" ry="16" fill="#e7ecde" /><ellipse cx="66" cy="8" rx="20" ry="12" fill="#e7ecde" /><ellipse cx="-74" cy="12" rx="17" ry="10" fill="#e7ecde" /><ellipse cx="18" cy="-8" rx="30" ry="20" fill="#edf1e6" /><ellipse cx="-26" cy="2" rx="26" ry="15" fill="#edf1e6" /><ellipse cx="2" cy="9" rx="60" ry="12" fill="#e7ecde" /></g></g>
    <g class="ink-cloud ink-cloud--d"><g transform="translate(860 470) scale(2 2)"><ellipse cx="0" cy="16" rx="70" ry="12" fill="#cfd8c0" /><ellipse cx="14" cy="-16" rx="34" ry="28" fill="#dfe5d2" /><ellipse cx="-22" cy="-6" rx="29" ry="22" fill="#dfe5d2" /><ellipse cx="46" cy="-2" rx="27" ry="20" fill="#dfe5d2" /><ellipse cx="30" cy="-24" rx="22" ry="18" fill="#e7ecde" /><ellipse cx="-6" cy="-20" rx="24" ry="19" fill="#e7ecde" /><ellipse cx="-48" cy="6" rx="28" ry="16" fill="#e7ecde" /><ellipse cx="66" cy="8" rx="20" ry="12" fill="#e7ecde" /><ellipse cx="-74" cy="12" rx="17" ry="10" fill="#e7ecde" /><ellipse cx="18" cy="-8" rx="30" ry="20" fill="#edf1e6" /><ellipse cx="-26" cy="2" rx="26" ry="15" fill="#edf1e6" /><ellipse cx="2" cy="9" rx="60" ry="12" fill="#e7ecde" /></g></g>
  </g>

  <g data-depth="0.15"><g class="ink-layer ink-layer--far">
    <path
      fill="#dfe5d4"
      d="M0 690 Q 90 560 190 620 Q 260 470 360 560 Q 450 640 540 560 Q 640 420 760 540 Q 860 640 960 560 Q 1060 480 1200 590 V1200 H0Z"
    />
  </g></g>
  <rect y="600" width="1200" height="140" fill="url(#sia-mist)" />

  <g data-depth="0.35"><g class="ink-layer ink-layer--mid">
    <path
      fill="#b9c8a4"
      opacity="0.85"
      d="M0 820 Q 120 700 230 760 Q 300 640 400 720 Q 520 820 640 740 Q 720 680 800 740 Q 900 820 1010 730 Q 1100 670 1200 740 V1200 H0Z"
    />
  </g></g>
  <rect y="760" width="1200" height="130" fill="url(#sia-mist)" />

  <g data-depth="0.7"><g class="ink-layer ink-layer--near">
    <path
      fill="#5c7a4c"
      opacity="0.75"
      d="M0 960 Q 150 860 300 930 Q 420 990 560 920 Q 700 850 820 940 Q 960 1030 1200 920 V1200 H0Z"
    />
    <path
      fill="#27322a"
      opacity="0.55"
      d="M0 1060 Q 200 990 360 1050 Q 520 1100 700 1040 Q 880 990 1200 1060 V1200 H0Z"
    />
  </g></g>

  <!-- Two birds in ink silhouette: they start near the top left (close, in the foreground) and
       fly in one steady line away into the mist on the far right hill, shrinking as they go. -->
  <g data-depth="0.25" fill="#3b4738">
    <g class="ink-flight"><g class="ink-flight__fade">
      <g class="ink-bird">
          <path d="M-9 1 C -6 -2.5, 2 -3.5, 8 -1.5 C 11 -2.6, 14 -2.2, 15.5 -0.4 L 19 0.6 L 15 1.4 C 12 3.2, 3 4.4, -4 3 L -12 5.5 L -9 1 Z" />
          <g transform="translate(-1 -1)"><path class="ink-bird__wing ink-bird__wing--l" d="M0 0 C -8 -9, -22 -15, -40 -12 C -30 -9, -22 -5, -16 -2 C -10 -1, -5 1, 0 2 Z" /></g>
          <g transform="translate(2 -1)"><path class="ink-bird__wing ink-bird__wing--r" d="M0 0 C 7 -10, 19 -17, 36 -16 C 27 -11, 20 -6, 14 -3 C 9 -1, 4 1, 0 2 Z" /></g>
        </g>
      <g transform="translate(-58 30) scale(0.78)">
        <g class="ink-bird ink-bird--late">
          <path d="M-9 1 C -6 -2.5, 2 -3.5, 8 -1.5 C 11 -2.6, 14 -2.2, 15.5 -0.4 L 19 0.6 L 15 1.4 C 12 3.2, 3 4.4, -4 3 L -12 5.5 L -9 1 Z" />
          <g transform="translate(-1 -1)"><path class="ink-bird__wing ink-bird__wing--l" d="M0 0 C -8 -9, -22 -15, -40 -12 C -30 -9, -22 -5, -16 -2 C -10 -1, -5 1, 0 2 Z" /></g>
          <g transform="translate(2 -1)"><path class="ink-bird__wing ink-bird__wing--r" d="M0 0 C 7 -10, 19 -17, 36 -16 C 27 -11, 20 -6, 14 -3 C 9 -1, 4 1, 0 2 Z" /></g>
        </g>
      </g>
    </g></g>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    /* The birds fly from the top left (near) into the distance (far, smaller, paler): a few
       wing beats, then a long glide, again and again, each bird out of step with the other. */
    /* Clouds drift slowly right across the whole sky, each at its own pace, fading in at
       the left edge and out at the right so the loop never shows. Each starts from where it
       is drawn (the negative delay), so the scene looks the same on arrival. */
    .ink-cloud {
      animation: ink-cloud-drift var(--drift-time) linear infinite;
      animation-delay: var(--drift-delay);
    }
    .ink-cloud--a {
      --drift-from: -450px;
      --drift-to: 1050px;
      --drift-time: 150s; /* medium */
      --drift-delay: -45s;
    }
    .ink-cloud--c {
      --drift-from: -650px;
      --drift-to: 790px;
      --drift-time: 190s; /* slowest: the small, highest cloud */
      --drift-delay: -86s;
    }
    .ink-cloud--d {
      --drift-from: -1010px;
      --drift-to: 490px;
      --drift-time: 125s; /* a touch quicker than the medium: the large, lowest cloud */
      --drift-delay: -84s;
    }
    .ink-flight {
      animation: ink-flight 30s infinite;
    }
    .ink-flight__fade {
      opacity: 0;
      animation: ink-flight-fade 30s linear infinite;
    }
    .ink-bird__wing--l {
      animation: ink-wing-l 5.5s ease-in-out infinite;
    }
    .ink-bird__wing--r {
      animation: ink-wing-r 5.5s ease-in-out infinite;
    }
    .ink-bird--late .ink-bird__wing {
      animation-delay: -1.7s;
    }
    .ink-layer {
      animation: ink-drift 18s ease-in-out infinite alternate;
    }
    .ink-layer--mid {
      animation-duration: 14s;
    }
    .ink-layer--near {
      animation-duration: 11s;
    }
    .ink-moon {
      transform-origin: 790px 330px;
      animation: ink-moon 9s ease-in-out infinite alternate;
    }
  }
  @keyframes ink-drift {
    to {
      transform: translateX(-24px);
    }
  }
  /* The moon breathes: a slow swell and glow. */
  @keyframes ink-moon {
    to {
      opacity: 0.8;
      transform: scale(1.04);
    }
  }
  /* One straight, steady line from the top left (near) to the mist on the far right hill.
     They slow and shrink as they recede, and fade gradually until they're gone. */
  @keyframes ink-flight {
    0% {
      transform: translate(170px, 190px) scale(2.1);
      animation-timing-function: cubic-bezier(0.32, 0.4, 0.5, 1);
    }
    86% {
      transform: translate(1065px, 590px) scale(0.32);
    }
    100% {
      transform: translate(1065px, 590px) scale(0.32);
    }
  }
  /* Opacity runs on its own curve: in quickly, then a long, even fade into the distance. */
  @keyframes ink-flight-fade {
    0% {
      opacity: 0;
    }
    6% {
      opacity: 0.9;
    }
    40% {
      opacity: 0.85;
    }
    86%,
    100% {
      opacity: 0;
    }
  }
  /* Wings pivot at the shoulder: three beats (up, down), then held slightly raised to glide. */
  @keyframes ink-wing-l {
    0%,
    9%,
    18%,
    27% {
      transform: rotate(26deg);
    }
    4.5%,
    13.5%,
    22.5% {
      transform: rotate(-34deg);
    }
    36%,
    92% {
      transform: rotate(6deg);
    }
    100% {
      transform: rotate(26deg);
    }
  }
  @keyframes ink-wing-r {
    0%,
    9%,
    18%,
    27% {
      transform: rotate(-26deg);
    }
    4.5%,
    13.5%,
    22.5% {
      transform: rotate(34deg);
    }
    36%,
    92% {
      transform: rotate(-6deg);
    }
    100% {
      transform: rotate(-26deg);
    }
  }
  @keyframes ink-cloud-drift {
    0% {
      transform: translateX(var(--drift-from));
      opacity: 0;
    }
    8%,
    92% {
      opacity: 1;
    }
    100% {
      transform: translateX(var(--drift-to));
      opacity: 0;
    }
  }
</style>
