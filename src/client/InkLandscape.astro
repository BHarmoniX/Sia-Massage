---
// Shan shui (mountain-water) ink landscape: layered misty peaks, a pale moon and two
// distant birds, in Sia's moss tones. Drawn in SVG so it's sharp at any size, weighs a few
// kilobytes and needs no image download. Purely decorative (hidden from screen readers).

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1200 1200"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="sia-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef1e6" />
      <stop offset="1" stop-color="#f6f3ec" />
    </linearGradient>
    <linearGradient id="sia-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6f3ec" stop-opacity="0" />
      <stop offset="0.5" stop-color="#f6f3ec" stop-opacity="0.85" />
      <stop offset="1" stop-color="#f6f3ec" stop-opacity="0" />
    </linearGradient>
  </defs>

  <rect width="1200" height="1200" fill="url(#sia-sky)" />
  <g data-depth="-0.15">
    <circle class="ink-moon" cx="820" cy="330" r="132" fill="#dfe5d4" />
    <circle cx="820" cy="330" r="132" fill="none" stroke="#b9c8a4" stroke-width="1.5" opacity="0.6" />
  </g>

  <!-- Clouds: clusters of overlapping puffs, no outlines, shaded like real ones (deeper sage
       behind, brighter in front, a soft shadow beneath), drifting slowly; one passes across the
       lower edge of the sun. The large low one lives with the distant ranges, further down. -->
  <defs>
    <filter id="sia-cloud-soft" x="-10%" y="-20%" width="120%" height="140%">
      <feGaussianBlur stdDeviation="2.2" />
    </filter>
  </defs>
  <g data-depth="-0.08" filter="url(#sia-cloud-soft)">
    <g class="ink-cloud ink-cloud--a"><g transform="translate(300 345) scale(1.4 1.4)"><ellipse cx="0" cy="16" rx="70" ry="12" fill="#c2ccb1" /><ellipse cx="14" cy="-16" rx="34" ry="28" fill="#d3dbc4" /><ellipse cx="-22" cy="-6" rx="29" ry="22" fill="#d3dbc4" /><ellipse cx="46" cy="-2" rx="27" ry="20" fill="#d3dbc4" /><ellipse cx="30" cy="-24" rx="22" ry="18" fill="#dee5d3" /><ellipse cx="-6" cy="-20" rx="24" ry="19" fill="#dee5d3" /><ellipse cx="-48" cy="6" rx="28" ry="16" fill="#dee5d3" /><ellipse cx="66" cy="8" rx="20" ry="12" fill="#dee5d3" /><ellipse cx="-74" cy="12" rx="17" ry="10" fill="#dee5d3" /><ellipse cx="18" cy="-8" rx="30" ry="20" fill="#edf1e6" /><ellipse cx="-26" cy="2" rx="26" ry="15" fill="#edf1e6" /><ellipse cx="2" cy="9" rx="60" ry="12" fill="#dee5d3" /></g></g>
    <g class="ink-cloud ink-cloud--c"><g transform="translate(560 215) scale(-0.95 0.95)"><ellipse cx="0" cy="16" rx="70" ry="12" fill="#c2ccb1" /><ellipse cx="14" cy="-16" rx="34" ry="28" fill="#d3dbc4" /><ellipse cx="-22" cy="-6" rx="29" ry="22" fill="#d3dbc4" /><ellipse cx="46" cy="-2" rx="27" ry="20" fill="#d3dbc4" /><ellipse cx="30" cy="-24" rx="22" ry="18" fill="#dee5d3" /><ellipse cx="-6" cy="-20" rx="24" ry="19" fill="#dee5d3" /><ellipse cx="-48" cy="6" rx="28" ry="16" fill="#dee5d3" /><ellipse cx="66" cy="8" rx="20" ry="12" fill="#dee5d3" /><ellipse cx="-74" cy="12" rx="17" ry="10" fill="#dee5d3" /><ellipse cx="18" cy="-8" rx="30" ry="20" fill="#edf1e6" /><ellipse cx="-26" cy="2" rx="26" ry="15" fill="#edf1e6" /><ellipse cx="2" cy="9" rx="60" ry="12" fill="#dee5d3" /></g></g>
  </g>

  <!-- Chinese mountainscape: a pared-back range of steep, softly rounded peaks fading into
       the distance, mist drifting between the ranges, and one mountain standing in the valley
       with a small village and rice paddy terraces at its foot, and a winding river. -->
  <defs>
    <filter id="sia-mist-soft" x="-20%" y="-60%" width="140%" height="220%">
      <feGaussianBlur stdDeviation="14" />
    </filter>
    <filter id="sia-mist-wisp" x="-40%" y="-80%" width="180%" height="260%">
      <feGaussianBlur stdDeviation="18" />
    </filter>
    <!-- Thins the valley mist over the river's far tail, so the river stays visible through it. -->
    <filter id="sia-river-clear-blur" x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="12" />
    </filter>
    <mask id="sia-river-clear" maskUnits="userSpaceOnUse" x="-200" y="0" width="1600" height="1400">
      <rect x="-200" y="0" width="1600" height="1400" fill="#fff" />
      <path d="M580 846 C 500 845 400 846 330 858 C 300 866 320 880 360 884 C 430 889 500 890 580 891" fill="none" stroke="#000" stroke-width="44" stroke-linecap="round" opacity="0.62" filter="url(#sia-river-clear-blur)" />
    </mask>
    <mask id="sia-rest-clear" maskUnits="userSpaceOnUse" x="-200" y="0" width="1600" height="1400">
      <rect x="-200" y="0" width="1600" height="1400" fill="#fff" />
      <ellipse cx="600" cy="1004" rx="62" ry="42" fill="#000" opacity="0.85" filter="url(#sia-river-clear-blur)" />
    </mask>
    <linearGradient id="sia-fg-mountain" x1="0" y1="0" x2="1" y2="0.25">
      <stop offset="0" stop-color="#6b8a58" />
      <stop offset="0.5" stop-color="#5c7a4c" />
      <stop offset="1" stop-color="#465f3b" />
    </linearGradient>
    <clipPath id="sia-paddy-clip"><path d="M-10 880 C 200 860 420 905 600 895 C 800 885 1000 860 1210 878 V1200 H-10Z" /></clipPath>
  </defs>

