---
import BaseHead from '../components/BaseHead.astro';
import IlluminaraFooter from '../components/footer/IlluminaraFooter.astro';
import AmbientAudio from '../components/media/AmbientAudio.astro';
import { SITE_ENV } from 'astro:env/server';
import { features } from '../../config/features.mjs';
import { site } from '../config/site';
import { studio } from '../config/studio';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** The Illuminara footer is standard; hide it only on special pages (e.g. a full-screen 3D intro). */
  hideFooter?: boolean;
}

const { hideFooter = false, ...props } = Astro.props;
// The capture guard only runs on live sites (see config/features.mjs).
const guard = features.captureGuard && SITE_ENV === 'production';
---

<!doctype html>
<html
  lang={site.locale}
  data-capture-guard={guard ? '' : undefined}
  data-capture-notice={guard ? studio.designCredit : undefined}
>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <IlluminaraFooter />}
    <AmbientAudio />
  </body>
</html>

<script>
  import '../scripts/depth.ts';
  import '../scripts/capture-guard.ts';
</script>
