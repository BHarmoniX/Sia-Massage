---
import BaseHead from '../components/BaseHead.astro';
import IlluminaraFooter from '../components/footer/IlluminaraFooter.astro';
import AmbientAudio from '../components/media/AmbientAudio.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** The Illuminara footer is standard; hide it only on special pages (e.g. a full-screen 3D intro). */
  hideFooter?: boolean;
}

const { hideFooter = false, ...props } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <IlluminaraFooter />}
    <AmbientAudio />
  </body>
</html>

<script>
  import '../scripts/depth.ts';
</script>
