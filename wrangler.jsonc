// Cloudflare Workers settings. The Astro adapter merges this into the generated deploy config.
// `npm run new-client` renames the worker for each client; never deploy under this name.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sia-massage",
  "compatibility_date": "2026-10-06",

  // Preview deployments get their own *.workers.dev URLs for client approval.
  "workers_dev": true,
  "preview_urls": true,

  // Per-visitor limits counted across Cloudflare's network (src/lib/server/rate-limit.ts).
  // `period` must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true },

  // Production custom domain, added per client, e.g.:
  // "routes": [{ "pattern": "www.samassage.com.au", "custom_domain": true }]
}
