{
  "name": "illuminara-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "DEPLOY_TARGET=${DEPLOY_TARGET:-node} node ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./node_modules/astro/bin/astro.mjs build && node scripts/check-dist.mjs",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare node ./node_modules/astro/bin/astro.mjs build && node scripts/check-dist.mjs",
    "build:node": "DEPLOY_TARGET=node node ./node_modules/astro/bin/astro.mjs build && node scripts/check-dist.mjs",
    "build:static": "DEPLOY_TARGET=static node ./node_modules/astro/bin/astro.mjs build && node scripts/check-dist.mjs",
    "preview": "node ./node_modules/astro/bin/astro.mjs preview",
    "check": "node ./node_modules/astro/bin/astro.mjs check",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run guard && npm run check && npm test && npm run audit && npm run build",
    "start": "node server/node.mjs",
    "setup": "git config core.hooksPath .githooks",
    "guard": "node scripts/guard-base-repo.mjs",
    "new-client": "node scripts/new-client.mjs",
    "update-base": "git fetch upstream && git merge upstream/main",
    "test": "node --test \"tests/**/*.test.ts\"",
    "scan-headers": "node scripts/scan-headers.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/node": "11.1.7",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "miniflare": {
      "undici": "7.30.1"
    },
    "unifont": {
      "undici": "8.12.2"
    }
  }
}
